+
+/**
+ * Model class to represent a table cell in PDF extraction
+ */
+public class TableCell {
+    
+    private List<WordData> wordDataList;
+    private Integer columnNumber;
+    private Float y;
+    private Float height;
+
+    public TableCell(List<WordData> wordDataList, Integer columnNumber, Float y) {
+        this.wordDataList = wordDataList;
+        this.columnNumber = columnNumber;
+        this.y = y;
+        if (wordDataList != null && !wordDataList.isEmpty()) {
+            this.height = wordDataList.get(0).getHeight();
+        }
+    }
+
+    public TableCell() {
+    }
+
+    public List<String> getContent() {
+        if (wordDataList == null) {
+            return new ArrayList<>();
+        }
+        return wordDataList.stream()
+                .map(WordData::getWord)
+                .collect(Collectors.toList());
+    }
+
+    public Float getStartIndex() {
+        if (wordDataList == null || wordDataList.isEmpty()) {
+            return 0f;
+        }
+        return wordDataList.get(0).getX1();
+    }
+
+    public Float getEndIndex() {
+        if (wordDataList == null || wordDataList.isEmpty()) {
+            return 0f;
+        }
+        return wordDataList.get(wordDataList.size() - 1).getX2();
+    }
+
+    public List<String> getCellStringList() {
+        if (wordDataList == null) {
+            return new ArrayList<>();
+        }
+        return wordDataList.stream()
+                .map(wordData -> wordData.getWord().toLowerCase())
+                .collect(Collectors.toList());
+    }
+
+    public List<WordData> getWordDataList() {
+        return wordDataList;
+    }
+
+    public void setWordDataList(List<WordData> wordDataList) {
+        this.wordDataList = wordDataList;
+    }
+
+    public Integer getColumnNumber() {
+        return columnNumber;
+    }
+
+    public void setColumnNumber(Integer columnNumber) {
+        this.columnNumber = columnNumber;
+    }
+
+    public Float getY() {
+        return y;
+    }
+
+    public void setY(Float y) {
+        this.y = y;
+    }
+
+    public Float getHeight() {
+        return height;
+    }
+
+    public void setHeight(Float height) {
+        this.height = height;
+    }
+}
