+package com.finboost.bank.statement.parser.tableextractor.graphics.model;
+
+import java.awt.geom.Rectangle2D;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Comprehensive data structure representing a detected table with all coordinates
+ */
+public class TableStructure {
+    
+    private Rectangle2D.Double bounds;
+    private List<Double> columnSeparatorX;
+    private List<Double> rowSeparatorY;
+    private List<List<CellStructure>> cells;
+    private int rows;
+    private int columns;
+    private double confidence;
+    
+    public TableStructure(Rectangle2D.Double bounds) {
+        this.bounds = bounds;
+        this.columnSeparatorX = new ArrayList<>();
+        this.rowSeparatorY = new ArrayList<>();
+        this.cells = new ArrayList<>();
+        this.confidence = 0.0;
+    }
+    
+    // Getters and setters
+    public Rectangle2D.Double getBounds() { return bounds; }
+    public void setBounds(Rectangle2D.Double bounds) { this.bounds = bounds; }
+    
+    public List<Double> getColumnSeparatorX() { return columnSeparatorX; }
+    public void setColumnSeparatorX(List<Double> columnSeparatorX) { this.columnSeparatorX = columnSeparatorX; }
+    
+    public List<Double> getRowSeparatorY() { return rowSeparatorY; }
+    public void setRowSeparatorY(List<Double> rowSeparatorY) { this.rowSeparatorY = rowSeparatorY; }
+    
+    public List<List<CellStructure>> getCells() { return cells; }
+    public void setCells(List<List<CellStructure>> cells) { this.cells = cells; }
+    
+    public int getRows() { return rows; }
+    public void setRows(int rows) { this.rows = rows; }
+    
+    public int getColumns() { return columns; }
+    public void setColumns(int columns) { this.columns = columns; }
+    
+    public double getConfidence() { return confidence; }
+    public void setConfidence(double confidence) { this.confidence = confidence; }
+    
+    // Convenience methods
+    // Note: PDFBox uses bottom-left coordinate system (Y increases upward)
+    // So "top" = larger Y value, "bottom" = smaller Y value
+    public double getLeft() { return bounds.getMinX(); }
+    public double getRight() { return bounds.getMaxX(); }
+    public double getTop() { return bounds.getMaxY(); }  // Top = larger Y in bottom-left system
+    public double getBottom() { return bounds.getMinY(); }  // Bottom = smaller Y in bottom-left system
+    public double getWidth() { return bounds.getWidth(); }
+    public double getHeight() { return bounds.getHeight(); }
+    
+    /**
+     * Get cell at specific row and column
+     */
+    public CellStructure getCell(int row, int col) {
+        if (row >= 0 && row < cells.size() && col >= 0 && col < cells.get(row).size()) {
+            return cells.get(row).get(col);
+        }
+        return null;
+    }
+    
+    /**
+     * Add a column separator
+     */
+    public void addColumnSeparator(double x) {
+        if (!columnSeparatorX.contains(x)) {
+            columnSeparatorX.add(x);
+            columnSeparatorX.sort(Double::compareTo);
+        }
+    }
+    
+    /**
+     * Add a row separator
+     */
+    public void addRowSeparator(double y) {
+        if (!rowSeparatorY.contains(y)) {
+            rowSeparatorY.add(y);
+            rowSeparatorY.sort(Double::compareTo);
+        }
+    }
+    
+    /**
+     * Initialize cells grid based on separators
+     */
+    public void initializeCells() {
+        // Calculate number of rows and columns
+        this.rows = rowSeparatorY.size() + 1;
+        this.columns = columnSeparatorX.size() + 1;
+        
+        // Create cells grid
+        this.cells = new ArrayList<>();
+        
+        // Calculate Y coordinates for rows
+        List<Double> yCoords = new ArrayList<>();
+        yCoords.add(getTop());
+        yCoords.addAll(rowSeparatorY);
+        yCoords.add(getBottom());
+        
+        // Calculate X coordinates for columns
+        List<Double> xCoords = new ArrayList<>();
+        xCoords.add(getLeft());
+        xCoords.addAll(columnSeparatorX);
+        xCoords.add(getRight());
+        
+        // Create cells
+        for (int row = 0; row < rows; row++) {
+            List<CellStructure> rowCells = new ArrayList<>();
+            double cellTop = yCoords.get(row);
+            double cellBottom = yCoords.get(row + 1);
+            
+            for (int col = 0; col < columns; col++) {
+                double cellLeft = xCoords.get(col);
+                double cellRight = xCoords.get(col + 1);
+                
+                Rectangle2D.Double cellBounds = new Rectangle2D.Double(
+                    cellLeft, cellTop, cellRight - cellLeft, cellBottom - cellTop);
+                
+                CellStructure cell = new CellStructure(cellBounds, row, col);
+                rowCells.add(cell);
+            }
+            cells.add(rowCells);
+        }
+    }
+    
+    @Override
+    public String toString() {
+        return String.format("Table[%.1f,%.1f %.1fx%.1f] %dx%d cells (confidence: %.2f)",
+                getLeft(), getTop(), getWidth(), getHeight(), rows, columns, confidence);
+    }
+    
+    /**
+     * Get detailed string representation with all coordinates
+     */
+    public String toDetailedString() {
+        StringBuilder sb = new StringBuilder();
+        sb.append(toString()).append("\n");
+        sb.append("  Bounds: ").append(bounds).append("\n");
+        sb.append("  Column separators: ").append(columnSeparatorX).append("\n");
+        sb.append("  Row separators: ").append(rowSeparatorY).append("\n");
+        sb.append("  Cells: ").append(rows).append(" rows x ").append(columns).append(" columns");
+        return sb.toString();
+    }
+}
