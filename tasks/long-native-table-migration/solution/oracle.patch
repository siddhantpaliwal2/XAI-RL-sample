+    /**
+     * Helper method to build Table object from mapped cells
+     * 
+     * @param pageNumber One-based page number
+     * @param headerCellDataList List of header cell data
+     * @param mappedTableCellList List of mapped table cells
+     * @return Table object
+     */
+    private static Table buildTable(Integer pageNumber, List<HeaderCellData> headerCellDataList,
+                                     List<com.finboost.bank.statement.parser.tableextractor.model.TableCell> mappedTableCellList) {
+        Table table = new Table();
+        table.setPageNumber(pageNumber);
+        table.setColType(new ArrayList<>());
+        table.setTxnColType(new ArrayList<>());
+        
+        // Group cells by row
+        Map<Integer, Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell>> cells = new HashMap<>();
+        
+        int rowIndex = 0;
+        int totalColumns = headerCellDataList != null ? headerCellDataList.size() : 0;
+        
+        // Add header cells as row 0
+        if (headerCellDataList != null && !headerCellDataList.isEmpty()) {
+            Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell> headerRow = new HashMap<>();
+            for (int col = 0; col < headerCellDataList.size(); col++) {
+                HeaderCellData headerCellData = headerCellDataList.get(col);
+                com.finboost.bank.statement.parser.representation.document.extraction.TableCell headerCell = 
+                    new com.finboost.bank.statement.parser.representation.document.extraction.TableCell();
+                
+                headerCell.setRowindex(0);
+                headerCell.setColindex(col);
+                headerCell.setHeaderOrFooterCell(true);
+                
+                // Convert header WordData to Word objects
+                if (headerCellData.getWordDataList() != null && !headerCellData.getWordDataList().isEmpty()) {
+                    List<Word> headerWords = new ArrayList<>();
+                    int wordIndex = 0;
+                    for (WordData wd : headerCellData.getWordDataList()) {
+                        Word word = convertWordDataToWord(wd, wordIndex++);
+                        headerWords.add(word);
+                    }
+                    headerCell.setWords(headerWords);
+                    
+                    // Calculate cell boundaries from words
+                    calculateCellBoundaries(headerCell, headerWords);
+                }
+                
+                headerRow.put(col, headerCell);
+            }
+            cells.put(0, headerRow);
+            rowIndex = 0;
+        }
+        
+        // Process each mapped cell (data rows start from row 1)
+        // Group cells by Y coordinate (row) and column number
+        Map<Float, List<com.finboost.bank.statement.parser.tableextractor.model.TableCell>> rowMap = new HashMap<>();
+        for (com.finboost.bank.statement.parser.tableextractor.model.TableCell sourceCell : mappedTableCellList) {
+            if (sourceCell.getY() == null) continue;
+            rowMap.computeIfAbsent(sourceCell.getY(), k -> new ArrayList<>()).add(sourceCell);
+        }
+        
+        // Sort rows by Y coordinate
+        List<Float> sortedYs = new ArrayList<>(rowMap.keySet());
+        sortedYs.sort(Float::compareTo);
+        
+        // Convert to row/column indexed cells (starting from row 1 since row 0 is header)
+        int currentRow = headerCellDataList != null && !headerCellDataList.isEmpty() ? 1 : 0;
+        for (Float y : sortedYs) {
+            List<com.finboost.bank.statement.parser.tableextractor.model.TableCell> rowCells = rowMap.get(y);
+            // Sort cells in row by column number
+            rowCells.sort(Comparator.comparing(c -> c.getColumnNumber() != null ? c.getColumnNumber() : 0));
+            
+            // Group cells by column number to merge cells with same row and column
+            Map<Integer, List<com.finboost.bank.statement.parser.tableextractor.model.TableCell>> columnMap = new HashMap<>();
+            for (com.finboost.bank.statement.parser.tableextractor.model.TableCell sourceCell : rowCells) {
+                int col = sourceCell.getColumnNumber() != null ? sourceCell.getColumnNumber() : 0;
+                columnMap.computeIfAbsent(col, k -> new ArrayList<>()).add(sourceCell);
+            }
+            
+            // Process each column in the row
+            for (Map.Entry<Integer, List<com.finboost.bank.statement.parser.tableextractor.model.TableCell>> entry : columnMap.entrySet()) {
+                int col = entry.getKey();
+                List<com.finboost.bank.statement.parser.tableextractor.model.TableCell> cellsInColumn = entry.getValue();
+                
+                // Merge all cells in the same column into one
+                com.finboost.bank.statement.parser.representation.document.extraction.TableCell targetCell = 
+                    mergeCells(cellsInColumn, currentRow, col, pageNumber);
+                
+                cells.computeIfAbsent(currentRow, k -> new HashMap<>()).put(col, targetCell);
+            }
+            currentRow++;
+        }
+        
+        rowIndex = currentRow - 1;
+        
+        table.setCells(cells);
+        table.setTotalRows(rowIndex + 1);
+        table.setTotalColumns(totalColumns);
+        
+        // Calculate table boundaries from cells
+        calculateTableBoundaries(table, cells);
+        
+        return table;
+    }
