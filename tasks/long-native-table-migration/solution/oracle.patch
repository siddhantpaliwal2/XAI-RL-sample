+        for (int row = 0; row < table.getRows(); row++) {
+            for (int col = 0; col < table.getColumns(); col++) {
+                CellStructure cell = table.getCell(row, col);
+                if (cell != null) {
+                    int cellLeft = (int) cell.getLeft();
+                    int cellRight = (int) cell.getRight();
+                    int cellTop = imageHeight - (int) cell.getTop();
+                    int cellBottom = imageHeight - (int) cell.getBottom();
+                    
+                    g2d.drawRect(cellLeft, cellBottom, cellRight - cellLeft, cellTop - cellBottom);
+                }
+            }
+        }
+        
+        // Add table information label
+        g2d.setColor(Color.BLACK);
+        g2d.setStroke(new BasicStroke(1));
+        g2d.setFont(new Font("Arial", Font.BOLD, 12));
+        String label = String.format("Table %d: %dx%d (%.0f%% confidence)", 
+                                    tableNumber, table.getColumns(), table.getRows(), 
