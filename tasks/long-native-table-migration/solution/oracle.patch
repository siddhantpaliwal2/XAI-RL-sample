+    /**
+     * Merge TableRows based on detected table row boundaries
+     * Groups TableRows that fall within the same detected row
+     */
+    private static List<TableRow> mergeTableRowsByDetectedRows(
+            List<TableRow> tableRows,
+            TableStructure detectedTable,
+            float pageHeight) {
+        
+        // Get detected row separator Y coordinates (in BOTTOM-LEFT system)
+        List<Double> rowSeparatorY = detectedTable.getRowSeparatorY();
+        if (rowSeparatorY == null || rowSeparatorY.size() < 2) {
+            // No row structure detected, return original rows
+            return tableRows;
+        }
+        
+        // Sort row separators (should already be sorted, but ensure it)
+        List<Double> sortedRowSeparators = new ArrayList<>(rowSeparatorY);
+        sortedRowSeparators.sort(Double::compareTo);
+        
+        // Create merged rows - one for each detected row region
+        List<TableRow> mergedRows = new ArrayList<>();
+        
+        // For each detected row region (between consecutive separators)
+        for (int i = 0; i < sortedRowSeparators.size() - 1; i++) {
+            double rowBottom = sortedRowSeparators.get(i);
+            double rowTop = sortedRowSeparators.get(i + 1);
+            double rowCenterBottomLeft = (rowBottom + rowTop) / 2.0;
+            
+            // Convert row center from BOTTOM-LEFT to TOP-LEFT for TableRow
+            float rowCenterTopLeft = pageHeight - (float) rowCenterBottomLeft;
+            
+            // Find all TableRows that fall within this detected row
+            List<TableRow> rowsInRegion = new ArrayList<>();
+            for (TableRow row : tableRows) {
+                if (row.getY() == null) continue;
+                
+                // Convert TableRow Y from TOP-LEFT to BOTTOM-LEFT
+                float tableRowBottomLeftY = pageHeight - row.getY();
+                
+                // Check if this TableRow falls within the detected row bounds
+                if (tableRowBottomLeftY >= rowBottom && tableRowBottomLeftY <= rowTop) {
+                    rowsInRegion.add(row);
+                }
+            }
+            
+            // Merge all TableRows in this region into one
+            if (!rowsInRegion.isEmpty()) {
+                TableRow mergedRow = new TableRow();
+                mergedRow.setPageIndex(rowsInRegion.get(0).getPageIndex());
+                mergedRow.setY(rowCenterTopLeft);  // Use row center as Y position
+                
+                // Collect all words from all rows in this region
+                List<WordData> allWords = new ArrayList<>();
+                for (TableRow row : rowsInRegion) {
+                    if (row.getWordDataList() != null) {
+                        allWords.addAll(row.getWordDataList());
+                    }
+                }
+                
+                // Sort words by X position for proper ordering
+                allWords.sort(Comparator.comparing(WordData::getX1));
+                mergedRow.setWordDataList(allWords);
+                
+                mergedRows.add(mergedRow);
+            }
+        }
+        
+        return mergedRows;
+    }
