+/**
+ * Utility class for extracting rows from word data
+ */
+public class RowExtractor {
+
+    private static Float SPACE_THRESHOLD_VERTICAL = 2.0f;
+    
+    public static final String DATE_FORMAT_REGEX = "(([0-9]{4}[-][0-1][0-9][-][0-3][0-9])|(^[0-3]?[0-9][-|/| |\\.][0-1]?[0-9][-|/| |\\.]([0-9]{2}([\\s]+|$)|[0-9]{4}([\\s]+|$))?(?![A-z])(?!([0-9]{3}([\\s]+|$))))|(^[0-1]?[0-9][-|/| ][0-3]?[0-9][-|/| ])([0-9]{2}([\\s]+|$)|[0-9]{4}([\\s]+|$))|(^[0-3]?[0-9][-|/| ][A-z]{3}[-|/| ][0-9]{2,4})|(^[0-3]?[0-9][-|/| ](jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec))|(^[0-3][0-9](jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)(20)?[0-9]{2}$)|(^[0-3][0-9][,][0-1][0-9][,](20)[0-9]{2}$))";
+    
+    private static final String URL_FORMAT_REGEX = "^(http|https):";
+    private static final String IGNORE_ADDRESS_TEXT = "^address";
+    private static final String DD_FORMAT_REGEX = "(^(([0-2]?[0-9])|[3][0-1])(,)?$)";
+    private static final String MMM_FORMAT_REGEX = "((^jan$)|(^feb$)|(^mar$)|(^apr$)|(^may$)|(^jun$)|(^jul$)|(^aug$)|(^sep(t)?$)|(^oct$)|(^nov$)|(^dec$))";
+    private static final String BALANCE_REGEX = "^(-?([0-9,]*\\.[0-9]{1,2})|([0-9,]+\\.[0-9]{0,2}))(-|Cr|Dr|CR|DR|dr|cr|\\(Cr\\)|\\(Dr\\))?$";
+    private static final String DATEFLAG_REGEX = "([0-3]?[0-9])\\s+((jan)|(feb)|(mar)|(apr)|(may)|(jun)|(jul)|(aug)|(sep(t))|(oct)|(nov)|(dec))\\s+[0-9]{4}(\\s)";
+
+    private static final Pattern DATE_PATTERN = Pattern.compile(DATE_FORMAT_REGEX);
+    private static final Pattern MMM_PATTERN = Pattern.compile(MMM_FORMAT_REGEX);
+    private static final Pattern BALANCE_PATTERN = Pattern.compile(BALANCE_REGEX);
+    private static final Pattern DD_PATTERN = Pattern.compile(DD_FORMAT_REGEX);
+    private static final Pattern DATEFLAG_PATTERN = Pattern.compile(DATEFLAG_REGEX);
