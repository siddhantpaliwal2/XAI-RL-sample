@@ -0,0 +1,256 @@
+package com.finboost.bank.statement.parser.tableextractor.graphics.line.reducer;
+
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.LineReductionConfig;
+import com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor.TableLineExtractor;
+
+import java.awt.geom.Point2D;
+import java.util.*;
+import java.util.stream.Collectors;
+
+/**
+ * Intelligent algorithm to reduce and merge fragmented horizontal lines
+ * Merges nearby, overlapping, and collinear horizontal lines into clean continuous lines
+ */
+public class HorizontalLinesReducer {
+    
+    private final LineReductionConfig config;
+    
+    public HorizontalLinesReducer(LineReductionConfig config) {
+        this.config = config;
+    }
+    
+    public HorizontalLinesReducer() {
+        this.config = new LineReductionConfig();
+    }
+    
+    /**
+     * Main method to reduce horizontal lines
+     * 
+     * @param originalLines List of original horizontal lines to reduce
+     * @return List of reduced and merged horizontal lines
+     */
+    public List<TableLineExtractor.Line> reduceLines(List<TableLineExtractor.Line> originalLines) {
+        if (originalLines == null || originalLines.isEmpty()) {
+            return new ArrayList<>();
+        }
+        
+        //System.out.println("HorizontalLinesReducer: Starting with " + originalLines.size() + " lines");
+        
+        // Step 1: Filter out very short lines
+        List<TableLineExtractor.Line> filteredLines = filterShortLines(originalLines);
+        //System.out.println("After filtering short lines: " + filteredLines.size() + " lines");
+        
+        // Step 2: Group lines by Y-coordinate (horizontal alignment)
+        Map<Double, List<TableLineExtractor.Line>> alignmentGroups = groupByAlignment(filteredLines);
+        //System.out.println("Grouped into " + alignmentGroups.size() + " alignment groups");
+        
+        // Step 3: Process each alignment group
+        List<TableLineExtractor.Line> reducedLines = new ArrayList<>();
+        for (Map.Entry<Double, List<TableLineExtractor.Line>> entry : alignmentGroups.entrySet()) {
+            List<TableLineExtractor.Line> groupLines = entry.getValue();
+            List<TableLineExtractor.Line> mergedGroupLines = processAlignmentGroup(groupLines);
+            reducedLines.addAll(mergedGroupLines);
+        }
+        
+        //System.out.println("HorizontalLinesReducer: Reduced to " + reducedLines.size() + " lines");
+        return reducedLines;
+    }
+    
+    /**
+     * Filter out lines that are too short to be meaningful
+     */
+    private List<TableLineExtractor.Line> filterShortLines(List<TableLineExtractor.Line> lines) {
+        return lines.stream()
+                .filter(line -> line.getLength() >= config.getHorizontalMinLength())
+                .collect(Collectors.toList());
+    }
+    
+    /**
+     * Group lines by their Y-coordinate (horizontal alignment)
+     * Lines with similar Y-coordinates are considered aligned
+     */
+    private Map<Double, List<TableLineExtractor.Line>> groupByAlignment(List<TableLineExtractor.Line> lines) {
+        Map<Double, List<TableLineExtractor.Line>> groups = new TreeMap<>();
+        
+        for (TableLineExtractor.Line line : lines) {
+            double avgY = (line.start.getY() + line.end.getY()) / 2.0;
+            
+            // Find existing group within tolerance
+            Double groupKey = null;
+            for (Double existingY : groups.keySet()) {
+                if (Math.abs(avgY - existingY) <= config.getHorizontalAlignmentTolerance()) {
+                    groupKey = existingY;
+                    break;
+                }
+            }
+            
+            // Create new group if no existing group found
+            if (groupKey == null) {
+                groupKey = avgY;
+                groups.put(groupKey, new ArrayList<>());
+            }
+            
+            groups.get(groupKey).add(line);
+        }
+        
+        return groups;
+    }
+    
+    /**
+     * Process lines within the same alignment group
+     * Merge overlapping, adjacent, and collinear lines
+     */
+    private List<TableLineExtractor.Line> processAlignmentGroup(List<TableLineExtractor.Line> groupLines) {
+        if (groupLines.size() <= 1) {
+            return new ArrayList<>(groupLines);
+        }
+        
+        // Sort lines by X-coordinate for easier processing
+        List<TableLineExtractor.Line> sortedLines = groupLines.stream()
+                .sorted(Comparator.comparingDouble(TableLineExtractor.Line::getMinX))
+                .collect(Collectors.toList());
+        
+        List<TableLineExtractor.Line> mergedLines = new ArrayList<>();
+        TableLineExtractor.Line currentLine = sortedLines.get(0);
+        
+        for (int i = 1; i < sortedLines.size(); i++) {
+            TableLineExtractor.Line nextLine = sortedLines.get(i);
+            
+            // Try to merge current line with next line
+            TableLineExtractor.Line mergedLine = attemptMerge(currentLine, nextLine);
+            
+            if (mergedLine != null) {
+                // Lines were merged, continue with merged line
+                currentLine = mergedLine;
+            } else {
+                // Lines couldn't be merged, add current line to result and move to next
+                mergedLines.add(currentLine);
+                currentLine = nextLine;
+            }
+        }
+        
+        // Add the last line
+        mergedLines.add(currentLine);
+        
+        return mergedLines;
+    }
+    
+    /**
+     * Attempt to merge two horizontal lines
+     * Returns merged line if successful, null otherwise
+     */
+    private TableLineExtractor.Line attemptMerge(TableLineExtractor.Line line1, TableLineExtractor.Line line2) {
+        // Check if lines are collinear (same Y-coordinate within tolerance)
+        double avgY1 = (line1.start.getY() + line1.end.getY()) / 2.0;
+        double avgY2 = (line2.start.getY() + line2.end.getY()) / 2.0;
+        
+        if (Math.abs(avgY1 - avgY2) > config.getHorizontalAlignmentTolerance()) {
+            return null; // Not aligned
+        }
+        
+        // Get X-ranges of both lines
+        double line1MinX = line1.getMinX();
+        double line1MaxX = line1.getMaxX();
+        double line2MinX = line2.getMinX();
+        double line2MaxX = line2.getMaxX();
+        
+        // Check for overlap or proximity
+        boolean canMerge = false;
+        
+        if (config.isEnableOverlapMerging()) {
+            // Check for overlap
+            double overlapStart = Math.max(line1MinX, line2MinX);
+            double overlapEnd = Math.min(line1MaxX, line2MaxX);
+            if (overlapEnd - overlapStart >= -config.getHorizontalOverlapTolerance()) {
+                canMerge = true;
+            }
+        }
+        
+        if (!canMerge && config.isEnableGapBridging()) {
+            // Check for small gap that can be bridged
+            double gap = Math.min(
+                Math.abs(line1MinX - line2MaxX),
+                Math.abs(line2MinX - line1MaxX)
+            );
+            if (gap <= config.getHorizontalGapTolerance()) {
+                canMerge = true;
+            }
+        }
+        
+        if (!canMerge && config.isEnableCollinearMerging()) {
+            // Check if lines are collinear and close enough
+            double distance = Math.min(
+                Math.abs(line1MinX - line2MaxX),
+                Math.abs(line2MinX - line1MaxX)
+            );
+            if (distance <= config.getCollinearityTolerance()) {
+                canMerge = true;
+            }
+        }
+        
+        if (canMerge) {
+            return createMergedLine(line1, line2, avgY1, avgY2);
+        }
+        
+        return null;
+    }
+    
+    /**
+     * Create a merged line from two lines
+     */
+    private TableLineExtractor.Line createMergedLine(TableLineExtractor.Line line1, TableLineExtractor.Line line2, 
+                                                    double avgY1, double avgY2) {
+        // Calculate merged Y-coordinate (weighted average based on line lengths)
+        double length1 = line1.getLength();
+        double length2 = line2.getLength();
+        double totalLength = length1 + length2;
+        double mergedY = (avgY1 * length1 + avgY2 * length2) / totalLength;
+        
+        // Calculate merged X-range
+        double mergedMinX = Math.min(line1.getMinX(), line2.getMinX());
+        double mergedMaxX = Math.max(line1.getMaxX(), line2.getMaxX());
+        
+        // Create new merged line
+        Point2D startPoint = new Point2D.Double(mergedMinX, mergedY);
+        Point2D endPoint = new Point2D.Double(mergedMaxX, mergedY);
+        
+        return new TableLineExtractor.Line(startPoint, endPoint);
+    }
+    
+    /**
+     * Get statistics about the reduction process
+     */
+    public ReductionStats getReductionStats(List<TableLineExtractor.Line> originalLines, 
+                                          List<TableLineExtractor.Line> reducedLines) {
+        return new ReductionStats(originalLines.size(), reducedLines.size(), "HORIZONTAL");
+    }
+    
+    /**
+     * Statistics class for line reduction
+     */
+    public static class ReductionStats {
+        private final int originalCount;
+        private final int reducedCount;
+        private final String lineType;
+        
+        public ReductionStats(int originalCount, int reducedCount, String lineType) {
+            this.originalCount = originalCount;
+            this.reducedCount = reducedCount;
+            this.lineType = lineType;
+        }
+        
+        public int getOriginalCount() { return originalCount; }
+        public int getReducedCount() { return reducedCount; }
+        public int getReductionCount() { return originalCount - reducedCount; }
+        public double getReductionPercentage() { 
+            return originalCount > 0 ? ((double)(originalCount - reducedCount) / originalCount) * 100.0 : 0.0; 
+        }
+        public String getLineType() { return lineType; }
+        
+        @Override
+        public String toString() {
+            return String.format("%s Lines: %d → %d (reduced %d lines, %.1f%% reduction)",
+                    lineType, originalCount, reducedCount, getReductionCount(), getReductionPercentage());
+        }
+    }
+}
