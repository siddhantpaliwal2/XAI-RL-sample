+    /**
+     * Convert WordData to Word object
+     */
+    private static Word convertWordDataToWord(WordData wordData, int wordIndex) {
+        Word word = new Word();
+        word.setContent(wordData.getWord());
+        word.setPageNumber(wordData.getPageIndex() != null ? wordData.getPageIndex() + 1 : 1);
+        word.setPageIndex(wordData.getPageIndex() != null ? wordData.getPageIndex() : 0);
+        word.setWordIndex(wordIndex);
+        
+        // Set polygon coordinates from WordData
+        // WordData has: x1, y1, x2, height (no y2)
+        // Calculate y2 as y1 + height
+        float x1 = wordData.getX1();
+        float y1 = wordData.getY1();
+        float x2 = wordData.getX2();
+        float y2 = y1 + wordData.getHeight();
+        
+        word.setX1(x1);
+        word.setY1(y1);
+        word.setX2(x2);
+        word.setY2(y1); // Y2 same as Y1 for top edge
+        word.setX3(x2);
+        word.setY3(y2);
+        word.setX4(x1);
+        word.setY4(y2);
+        
+        // Set dimensions
+        word.setWidth(x2 - x1);
+        word.setHeight(wordData.getHeight());
+        
+        // Note: WordData doesn't have CharDataList, so we skip EPdfWord construction
+        
+        return word;
+    }
