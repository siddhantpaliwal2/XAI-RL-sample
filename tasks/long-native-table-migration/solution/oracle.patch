+        Map<Float, List<WordData>> mappedTableCellMap = new HashMap<>();
+        
+        for (Map.Entry<Float, List<WordData>> entry : dummyMappedTableCellMap.entrySet()) {
+            List<WordData> values = entry.getValue();
+            boolean hasDate = values.stream().anyMatch(wd -> DATE_PATTERN.matcher(wd.getWord()).find());
+            boolean hasBalance = values.stream().anyMatch(wd -> wd.getWord().matches("^(-?[0-9,]*\\.?[0-9]{0,2})$"));
+            
+            if (hasDate && hasBalance) {
+                mappedTableCellMap.put(entry.getKey(), values);
+            }
+        }
+        
+        List<TableRow> resultTableRowList = new ArrayList<>();
+        if (mappedTableCellMap.size() > 5 && !junkDataFlag.get()) {
+            junkDataFlag.set(true);
+        } else if (mappedTableCellMap.size() < 4 && !junkDataFlag.get()) {
+            return resultTableRowList;
+        }
+        
+        int dataIndex = mappedTableCellMap.size() / 2;
+        List<List<WordData>> valuesList = new ArrayList<>(mappedTableCellMap.values());
+        
+        if (valuesList.isEmpty() || dataIndex >= valuesList.size()) {
+            return resultTableRowList;
+        }
+        
+        WordData date = valuesList.get(dataIndex).stream()
+                .filter(wd -> DATE_PATTERN.matcher(wd.getWord()).find())
+                .findFirst()
+                .orElse(null);
+        
+        if (date == null) {
+            return resultTableRowList;
+        }
+        
+        Float dateX2 = date.getX2();
+        
+        List<WordData> balanceWords = valuesList.get(dataIndex).stream()
+                .filter(wd -> wd.getWord().matches("^(-?[0-9,]*\\.?[0-9]{0,2})$"))
+                .collect(Collectors.toList());
+        
+        if (balanceWords.isEmpty()) {
+            return resultTableRowList;
+        }
+        
+        WordData balance = balanceWords.get(balanceWords.size() - 1);
+        Float balanceX1 = balance.getX1();
+        
+        int startIndex = 0;
+        int lastIndex = 0;
+        
+        // Find start index
+        for (int i = 0; i < tableRowList.size(); i++) {
+            TableRow tableRow = tableRowList.get(i);
+            boolean hasDateInRange = tableRow.getWordDataList().stream()
+                    .anyMatch(wd -> DATE_PATTERN.matcher(wd.getWord()).find() && wd.getX1() < dateX2);
+            boolean hasBalanceInRange = tableRow.getWordDataList().stream()
+                    .anyMatch(wd -> wd.getWord().matches("^(-?[0-9,]*\\.?[0-9]{0,2})$") && wd.getX2() > balanceX1);
+            
+            if (hasDateInRange && hasBalanceInRange) {
+                startIndex = i;
+                break;
+            }
+        }
+        
+        // Find header information
+        boolean dateFlag = false;
+        boolean balanceFlag = false;
+        int dateDescriptionBalanceRowCount = 0;
+        int tempStartIndex = startIndex;
+        
+        while (startIndex > 0 && dateDescriptionBalanceRowCount < 5) {
+            dateDescriptionBalanceRowCount++;
+            List<WordData> currentWordDataList = tableRowList.get(tempStartIndex - dateDescriptionBalanceRowCount).getWordDataList();
+            
+            if (currentWordDataList.stream().anyMatch(wd -> wd.getWord().matches("^(-?[0-9,]*\\.[0-9]{1,2})(Cr|Dr|CR|DR|dr|cr)?$"))) {
+                dateFlag = false;
+                balanceFlag = false;
+                continue;
+            }
+            
+            if (currentWordDataList.stream().anyMatch(wd -> wd.getWord().matches(".*[A-z]{3,}.*") && wd.getX1() < dateX2)) {
+                dateFlag = true;
+            }
+            
+            if (currentWordDataList.stream().anyMatch(wd -> wd.getWord().matches(".*[A-z]+.*") && (2 * wd.getX2() - wd.getX1()) > balanceX1)) {
+                balanceFlag = true;
+            }
+            
+            startIndex--;
+            if (dateFlag && balanceFlag) {
+                break;
+            }
+            balanceFlag = dateFlag = false;
+        }
+        
+        if (dateFlag && balanceFlag && startIndex >= 0) {
+            headerCellData.setWordDataList(tableRowList.get(startIndex).getWordDataList());
+            headerCellData.setRowNumber(startIndex);
+        }
+        
+        // Remove rows before start index
+        for (int i = 0; i < tempStartIndex; i++) {
+            tableRowList.remove(0);
+        }
+        
+        // Find last index
+        for (int i = tableRowList.size() - 1; i >= 0; i--) {
+            TableRow tableRow = tableRowList.get(i);
+            boolean hasDateInRange = tableRow.getWordDataList().stream()
+                    .anyMatch(wd -> DATE_PATTERN.matcher(wd.getWord()).find() && wd.getX1() < dateX2);
+            boolean hasBalanceInRange = tableRow.getWordDataList().stream()
+                    .anyMatch(wd -> wd.getWord().matches("^(-?[0-9,]*\\.?[0-9]{0,2})$") && wd.getX2() > balanceX1);
+            
+            if (hasDateInRange && hasBalanceInRange) {
+                lastIndex = i;
+                break;
+            }
+        }
+        
+        // Remove rows after last index
+        for (int i = tableRowList.size() - 1; i > lastIndex; i--) {
+            tableRowList.remove(tableRowList.size() - 1);
+        }
+        
+        resultTableRowList = tableRowList;
+        return resultTableRowList;
+    }
+}
