+        List<WordData> balanceList = wordDataList.stream()
+                .filter(wd -> BALANCE_PATTERN.matcher(wd.getWord()).find())
+                .collect(Collectors.toList());
+        
+        if (balanceList.isEmpty()) {
+            balanceList = wordDataList.stream()
+                    .filter(wd -> wd.getWord().matches("^(-?[0-9,]*[0-9]{0,2})(Cr|Dr|CR|DR|dr|cr)?$"))
+                    .collect(Collectors.toList());
+        }
+        
+        if (dateList.isEmpty() || balanceList.isEmpty()) {
+            return;
+        }
+        
+        Float dateX2 = dateList.get(0).getX2();
+        Float balanceX1 = balanceList.get(balanceList.size() - 1).getX1();
+        Integer tempStartIndex = copyPageRowList.indexOf(resultTableRowList.get(0));
+        
+        boolean dateFlag = false;
+        boolean balanceFlag = false;
+        int dateDescriptionBalanceRowCount = 0;
+        int startIndex = tempStartIndex;
+        int dateFlageIndex = 0;
