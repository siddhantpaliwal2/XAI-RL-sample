+package com.finboost.bank.statement.parser.service.bankstatement;
+
+import com.finboost.bank.statement.parser.representation.bankstatement.BankStatementVO;
+import com.finboost.bank.statement.parser.service.bankstatement.bank.*;
+import com.finboost.bank.statement.parser.service.bankstatement.config.BankStatementProcessingConfig;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+
+@Service
+public class BankWiseStatementHandlerService {
+    private HdfcHandler hdfcHandler;
+    private IciciHandler iciciHandler;
+    private KotakHandler kotakHandler;
+    private AxisHandler axisHandler;
+    private BobHandler bobHandler;
+    private CanaraHandler canaraHandler;
+    private IdfcHandler idfcHandler;
+    private IndianBankHandler indianBankHandler;
+    private PunjabBankHandler punjabBankHandler;
+    private SbiHandler sbiHandler;
+
+    @Autowired
+    public void setHdfcHandler(HdfcHandler hdfcHandler) {
+        this.hdfcHandler = hdfcHandler;
+    }
+
+    @Autowired
+    public void setIciciHandler(IciciHandler iciciHandler) {
+        this.iciciHandler = iciciHandler;
+    }
+
+    @Autowired
+    public void setKotakHandler(KotakHandler kotakHandler) {
+        this.kotakHandler = kotakHandler;
+    }
+
+    @Autowired
+    public void setAixsHandler(AxisHandler axisHandler) {
+        this.axisHandler = axisHandler;
+    }
+
+    @Autowired
+    public void setBobHandler(BobHandler bobHandler) {
+        this.bobHandler = bobHandler;
+    }
+
+    @Autowired
+    public void setCanaraHandler(CanaraHandler canaraHandler) {
+        this.canaraHandler = canaraHandler;
+    }
+
+    @Autowired
+    public void setIdfcHandler(IdfcHandler idfcHandler) {
+        this.idfcHandler = idfcHandler;
+    }
+
+    @Autowired
+    public void setIndianBankHandler(IndianBankHandler indianBankHandler) {
+        this.indianBankHandler = indianBankHandler;
+    }
+
+    @Autowired
+    public void setPunjabBankHandler(PunjabBankHandler punjabBankHandler) {
+        this.punjabBankHandler = punjabBankHandler;
+    }
+
+    @Autowired
+    public void setSbiHandler(SbiHandler sbiHandler) {
+        this.sbiHandler = sbiHandler;
+    }
+
+    public BankStatementProcessingConfig getBankStatementProcessingConfig(BankStatementVO bankStatementVO) throws Exception {
+
+        switch (bankStatementVO.getBank()){
+            case "KOTAK":
+                return kotakHandler.getTableExtractorConfig(bankStatementVO);
+            case "AXIS":
+                return axisHandler.getTableExtractorConfig(bankStatementVO);
+            case "HDFC":
+                return hdfcHandler.getTableExtractorConfig(bankStatementVO);
+            case "ICICI":
+                return iciciHandler.getTableExtractorConfig(bankStatementVO);
+            case "BANK_OF_BARODA":
+                return bobHandler.getTableExtractorConfig(bankStatementVO);
+            case "CANARA":
+                return canaraHandler.getTableExtractorConfig(bankStatementVO);
+            case "IDFC":
+                return idfcHandler.getTableExtractorConfig(bankStatementVO);
+            case "INDIAN_BANK":
+                return indianBankHandler.getTableExtractorConfig(bankStatementVO);
+            case "PNB":
+                return punjabBankHandler.getTableExtractorConfig(bankStatementVO);
+            case "SBI":
+                return sbiHandler.getTableExtractorConfig(bankStatementVO);
+            default:
+                return new BankStatementProcessingConfig();
+        }
+    }
+}
