+package com.finboost.bank.statement.parser.tableextractor.graphics.config;
+
+/**
+ * Simple configuration for boundary-based table detection
+ * 
+ * This configuration controls how the boundary-based algorithm detects tables:
+ * - Border tolerance: How aligned rectangle borders need to be
+ * - Size constraints: Minimum table dimensions
+ * - Intersection tolerance: How close lines need to be to merge
+ */
+public class TableDetectionConfig {
+    
+    // Border detection parameters
+    private double borderTolerance = 5.0;              // Tolerance for border line alignment
+    private double intersectionTolerance = 3.0;        // Tolerance for merging close lines/coordinates
+    
+    // Table size constraints
+    private double minTableWidth = 30.0;               // Minimum table width (pixels)
+    private double minTableHeight = 10.0;              // Minimum table height (pixels)
+    
+    // Default constructor with standard settings
+    public TableDetectionConfig() {
+        // Uses default values defined above
+    }
+    
+    // Constructor with custom parameters
+    public TableDetectionConfig(double borderTolerance, double intersectionTolerance,
+                               double minTableWidth, double minTableHeight) {
+        this.borderTolerance = borderTolerance;
+        this.intersectionTolerance = intersectionTolerance;
+        this.minTableWidth = minTableWidth;
+        this.minTableHeight = minTableHeight;
+    }
+    
+    // Getters and setters
+    public double getBorderTolerance() { 
+        return borderTolerance; 
+    }
+    
+    public void setBorderTolerance(double borderTolerance) { 
+        this.borderTolerance = borderTolerance; 
+    }
+    
+    public double getIntersectionTolerance() { 
+        return intersectionTolerance; 
+    }
+    
+    public void setIntersectionTolerance(double intersectionTolerance) { 
+        this.intersectionTolerance = intersectionTolerance; 
+    }
+    
+    public double getMinTableWidth() { 
+        return minTableWidth; 
+    }
+    
+    public void setMinTableWidth(double minTableWidth) { 
+        this.minTableWidth = minTableWidth; 
+    }
+    
+    public double getMinTableHeight() { 
+        return minTableHeight; 
+    }
+    
+    public void setMinTableHeight(double minTableHeight) { 
+        this.minTableHeight = minTableHeight; 
+    }
+    
+    /**
+     * Create configuration for standard bank statements
+     * - Moderate tolerances for real-world PDFs
+     * - Allows small header tables and large transaction tables
+     */
+    public static TableDetectionConfig createStandardConfig() {
+        return new TableDetectionConfig(
+            5.0,    // borderTolerance - moderate alignment requirement
+            3.0,    // intersectionTolerance - merge close lines
+            30.0,   // minTableWidth - reasonable minimum width
+            10.0    // minTableHeight - allows small header tables
+        );
+    }
+    
+    /**
+     * Create configuration for high-quality PDFs
+     * - Stricter tolerances for precise detection
+     * - Use when PDFs have very clean lines
+     */
+    public static TableDetectionConfig createStrictConfig() {
+        return new TableDetectionConfig(
+            2.0,    // borderTolerance - strict alignment
+            2.0,    // intersectionTolerance - strict merging
+            50.0,   // minTableWidth - larger minimum
+            20.0    // minTableHeight - larger minimum
+        );
+    }
+    
+    /**
+     * Create configuration for scanned/low-quality PDFs
+     * - More forgiving tolerances
+     * - Handles misaligned lines better
+     */
+    public static TableDetectionConfig createLenientConfig() {
+        return new TableDetectionConfig(
+            10.0,   // borderTolerance - very forgiving alignment
+            5.0,    // intersectionTolerance - merge more aggressively
+            20.0,   // minTableWidth - allow smaller tables
+            8.0     // minTableHeight - allow very small tables
+        );
+    }
+    
+    /**
+     * Create configuration for forms with small cells
+     * - Allows very small tables (form fields, checkboxes, etc.)
+     */
+    public static TableDetectionConfig createFormConfig() {
+        return new TableDetectionConfig(
+            4.0,    // borderTolerance - moderate
+            2.0,    // intersectionTolerance - precise
+            15.0,   // minTableWidth - allow very small tables
+            5.0     // minTableHeight - allow tiny form fields
+        );
+    }
+    
+    @Override
+    public String toString() {
+        return String.format("TableDetectionConfig{" +
+                "borderTol=%.1f, intersectionTol=%.1f, " +
+                "minSize=%.1fx%.1f}",
+                borderTolerance, intersectionTolerance,
+                minTableWidth, minTableHeight);
+    }
+}
