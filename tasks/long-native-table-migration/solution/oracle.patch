+     */
+    private static Table buildTableFromGridStructure(Integer pageNumber,
+                                                     TableStructure detectedTable,
+                                                     List<WordData> pageWords,
+                                                     float pageHeight) {
+        Table table = new Table();
+        table.setPageNumber(pageNumber);
+        table.setColType(new ArrayList<>());
+        table.setTxnColType(new ArrayList<>());
+        
+        int totalRows = detectedTable.getRows();
