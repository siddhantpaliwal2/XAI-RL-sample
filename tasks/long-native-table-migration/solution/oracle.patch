+package com.finboost.bank.statement.parser.service.bankstatement.config;
+
+/**
+ * Comprehensive configuration for transaction table parsing
+ * 
+ * This configuration object controls how transaction tables are parsed from bank statements:
+ * - Parsing strategy (below date, above date, or both)
+ * - Future extensibility for additional parsing parameters
+ * 
+ * Use the Builder pattern for easy, readable configuration:
+ * <pre>
+ * TransactionTableParsingConfig config = TransactionTableParsingConfig.builder()
+ *     .parsingType(TransactionTableParsingType.BELOW_DATE)
+ *     .build();
+ * </pre>
+ */
+public class TransactionTableParsingConfig {
+    
+    // ============================================
+    // Parsing Strategy
+    // ============================================
+    
+    private TransactionTableParsingType parsingType;
+    
+    // ============================================
+    // Future extensibility - add new fields here
+    // ============================================
+    
+    // Examples of future fields:
+    // private boolean strictDateMatching;
+    // private String dateFormat;
+    // private int maxRowsToScan;
+    // private boolean includeHeaderRow;
+    
+    // ============================================
+    // Private Constructor (use Builder)
+    // ============================================
+    
+    private TransactionTableParsingConfig() {
+        // Set defaults
+        this.parsingType = TransactionTableParsingType.BELOW_DATE;
+    }
+    
+    // ============================================
+    // Builder Pattern
+    // ============================================
+    
+    public static class Builder {
+        private final TransactionTableParsingConfig config = new TransactionTableParsingConfig();
+        
+        public Builder parsingType(TransactionTableParsingType type) {
+            config.parsingType = type;
+            return this;
+        }
+        
+        // Future builder methods can be added here without breaking existing code
+        // Example:
+        // public Builder strictDateMatching(boolean strict) {
+        //     config.strictDateMatching = strict;
+        //     return this;
+        // }
+        
+        public TransactionTableParsingConfig build() {
+            validate();
+            return config;
+        }
+        
+        private void validate() {
+            if (config.parsingType == null) {
+                throw new IllegalArgumentException("parsingType cannot be null");
+            }
+        }
+    }
+    
+    public static Builder builder() {
+        return new Builder();
+    }
+    
+    // ============================================
+    // Getters (Immutable after build)
+    // ============================================
+    
+    public TransactionTableParsingType getParsingType() {
+        return parsingType;
+    }
+    
+    // Future getters can be added here
+    
+    // ============================================
+    // Pre-configured Profiles
+    // ============================================
+    
+    /**
+     * Default configuration - parses transactions below date row
+     */
+    public static TransactionTableParsingConfig defaultConfig() {
+        return builder().build();
+    }
+    
+    /**
+     * Configuration for parsing transactions below the date row
+     * Used for most standard bank statement formats
+     */
+    public static TransactionTableParsingConfig belowDate() {
+        return builder()
+            .parsingType(TransactionTableParsingType.BELOW_DATE)
+            .build();
+    }
+    
+    /**
+     * Configuration for parsing transactions above the date row
+     * Used for reverse-chronological bank statements
+     */
+    public static TransactionTableParsingConfig aboveDate() {
+        return builder()
+            .parsingType(TransactionTableParsingType.ABOVE_DATE)
+            .build();
+    }
+    
+    /**
+     * Configuration for parsing transactions both above and below the date row
+     * Used for complex bank statement formats with split sections
+     */
+    public static TransactionTableParsingConfig aboveBelowDate() {
+        return builder()
+            .parsingType(TransactionTableParsingType.ABOVE_BELOW_DATE)
+            .build();
+    }
+    
+    @Override
+    public String toString() {
+        return "TransactionTableParsingConfig{" +
+                "parsingType=" + parsingType +
+                '}';
+    }
+}
