+                if (Math.round(prevY - remainingRow.getY()) <= (Math.round(verticalDiff) + 6) &&
+                    dateWordDataList.isEmpty() && balanceWordDataList.isEmpty() && hasValidWords) {
+                    firstTableRowList.add(remainingRow);
+                    prevY = remainingRow.getY();
+                } else {
+                    break;
+                }
+            }
+            
+            Collections.reverse(firstTableRowList);
+            
+        } catch (Exception e) {
+            System.out.println("Exception occurred while fetching the first transaction record ====>>>>>>    " + e.getMessage());
+        }
+        return firstTableRowList;
+    }
