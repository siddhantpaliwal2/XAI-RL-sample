@@ -0,0 +1,282 @@
+package com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor;
+
+import com.finboost.bank.statement.parser.tableextractor.graphics.line.reducer.IntelligentLineReducer;
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.LineReductionConfig;
+import org.apache.pdfbox.contentstream.PDFGraphicsStreamEngine;
+import org.apache.pdfbox.pdmodel.PDPage;
+import org.apache.pdfbox.pdmodel.graphics.image.PDImage;
+
+import java.awt.geom.Point2D;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+
+public class TableLineExtractor extends PDFGraphicsStreamEngine {
+
+    private List<Line> horizontalLines = new ArrayList<>();
+    private List<Line> verticalLines = new ArrayList<>();
+    private Point2D currentPoint;
+    
+    // Line reduction components
+    private final IntelligentLineReducer lineReducer;
+    private final boolean enableLineReduction;
+    
+    // Cached reduced lines
+    private List<Line> reducedHorizontalLines = null;
+    private List<Line> reducedVerticalLines = null;
+    private boolean linesReduced = false;
+
+    public TableLineExtractor(PDPage page) {
+        super(page);
+        this.lineReducer = new IntelligentLineReducer();
+        this.enableLineReduction = true;
+    }
+    
+    public TableLineExtractor(PDPage page, LineReductionConfig config) {
+        super(page);
+        this.lineReducer = new IntelligentLineReducer(config);
+        this.enableLineReduction = true;
+    }
+    
+    public TableLineExtractor(PDPage page, boolean enableLineReduction) {
+        super(page);
+        this.lineReducer = enableLineReduction ? new IntelligentLineReducer() : null;
+        this.enableLineReduction = enableLineReduction;
+    }
+    
+    public TableLineExtractor(PDPage page, LineReductionConfig config, boolean enableLineReduction) {
+        super(page);
+        this.lineReducer = enableLineReduction ? new IntelligentLineReducer(config) : null;
+        this.enableLineReduction = enableLineReduction;
+    }
+
+    @Override
+    public void appendRectangle(Point2D p0, Point2D p1, Point2D p2, Point2D p3) throws IOException {
+        // Rectangle detected - split into 4 lines
+        horizontalLines.add(new Line(p0, p1));
+        verticalLines.add(new Line(p0, p3));
+        horizontalLines.add(new Line(p3, p2));
+        verticalLines.add(new Line(p1, p2));
+    }
+
+    @Override
+    public void moveTo(float x, float y) throws IOException {
+        currentPoint = new Point2D.Float(x, y);
+    }
+
+    @Override
+    public void lineTo(float x, float y) throws IOException {
+        Point2D endPoint = new Point2D.Float(x, y);
+
+        if (currentPoint != null) {
+            Line line = new Line(currentPoint, endPoint);
+
+            // Classify line as horizontal or vertical (with tolerance)
+            if (Math.abs(currentPoint.getY() - endPoint.getY()) < 1.0) {
+                horizontalLines.add(line);
+            } else if (Math.abs(currentPoint.getX() - endPoint.getX()) < 1.0) {
+                verticalLines.add(line);
+            }
+        }
+
+        currentPoint = endPoint;
+    }
+
+    @Override
+    public void curveTo(float x1, float y1, float x2, float y2, float x3, float y3) throws IOException {
+        // Handle curves if needed
+    }
+
+    @Override
+    public Point2D getCurrentPoint() throws IOException {
+        return currentPoint;
+    }
+
+    @Override
+    public void closePath() throws IOException {
+        // Path closed
+    }
+
+    @Override
+    public void endPath() throws IOException {
+        // Path ended
+    }
+
+    @Override
+    public void strokePath() throws IOException {
+        // Stroke the path - lines are drawn
+    }
+
+    @Override
+    public void fillPath(int windingRule) throws IOException {
+        // Fill path
+    }
+
+    @Override
+    public void fillAndStrokePath(int windingRule) throws IOException {
+        // Fill and stroke
+    }
+
+    @Override
+    public void shadingFill(org.apache.pdfbox.cos.COSName shadingName) throws IOException {
+        // Shading fill
+    }
+
+    @Override
+    public void drawImage(PDImage pdImage) throws IOException {
+        // Draw image
+    }
+
+    @Override
+    public void clip(int windingRule) throws IOException {
+        // Clip path
+    }
+
+    public List<Line> getHorizontalLines() {
+        if (enableLineReduction) {
+            return getReducedHorizontalLines();
+        }
+        return horizontalLines;
+    }
+
+    public List<Line> getVerticalLines() {
+        if (enableLineReduction) {
+            return getReducedVerticalLines();
+        }
+        return verticalLines;
+    }
+    
+    /**
+     * Get original horizontal lines (before reduction)
+     */
+    public List<Line> getOriginalHorizontalLines() {
+        return horizontalLines;
+    }
+    
+    /**
+     * Get original vertical lines (before reduction)
+     */
+    public List<Line> getOriginalVerticalLines() {
+        return verticalLines;
+    }
+    
+    /**
+     * Get reduced horizontal lines
+     */
+    public List<Line> getReducedHorizontalLines() {
+        if (!enableLineReduction) {
+            return horizontalLines;
+        }
+        
+        if (!linesReduced) {
+            performLineReduction();
+        }
+        return reducedHorizontalLines;
+    }
+    
+    /**
+     * Get reduced vertical lines
+     */
+    public List<Line> getReducedVerticalLines() {
+        if (!enableLineReduction) {
+            return verticalLines;
+        }
+        
+        if (!linesReduced) {
+            performLineReduction();
+        }
+        return reducedVerticalLines;
+    }
+    
+    /**
+     * Perform line reduction using the intelligent line reducer
+     */
+    private void performLineReduction() {
+        if (!enableLineReduction || lineReducer == null) {
+            reducedHorizontalLines = new ArrayList<>(horizontalLines);
+            reducedVerticalLines = new ArrayList<>(verticalLines);
+            linesReduced = true;
+            return;
+        }
+        
+        IntelligentLineReducer.LineReductionResult result = lineReducer.reduceLines(horizontalLines, verticalLines);
+        
+        reducedHorizontalLines = result.getReducedHorizontalLines();
+        reducedVerticalLines = result.getReducedVerticalLines();
+        linesReduced = true;
+    }
+    
+    /**
+     * Get line reduction statistics
+     */
+    public IntelligentLineReducer.LineReductionResult getLineReductionResult() {
+        if (!enableLineReduction) {
+            return null;
+        }
+        
+        if (!linesReduced) {
+            performLineReduction();
+        }
+        
+        return lineReducer.reduceLines(horizontalLines, verticalLines);
+    }
+    
+    /**
+     * Reset line reduction cache (useful when lines are modified)
+     */
+    public void resetLineReduction() {
+        reducedHorizontalLines = null;
+        reducedVerticalLines = null;
+        linesReduced = false;
+    }
+    
+    /**
+     * Check if line reduction is enabled
+     */
+    public boolean isLineReductionEnabled() {
+        return enableLineReduction;
+    }
+
+    // Helper class to represent a line
+    public static class Line {
+        public Point2D start;
+        public Point2D end;
+
+        public Line(Point2D start, Point2D end) {
+            this.start = start;
+            this.end = end;
+        }
+        
+        // Getters for better encapsulation (use these instead of direct field access)
+        public Point2D getStart() { return start; }
+        public Point2D getEnd() { return end; }
+
+        public double getMinX() {
+            return Math.min(start.getX(), end.getX());
+        }
+
+        public double getMaxX() {
+            return Math.max(start.getX(), end.getX());
+        }
+
+        public double getMinY() {
+            return Math.min(start.getY(), end.getY());
+        }
+
+        public double getMaxY() {
+            return Math.max(start.getY(), end.getY());
+        }
+
+        public double getLength() {
+            return start.distance(end);
+        }
+
+        public boolean isHorizontal() {
+            return Math.abs(start.getY() - end.getY()) < 1.0;
+        }
+
+        public boolean isVertical() {
+            return Math.abs(start.getX() - end.getX()) < 1.0;
+        }
+    }
+}
