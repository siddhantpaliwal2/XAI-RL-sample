@@ -0,0 +1,22 @@
+package com.finboost.bank.statement.parser.tableextractor.config;
+
+/**
+ * Extraction strategy for PDF table detection
+ */
+public enum ExtractionStrategy {
+    /** Pure grid line detection - best for PDFs with clear table borders */
+    GRID_LINE,
+    
+    /** Pure text position analysis - best for PDFs without visible borders */
+    TEXT_POSITION,
+    
+    /** Hybrid: grid lines for boundaries + text position for processing */
+    BOX_LINE_TEXT_POSITION,
+
+    /** By customizing the table row selection per page */
+    SELECTED_ROWS_TEXT_POSITION,
+
+    /** ML Based using Azure Document API */
+    ML_BASED
+}
+
