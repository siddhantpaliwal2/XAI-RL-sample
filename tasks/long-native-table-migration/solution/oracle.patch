+package com.finboost.bank.statement.parser.tableextractor.graphics.config;
+
+/**
+ * Configuration class for line reduction algorithms
+ * Contains configurable thresholds and parameters for merging lines
+ */
+public class LineReductionConfig {
+    
+    // Horizontal line reduction parameters
+    private double horizontalAlignmentTolerance = 2.0;      // Y-axis tolerance for considering lines aligned
+    private double horizontalGapTolerance = 5.0;           // Maximum gap to bridge between line segments
+    private double horizontalOverlapTolerance = 1.0;       // Minimum overlap to consider lines as overlapping
+    private double horizontalMinLength = 1.0;              // Minimum length to keep a line
+    
+    // Vertical line reduction parameters  
+    private double verticalAlignmentTolerance = 2.0;       // X-axis tolerance for considering lines aligned
+    private double verticalGapTolerance = 5.0;             // Maximum gap to bridge between line segments
+    private double verticalOverlapTolerance = 1.0;         // Minimum overlap to consider lines as overlapping
+    private double verticalMinLength = 1.0;                // Minimum length to keep a line
+    
+    // General parameters
+    private boolean enableGapBridging = true;              // Whether to bridge small gaps between lines
+    private boolean enableOverlapMerging = true;           // Whether to merge overlapping lines
+    private boolean enableCollinearMerging = true;         // Whether to merge collinear lines
+    private double collinearityTolerance = 1.0;           // Tolerance for considering lines collinear
+    
+    // Default constructor with standard values
+    public LineReductionConfig() {
+        // Uses default values defined above
+    }
+    
+    // Constructor for custom configuration
+    public LineReductionConfig(double alignmentTolerance, double gapTolerance, double minLength) {
+        this.horizontalAlignmentTolerance = alignmentTolerance;
+        this.verticalAlignmentTolerance = alignmentTolerance;
+        this.horizontalGapTolerance = gapTolerance;
+        this.verticalGapTolerance = gapTolerance;
+        this.horizontalMinLength = minLength;
+        this.verticalMinLength = minLength;
+    }
+    
+    // Getters and setters for horizontal line parameters
+    public double getHorizontalAlignmentTolerance() { return horizontalAlignmentTolerance; }
+    public void setHorizontalAlignmentTolerance(double horizontalAlignmentTolerance) { 
+        this.horizontalAlignmentTolerance = horizontalAlignmentTolerance; 
+    }
+    
+    public double getHorizontalGapTolerance() { return horizontalGapTolerance; }
+    public void setHorizontalGapTolerance(double horizontalGapTolerance) { 
+        this.horizontalGapTolerance = horizontalGapTolerance; 
+    }
+    
+    public double getHorizontalOverlapTolerance() { return horizontalOverlapTolerance; }
+    public void setHorizontalOverlapTolerance(double horizontalOverlapTolerance) { 
+        this.horizontalOverlapTolerance = horizontalOverlapTolerance; 
+    }
+    
+    public double getHorizontalMinLength() { return horizontalMinLength; }
+    public void setHorizontalMinLength(double horizontalMinLength) { 
+        this.horizontalMinLength = horizontalMinLength; 
+    }
+    
+    // Getters and setters for vertical line parameters
+    public double getVerticalAlignmentTolerance() { return verticalAlignmentTolerance; }
+    public void setVerticalAlignmentTolerance(double verticalAlignmentTolerance) { 
+        this.verticalAlignmentTolerance = verticalAlignmentTolerance; 
+    }
+    
+    public double getVerticalGapTolerance() { return verticalGapTolerance; }
+    public void setVerticalGapTolerance(double verticalGapTolerance) { 
+        this.verticalGapTolerance = verticalGapTolerance; 
+    }
+    
+    public double getVerticalOverlapTolerance() { return verticalOverlapTolerance; }
+    public void setVerticalOverlapTolerance(double verticalOverlapTolerance) { 
+        this.verticalOverlapTolerance = verticalOverlapTolerance; 
+    }
+    
+    public double getVerticalMinLength() { return verticalMinLength; }
+    public void setVerticalMinLength(double verticalMinLength) { 
+        this.verticalMinLength = verticalMinLength; 
+    }
+    
+    // Getters and setters for general parameters
+    public boolean isEnableGapBridging() { return enableGapBridging; }
+    public void setEnableGapBridging(boolean enableGapBridging) { 
+        this.enableGapBridging = enableGapBridging; 
+    }
+    
+    public boolean isEnableOverlapMerging() { return enableOverlapMerging; }
+    public void setEnableOverlapMerging(boolean enableOverlapMerging) { 
+        this.enableOverlapMerging = enableOverlapMerging; 
+    }
+    
+    public boolean isEnableCollinearMerging() { return enableCollinearMerging; }
+    public void setEnableCollinearMerging(boolean enableCollinearMerging) { 
+        this.enableCollinearMerging = enableCollinearMerging; 
+    }
+    
+    public double getCollinearityTolerance() { return collinearityTolerance; }
+    public void setCollinearityTolerance(double collinearityTolerance) { 
+        this.collinearityTolerance = collinearityTolerance; 
+    }
+    
+    /**
+     * Creates a configuration optimized for fine-grained line detection
+     */
+    public static LineReductionConfig createFineGrainedConfig() {
+        LineReductionConfig config = new LineReductionConfig();
+        config.setHorizontalAlignmentTolerance(1.0);
+        config.setVerticalAlignmentTolerance(1.0);
+        config.setHorizontalGapTolerance(2.0);
+        config.setVerticalGapTolerance(2.0);
+        config.setCollinearityTolerance(0.5);
+        return config;
+    }
+    
+    /**
+     * Creates a configuration optimized for aggressive line merging
+     */
+    public static LineReductionConfig createAggressiveConfig() {
+        LineReductionConfig config = new LineReductionConfig();
+        config.setHorizontalAlignmentTolerance(5.0);
+        config.setVerticalAlignmentTolerance(5.0);
+        config.setHorizontalGapTolerance(10.0);
+        config.setVerticalGapTolerance(10.0);
+        config.setCollinearityTolerance(3.0);
+        return config;
+    }
+    
+    /**
+     * Creates a configuration optimized for table detection
+     */
+    public static LineReductionConfig createTableDetectionConfig() {
+        LineReductionConfig config = new LineReductionConfig();
+        config.setHorizontalAlignmentTolerance(2.0);
+        config.setVerticalAlignmentTolerance(2.0);
+        config.setHorizontalGapTolerance(5.0);
+        config.setVerticalGapTolerance(5.0);
+        config.setHorizontalMinLength(5.0);
+        config.setVerticalMinLength(5.0);
+        config.setCollinearityTolerance(1.5);
+        return config;
+    }
+    
+    @Override
+    public String toString() {
+        return String.format("LineReductionConfig{" +
+                "horizontalAlignment=%.1f, verticalAlignment=%.1f, " +
+                "horizontalGap=%.1f, verticalGap=%.1f, " +
+                "collinearity=%.1f, gapBridging=%s, overlapMerging=%s}",
+                horizontalAlignmentTolerance, verticalAlignmentTolerance,
+                horizontalGapTolerance, verticalGapTolerance,
+                collinearityTolerance, enableGapBridging, enableOverlapMerging);
+    }
+}
