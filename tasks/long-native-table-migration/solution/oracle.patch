@@ -0,0 +1,109 @@
+package com.finboost.bank.statement.parser.tableextractor.model;
+
+import java.util.Objects;
+
+/**
+ * Model class to represent word data extracted from PDF
+ */
+public class WordData {
+
+    private String word;
+    private float x1;
+    private float y1;
+    private float actualY1;
+    private float x2;
+    private float height;
+    private Integer pageIndex;
+
+    public WordData() {
+    }
+
+    public WordData(CharData lastCharData, CharData firstCharData, String word) {
+        this.word = word.replaceAll("−", "-");
+        this.x1 = firstCharData.getX();
+        this.x2 = lastCharData.getX() + lastCharData.getWidth();
+        this.y1 = firstCharData.getY();
+        this.actualY1 = firstCharData.getY();
+        this.pageIndex = firstCharData.getPageIndex();
+        this.height = firstCharData.getHeight();
+    }
+
+    public float getActualY1() {
+        return actualY1;
+    }
+
+    public void setActualY1(float actualY1) {
+        this.actualY1 = actualY1;
+    }
+
+    public float getHeight() {
+        return height;
+    }
+
+    public void setHeight(float height) {
+        this.height = height;
+    }
+
+    public String getWord() {
+        return word;
+    }
+
+    public void setWord(String word) {
+        this.word = word;
+    }
+
+    public float getX1() {
+        return x1;
+    }
+
+    public void setX1(float x1) {
+        this.x1 = x1;
+    }
+
+    public float getY1() {
+        return y1;
+    }
+
+    public void setY1(float y1) {
+        this.y1 = y1;
+    }
+
+    public float getX2() {
+        return x2;
+    }
+
+    public void setX2(float x2) {
+        this.x2 = x2;
+    }
+
+    public Integer getPageIndex() {
+        return pageIndex;
+    }
+
+    public void setPageIndex(Integer pageIndex) {
+        this.pageIndex = pageIndex;
+    }
+
+    public float getMidPointX() {
+        return (this.x1 + ((this.x2 - this.x1) / 2));
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) return true;
+        if (o == null || getClass() != o.getClass()) return false;
+        WordData wordData = (WordData) o;
+        return Float.compare(wordData.x1, x1) == 0 &&
+                Float.compare(wordData.y1, y1) == 0 &&
+                Float.compare(wordData.actualY1, actualY1) == 0 &&
+                Float.compare(wordData.x2, x2) == 0 &&
+                Float.compare(wordData.height, height) == 0 &&
+                Objects.equals(word, wordData.word) &&
+                Objects.equals(pageIndex, wordData.pageIndex);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(word, x1, y1, actualY1, x2, height, pageIndex);
+    }
+}
diff --git a/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/AppUtil.java b/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/AppUtil.java
new file mode 100644
index 0000000000000000000000000000000000000000..99a767f17e1dd44938dfc61ba8007c8fcd58ec15
--- /dev/null
+++ b/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/AppUtil.java
@@ -0,0 +1,275 @@
+package com.finboost.bank.statement.parser.tableextractor.util;
+
+import com.finboost.bank.statement.parser.tableextractor.model.*;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.IOException;
+import java.util.*;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Utility class for common operations in table extraction
+ */
+public class AppUtil {
+
+    public static final String DATE_FORMAT_REGEX = "((^[0-3]?[0-9][-|/| ][0-1]?[0-9]([-|/| ][0-9]{2,4})?)|([0-1]?[0-9][-|/| ][0-3]?[0-9][-|/| ][0-9]{2,4})|([0-3]?[0-9][-|/| ]((jan)|(feb)|(mar)|(apr)|(may)|(jun)|(jul)|(aug)|(sep)|(oct)|(nov)|(dec))[-|/| ][0-9]{2,4})|([0-3]?[0-9][-|/| ]((jan)|(feb)|(mar)|(apr)|(may)|(jun)|(jul)|(aug)|(sep)|(oct)|(nov)|(dec))))";
+    public static final String DD_FORMAT_REGEX = "(^[0-3]?[0-9]$)";
+    public static final String MMM_FORMAT_REGEX = "((jan)|(feb)|(mar)|(apr)|(may)|(jun)|(jul)|(aug)|(sep)|(oct)|(nov)|(dec))";
+    public static final String COMPLETE_BALANCE_REGEX = "(-?([0-9]{1,3},)*[0-9]{1,3}\\.[0-9]{2}$)";
+    public static final String IGNORE_HEADER_ROW_REGEX = "[\\s]*statement[\\s]*of[\\s]*account";
+
+
+    private static final Pattern DATE_PATTERN = Pattern.compile(DATE_FORMAT_REGEX);
+    private static final Pattern DD_PATTERN = Pattern.compile(DD_FORMAT_REGEX);
+    private static final Pattern MMM_PATTERN = Pattern.compile(MMM_FORMAT_REGEX);
+    private static final Pattern COMPLETE_BALANCE_PATTERN = Pattern.compile(COMPLETE_BALANCE_REGEX);
+    private static final Pattern IGNORE_HEADER_PATTERN = Pattern.compile(IGNORE_HEADER_ROW_REGEX);
+
+    public static List<TableRow> removeHeaderRow(List<TableRow> tableRowList) {
+        int count = 0;
+        List<TableRow> resultRowList = new ArrayList<>(tableRowList);
+        
+        for (TableRow tableRow : tableRowList) {
+            boolean isHeaderTextMatch = IGNORE_HEADER_PATTERN.matcher(tableRow.getContent().toLowerCase()).find();
+            
+            String dateRegexPattern = "(" + DATE_FORMAT_REGEX + "|" + DD_FORMAT_REGEX + "\\s+" + MMM_FORMAT_REGEX + ")";
+            if (Pattern.compile(dateRegexPattern).matcher(tableRow.getContent().toLowerCase()).find() && !isHeaderTextMatch) {
+                break;
+            }
+            count++;
+        }
+        
+        while (count - 1 >= 0) {
+            resultRowList.remove(0);
+            count--;
+        }
+        
+        return resultRowList;
+    }
+
+
+    public static Float calculateHorizontalWordSpaceForHeader(HeaderCellData headerCellData) {
+        List<Float> spaceList = new ArrayList<>();
+        List<WordData> wordDataList = headerCellData.getWordDataList();
+        
+        if (wordDataList == null || wordDataList.isEmpty()) {
+            return 0f;
+        }
+        
+        wordDataList.sort(Comparator.comparing(WordData::getX1));
+        
+        for (int count = 0; count < wordDataList.size() - 1; count++) {
+            WordData current = wordDataList.get(count);
+            WordData next = wordDataList.get(count + 1);
+            
+            if ((next.getX1() - current.getX2()) > 0 && next.getWord().length() > 1) {
+                spaceList.add(next.getX1() - current.getX2());
+            }
+        }
+        
+        // Sort and get unique values, take the smallest
+        spaceList = spaceList.stream()
+                .distinct()
+                .sorted()
+                .limit(1)
+                .collect(Collectors.toList());
+        
+        // If single header and space > 10, return 5
+        if (!spaceList.isEmpty() && spaceList.get(0) > 10) {
+            return 5f;
+        }
+        
+        return spaceList.isEmpty() ? 0f : (spaceList.get(0) + 0.43f);
+    }
+
+
+    public static List<HeaderCellData> calculateHeaderWidthBasedOnContent(List<HeaderCellData> headerCellDataList, List<TableRow> transactionRowList) {
+        for (TableRow tableRow : transactionRowList) {
+            for (int headerIndex = 0; headerIndex < headerCellDataList.size(); headerIndex++) {
+                HeaderCellData headerRow = headerCellDataList.get(headerIndex);
+                
+                for (WordData wordData : tableRow.getWordDataList()) {
+                    if ((headerRow.getStartPoint() <= wordData.getX1() && headerRow.getEndPoint() > wordData.getX1()) ||
+                        (headerRow.getEndPoint() >= wordData.getX2() && headerRow.getStartPoint() < wordData.getX2()) ||
+                        (headerRow.getStartPoint() > wordData.getX1() && headerRow.getEndPoint() < wordData.getX2())) {
+                        
+                        if (headerRow.getStartPoint() > wordData.getX1() && 
+                            (headerIndex == 0 || (headerIndex > 0 && wordData.getX1() > headerCellDataList.get(headerIndex - 1).getEndPoint()))) {
+                            headerRow.setStartPoint(wordData.getX1());
+                        }
+                        
+                        if (headerRow.getEndPoint() < wordData.getX2() && 
+                            ((headerIndex == headerCellDataList.size() - 1) || 
+                             ((headerIndex != headerCellDataList.size() - 1) && wordData.getX2() < headerCellDataList.get(headerIndex + 1).getStartPoint()))) {
+                            headerRow.setEndPoint(wordData.getX2());
+                        }
+                    }
+                }
+            }
+        }
+        return headerCellDataList;
+    }
+
+
+    public static JSONObject mergeDescriptionOfSameDate(List<HeaderCellData> headerCellDataList, List<TableCell> resultTableCellList, Integer pageNo) {
+        Map<Float, List<TableCell>> floatListTableCellRowWiseMap = resultTableCellList.stream()
+                .collect(Collectors.groupingBy(TableCell::getY));
+        
+        JSONArray array = new JSONArray();
+        List<TableCell> tempTableRow = new ArrayList<>();
+        boolean lastTransactionToArrayFlag = false;
+        Map<Integer, List<TableCell>> floatListTableCellColumnWiseMapForARow = new HashMap<>();
+        JSONObject result = new JSONObject();
+        
+        List<Float> sortedKeys = floatListTableCellRowWiseMap.keySet().stream()
+                .sorted()
+                .collect(Collectors.toList());
+        
+        for (int index = 0; index < sortedKeys.size(); index++) {
+            Float rowY = sortedKeys.get(index);
+            List<TableCell> rowCells = floatListTableCellRowWiseMap.get(rowY);
+            
+            String rowWord = rowCells.stream()
+                    .flatMap(cell -> cell.getContent().stream())
+                    .collect(Collectors.joining(" "))
+                    .replaceAll("(Cr)|(Dr)", "").trim();
+            
+            // Sort cells
+            rowCells.sort(Comparator.comparing(cell -> cell.getWordDataList().get(0).getActualY1()));
+            rowCells.sort(Comparator.comparing(TableCell::getColumnNumber));
+            
+            boolean isLastRow = (index == sortedKeys.size() - 1);
+            boolean hasDateInRow = rowCells.stream()
+                    .anyMatch(cell -> {
+                        String cellContent = String.join(" ", cell.getContent()).toLowerCase();
+                        return DATE_PATTERN.matcher(cellContent).find() ||
+                               (cell.getContent().size() > 0 && 
+                                DD_PATTERN.matcher(cell.getContent().get(0)).find() && 
+                                cell.getContent().get(0).length() <= 2 &&
+                                ((cell.getContent().size() > 1 && MMM_PATTERN.matcher(cell.getContent().get(1).toLowerCase()).find()) ||
+                                 (rowCells.size() > 1 && !rowCells.get(1).getContent().isEmpty() && 
+                                  MMM_PATTERN.matcher(rowCells.get(1).getContent().get(0).toLowerCase()).find())));
+                    });
+            
+            if (isLastRow || (index > 0 && hasDateInRow)) {
+                if (isLastRow && hasDateInRow) {
+                    lastTransactionToArrayFlag = true;
+                } else if (!COMPLETE_BALANCE_PATTERN.matcher(rowWord).find() && isLastRow && !hasDateInRow) {
+                    tempTableRow.addAll(rowCells);
+                }
+                
+                floatListTableCellColumnWiseMapForARow = tempTableRow.stream()
+                        .collect(Collectors.groupingBy(TableCell::getColumnNumber));
+                
+                JSONArray transactionArray = new JSONArray();
+                for (int i = 0; i < headerCellDataList.size(); i++) {
+                    JSONObject obj = new JSONObject();
+                    obj.put("name", headerCellDataList.get(i).getWordDataList().stream()
+                            .map(WordData::getWord)
+                            .collect(Collectors.joining(" ")));
+                    
+                    String value = "";
+                    if (floatListTableCellColumnWiseMapForARow.containsKey(i)) {
+                        value = floatListTableCellColumnWiseMapForARow.get(i).stream()
+                                .flatMap(cell -> cell.getWordDataList().stream())
+                                .map(WordData::getWord)
+                                .collect(Collectors.joining(" "));
+                    }
+                    obj.put("value", value);
+                    transactionArray.put(obj);
+                }
+                array.put(transactionArray);
+                floatListTableCellColumnWiseMapForARow.clear();
+                tempTableRow.clear();
+            }
+            
+            tempTableRow.addAll(rowCells);
+            
+            if (lastTransactionToArrayFlag) {
+                floatListTableCellColumnWiseMapForARow = tempTableRow.stream()
+                        .collect(Collectors.groupingBy(TableCell::getColumnNumber));
+                
+                JSONArray transactionArray = new JSONArray();
+                for (int i = 0; i < headerCellDataList.size(); i++) {
+                    JSONObject obj = new JSONObject();
+                    obj.put("name", headerCellDataList.get(i).getWordDataList().stream()
+                            .map(WordData::getWord)
+                            .collect(Collectors.joining(" ")));
+                    
+                    String value = "";
+                    if (floatListTableCellColumnWiseMapForARow.containsKey(i)) {
+                        value = floatListTableCellColumnWiseMapForARow.get(i).stream()
+                                .flatMap(cell -> cell.getWordDataList().stream())
+                                .map(WordData::getWord)
+                                .collect(Collectors.joining(" "));
+                    }
+                    obj.put("value", value);
+                    transactionArray.put(obj);
+                }
+                array.put(transactionArray);
+                lastTransactionToArrayFlag = false;
+            }
+        }
+        
+        result.put("page_no", pageNo);
+        result.put("data", array);
+        return result;
+    }
+
+    public static String createTableFromMappedData(List<HeaderCellData> headerCellDataList, List<TableCell> resultTableCellList, Integer pageIndex) throws IOException {
+        Map<Float, List<TableCell>> floatListTableCellRowWiseMap = resultTableCellList.stream()
+                .collect(Collectors.groupingBy(TableCell::getY));
+        
+        StringBuilder htmlCode = new StringBuilder("<table border='1'><tr>");
+        
+        // Create header row
+        for (HeaderCellData headerCellData : headerCellDataList) {
+            String word = headerCellData.getWordDataList().stream()
+                    .map(WordData::getWord)
+                    .collect(Collectors.joining(" "));
+            htmlCode.append("<td style='width:150px;'><b>").append(word.trim()).append("</b></td>");
+        }
+        htmlCode.append("</tr>");
+        
+        // Create data rows
+        List<Float> sortedKeys = floatListTableCellRowWiseMap.keySet().stream()
+                .sorted()
+                .collect(Collectors.toList());
+        
+        for (Float rowY : sortedKeys) {
+            htmlCode.append("<tr>");
+            List<TableCell> rowCellList = floatListTableCellRowWiseMap.get(rowY);
+            
+            // Sort cells
+            rowCellList.sort((a, b) -> {
+                if (Math.abs(a.getWordDataList().get(0).getActualY1() - b.getWordDataList().get(0).getActualY1()) <= 1.5f) {
+                    return Float.compare(a.getWordDataList().get(0).getX1(), b.getWordDataList().get(0).getX1());
+                } else {
+                    return Float.compare(a.getWordDataList().get(0).getActualY1(), b.getWordDataList().get(0).getActualY1());
+                }
+            });
+            
+            for (int i = 0; i < headerCellDataList.size(); i++) {
+                String word = "";
+                for (TableCell cell : rowCellList) {
+                    if (Objects.equals(cell.getColumnNumber(), i)) {
+                        word += " " + cell.getWordDataList().stream()
+                                .map(WordData::getWord)
+                                .collect(Collectors.joining(" "));
+                    }
+                }
+                htmlCode.append("<td style='width:150px;'>").append(word.trim()).append("</td>");
+            }
+            htmlCode.append("</tr>");
+        }
+        htmlCode.append("</table>");
+        // File htmlFile = new File("/Users/jatinvadodariya/Documents/pdfoutput/icici" + (pageIndex + 1) + ".html");
+        // FileUtils.writeStringToFile(htmlFile, htmlCode.toString());
+        
+        return htmlCode.toString();
+    }
+
+}
diff --git a/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/TrapRangeBuilder.java b/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/TrapRangeBuilder.java
