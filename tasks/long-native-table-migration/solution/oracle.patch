@@ -0,0 +1,159 @@
+package com.finboost.bank.statement.parser.tableextractor.config;
+
+/**
+ * Pre-configured table extraction settings for different banks
+ * 
+ * Each method returns a TableExtractorConfig optimized for that bank's
+ * statement format. These can be used as-is or customized further using
+ * the builder pattern.
+ * 
+ * Example usage:
+ * <pre>
+ * // Use HDFC configuration as-is
+ * DocumentExtractionResult result = PDFTableExtractor.extractTables(
+ *     file, password, BankTableConfigs.hdfc()
+ * );
+ * 
+ * // Customize HDFC configuration
+ * TableExtractorConfig customConfig = BankTableConfigs.hdfc().toBuilder()
+ *     .rowFilterTolerance(10.0)
+ *     .build();
+ * </pre>
+ */
+public class BankTableConfigs {
+    
+    /**
+     * HDFC Bank configuration
+     * - Hybrid extraction with detected columns
+     * - Strict row tolerance
+     * - Filters header/footer regions
+     * - Minimum 3 words per row for data quality
+     */
+    public static TableExtractorConfig hdfc() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .useDetectedRows(false)
+            .useDetectedColumns(true)
+            .rowFilterTolerance(0.0)
+            .boxLineTableRowAssignmentHandler(input -> {
+                return input.getRows().stream()
+                    .filter(row -> {
+                        if (row.getY() == null) return false;
+                        float rowBottomLeftY = input.getPageHeight() - row.getY();
+                        // Skip header/footer regions
+                        return rowBottomLeftY > 30 && rowBottomLeftY < input.getPageHeight() - 50;
+                    })
+                    .filter(row -> {
+                        // Ensure row is within table bounds
+                        float rowBottomLeftY = input.getPageHeight() - row.getY();
+                        return rowBottomLeftY >= input.getTable().getBottom() && 
+                               rowBottomLeftY <= input.getTable().getTop();
+                    })
+                    .filter(row -> 
+                        // Minimum words check
+                        row.getWordDataList() != null && 
+                        row.getWordDataList().size() >= 3
+                    )
+                    .toList();
+            })
+            .graphicsHorizontalLineHandler(input -> {
+                // Only use lines longer than 50 pixels
+                return input.getLines().stream()
+                    .filter(line -> line.getLength() > 50)
+                    .toList();
+            })
+            .build();
+    }
+    
+    /**
+     * ICICI Bank configuration
+     * - Hybrid extraction with detected rows and columns
+     * - More lenient tolerances
+     * - Different header/footer thresholds
+     */
+    public static TableExtractorConfig icici() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .useDetectedRows(true)  // ICICI benefits from row merging
+            .useDetectedColumns(true)
+            .rowFilterTolerance(10.0)
+            .build();
+    }
+    
+    /**
+     * SBI (State Bank of India) configuration
+     * - Text position based extraction (no clear grid lines)
+     * - Very lenient tolerances
+     * - Lower minimum word requirement
+     */
+    public static TableExtractorConfig sbi() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.TEXT_POSITION)
+            .build();
+    }
+    
+    /**
+     * Axis Bank configuration
+     * - Hybrid extraction
+     * - Standard tolerances
+     * - Grid line detection with column separators
+     */
+    public static TableExtractorConfig axis() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .useDetectedRows(false)
+            .useDetectedColumns(true)
+            .rowFilterTolerance(5.0)
+            .build();
+    }
+    
+    /**
+     * Kotak Mahindra Bank configuration
+     * - Pure grid line extraction
+     * - Kotak statements have very clear table borders
+     */
+    public static TableExtractorConfig kotak() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.GRID_LINE)
+            .enableLineReduction(true)
+            .build();
+    }
+    
+    /**
+     * Generic/Unknown bank configuration
+     * - Tries hybrid approach first
+     * - Balanced tolerances
+     * - Suitable for most bank statements
+     */
+    public static TableExtractorConfig generic() {
+        return TableExtractorConfig.defaultConfig();
+    }
+    
+    /**
+     * High-quality scanned PDF configuration
+     * - Lenient tolerances to handle scan quality variations
+     * - Grid line detection with relaxed thresholds
+     */
+    public static TableExtractorConfig scannedPdf() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .useDetectedRows(false)
+            .useDetectedColumns(true)
+            .rowFilterTolerance(15.0)
+            .build();
+    }
+    
+    /**
+     * Digital/Native PDF configuration
+     * - Strict tolerances for high-quality PDFs
+     * - Precise grid line detection
+     */
+    public static TableExtractorConfig digitalPdf() {
+        return TableExtractorConfig.builder()
+            .extractionStrategy(ExtractionStrategy.GRID_LINE)
+            .enableLineReduction(true)
+            .rowFilterTolerance(0.0)
+            .build();
+    }
+}
