+import java.util.List;
+
+/**
+ * Custom PDF text stripper to extract text positions from PDF
+ */
+public class CustomPDFTextStripper extends PDFTextStripper {
+
+    private List<TextPosition> textPositionList = new ArrayList<>();
+
+    public CustomPDFTextStripper() throws IOException {
+        super();
+    }
+
+    public CustomPDFTextStripper(List<TextPosition> textPositions) throws IOException {
+        super();
+        this.textPositionList = textPositions;
+    }
+
+    @Override
+    protected void writeString(String string, List<TextPosition> textPositions) throws IOException {
+        for (TextPosition text : textPositions) {
+            textPositionList.add(text);
+        }
+    }
+}
