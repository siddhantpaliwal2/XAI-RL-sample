index 0000000000000000000000000000000000000000..d1b583e4a5147f2750aa8e1e8103c0d4d2103ddf
--- /dev/null
+++ b/src/main/java/com/finboost/bank/statement/parser/tableextractor/config/TableExtractorConfig.java
@@ -0,0 +1,300 @@
+package com.finboost.bank.statement.parser.tableextractor.config;
+
+import com.finboost.bank.statement.parser.tableextractor.config.handler.*;
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.LineReductionConfig;
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.TableDetectionConfig;
+
+/**
+ * Comprehensive configuration for PDF table extraction
+ * 
+ * This configuration object controls all aspects of table detection and extraction:
+ * - Extraction strategy (grid lines, text position, or hybrid)
+ * - Line reduction settings
+ * - Table detection parameters
+ * - Custom filters (functional interfaces for flexible processing)
+ * - Tolerances and thresholds
+ * 
+ * Use the Builder pattern for easy, readable configuration:
+ * <pre>
+ * TableExtractorConfig config = TableExtractorConfig.builder()
+ *     .extractionStrategy(ExtractionStrategy.HYBRID)
+ *     .useDetectedRows(false)
+ *     .useDetectedColumns(true)
+ *     .tableRowFilter(input -> /* custom filter *\/)
+ *     .build();
+ * </pre>
+ */
+public class TableExtractorConfig {
+    
+    // ============================================
+    // Extraction Strategy
+    // ============================================
+    
+    private ExtractionStrategy extractionStrategy;
+    
+    // ============================================
+    // Hybrid Strategy Settings
+    // ============================================
+    
+    private boolean useDetectedRows;
+    private boolean useDetectedColumns;
+    
+    // ============================================
+    // Line Reduction Configuration
+    // ============================================
+    
+    private boolean enableLineReduction;
+    private LineReductionConfig lineReductionConfig;
+    
+    // ============================================
+    // Table Detection Configuration
+    // ============================================
+    
+    private TableDetectionConfig tableDetectionConfig;
+    
+    // ============================================
+    // Tolerance Settings
+    // ============================================
+    
+    private double rowFilterTolerance;
+    
+    // ============================================
+    // Functional Interface Handlers (Code Blocks)
+    // ============================================
+    
+    private BoxLineTableRowAssignmentHandler boxLineTableRowAssignmentHandler;
+    private GraphicsHorizontalLineHandler graphicsHorizontalLineHandler;
+    private GraphicsVerticalLineHandler graphicsVerticalLineHandler;
+    private BoxLineHeaderCellSelectorHandler boxLineHeaderCellSelectorHandler;
+    private GraphicsTableSelectorHandler graphicsTableSelectorHandler;
+    private SelectedRowsSelectionHandler selectedRowsSelectionHandler;
+    
+    // ============================================
+    // Private Constructor (use Builder)
+    // ============================================
+    
+    private TableExtractorConfig() {
+        // Set defaults
+        this.extractionStrategy = ExtractionStrategy.ML_BASED;
+        this.useDetectedRows = false;
+        this.useDetectedColumns = false;
+        this.enableLineReduction = true;
+        this.lineReductionConfig = LineReductionConfig.createTableDetectionConfig();
+        this.tableDetectionConfig = TableDetectionConfig.createStandardConfig();
+        this.rowFilterTolerance = 0.0;
+        this.boxLineTableRowAssignmentHandler = null;
+        this.graphicsHorizontalLineHandler = null;
+        this.graphicsVerticalLineHandler = null;
+        this.boxLineHeaderCellSelectorHandler = null;
+        this.graphicsTableSelectorHandler = null;
+        this.selectedRowsSelectionHandler = null;
+    }
+    
+    // ============================================
+    // Builder Pattern
+    // ============================================
+    
+    public static class Builder {
+        private final TableExtractorConfig config = new TableExtractorConfig();
+        
+        public Builder extractionStrategy(ExtractionStrategy strategy) {
+            config.extractionStrategy = strategy;
+            return this;
+        }
+        
+        public Builder useDetectedRows(boolean value) {
+            config.useDetectedRows = value;
+            return this;
+        }
+        
+        public Builder useDetectedColumns(boolean value) {
+            config.useDetectedColumns = value;
+            return this;
+        }
+        
+        public Builder enableLineReduction(boolean value) {
+            config.enableLineReduction = value;
+            return this;
+        }
+        
+        public Builder lineReductionConfig(LineReductionConfig lineConfig) {
+            config.lineReductionConfig = lineConfig;
+            return this;
+        }
+        
+        public Builder tableDetectionConfig(TableDetectionConfig detectionConfig) {
+            config.tableDetectionConfig = detectionConfig;
+            return this;
+        }
+        
+        public Builder rowFilterTolerance(double tolerance) {
+            config.rowFilterTolerance = tolerance;
+            return this;
+        }
+        
+        public Builder boxLineTableRowAssignmentHandler(BoxLineTableRowAssignmentHandler handler) {
+            config.boxLineTableRowAssignmentHandler = handler;
+            return this;
+        }
+        
+        public Builder graphicsHorizontalLineHandler(GraphicsHorizontalLineHandler handler) {
+            config.graphicsHorizontalLineHandler = handler;
+            return this;
+        }
+        
+        public Builder graphicsVerticalLineHandler(GraphicsVerticalLineHandler handler) {
+            config.graphicsVerticalLineHandler = handler;
+            return this;
+        }
+        
+        public Builder boxLineHeaderCellSelectorHandler(BoxLineHeaderCellSelectorHandler handler) {
+            config.boxLineHeaderCellSelectorHandler = handler;
+            return this;
+        }
+        
+        public Builder graphicsTableSelectorHandler(GraphicsTableSelectorHandler handler) {
+            config.graphicsTableSelectorHandler = handler;
+            return this;
+        }
+
+        public Builder selectedRowsSelectionHandler(SelectedRowsSelectionHandler handler) {
+            config.selectedRowsSelectionHandler = handler;
+            return this;
+        }
+        
+        public TableExtractorConfig build() {
+            validate();
+            return config;
+        }
+        
+        private void validate() {
+            if (config.rowFilterTolerance < 0) {
+                throw new IllegalArgumentException("rowFilterTolerance must be >= 0");
+            }
+        }
+    }
+    
+    public static Builder builder() {
+        return new Builder();
+    }
+    
+    // ============================================
+    // Getters (Immutable after build)
+    // ============================================
+    
+    public ExtractionStrategy getExtractionStrategy() {
+        return extractionStrategy;
+    }
+    
+    public boolean isUseDetectedRows() {
+        return useDetectedRows;
+    }
+    
+    public boolean isUseDetectedColumns() {
+        return useDetectedColumns;
+    }
+    
+    public boolean isEnableLineReduction() {
+        return enableLineReduction;
+    }
+    
+    public LineReductionConfig getLineReductionConfig() {
+        return lineReductionConfig;
+    }
+    
+    public TableDetectionConfig getTableDetectionConfig() {
+        return tableDetectionConfig;
+    }
+    
+    public double getRowFilterTolerance() {
+        return rowFilterTolerance;
+    }
+    
+    public BoxLineTableRowAssignmentHandler getBoxLineTableRowAssignmentHandler() {
+        return boxLineTableRowAssignmentHandler;
+    }
+    
+    public GraphicsHorizontalLineHandler getGraphicsHorizontalLineHandler() {
+        return graphicsHorizontalLineHandler;
+    }
+    
+    public GraphicsVerticalLineHandler getGraphicsVerticalLineHandler() {
+        return graphicsVerticalLineHandler;
+    }
+    
+    public BoxLineHeaderCellSelectorHandler getBoxLineHeaderCellSelectorHandler() {
+        return boxLineHeaderCellSelectorHandler;
+    }
+
+    public GraphicsTableSelectorHandler getGraphicsTableSelectorHandler() {
+        return graphicsTableSelectorHandler;
+    }
+
+    public SelectedRowsSelectionHandler getSelectedRowsSelectionHandler() {
+        return selectedRowsSelectionHandler;
+    }
+
+    // ============================================
+    // Pre-configured Profiles
+    // ============================================
+    
+    /**
+     * Default configuration - works for most bank statements
+     */
+    public static TableExtractorConfig defaultConfig() {
+        return builder().build();
+    }
+    
+    /**
+     * Grid line only extraction - for PDFs with clear table borders
+     */
+    public static TableExtractorConfig gridLineOnly() {
+        return builder()
+            .extractionStrategy(ExtractionStrategy.GRID_LINE)
+            .enableLineReduction(true)
+            .build();
+    }
+    
+    /**
+     * Text position only extraction - for PDFs without visible borders
+     */
+    public static TableExtractorConfig textPositionOnly() {
+        return builder()
+            .extractionStrategy(ExtractionStrategy.TEXT_POSITION)
+            .build();
+    }
+    
+    /**
+     * Strict configuration - tight tolerances, precise matching
+     */
+    public static TableExtractorConfig strict() {
+        return builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .rowFilterTolerance(0.0)
+            .tableDetectionConfig(TableDetectionConfig.createStrictConfig())
+            .build();
+    }
+    
+    /**
+     * Lenient configuration - larger tolerances, more forgiving
+     */
+    public static TableExtractorConfig lenient() {
+        return builder()
+            .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+            .rowFilterTolerance(10.0)
+            .tableDetectionConfig(TableDetectionConfig.createLenientConfig())
+            .build();
+    }
+    
+    @Override
+    public String toString() {
+        return "TableExtractorConfig{" +
+                "strategy=" + extractionStrategy +
+                ", useDetectedRows=" + useDetectedRows +
+                ", useDetectedColumns=" + useDetectedColumns +
+                ", enableLineReduction=" + enableLineReduction +
+                ", rowFilterTolerance=" + rowFilterTolerance +
+                '}';
+    }
+}
