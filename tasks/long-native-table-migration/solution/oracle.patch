+    /**
+     * Create HeaderCellData list from detected column separators
+     */
+    private static List<HeaderCellData> createHeaderCellsFromDetectedColumns(
+            TableStructure detectedTable) {
+        
+        List<HeaderCellData> headerCells = new ArrayList<>();
+        
+        // Get detected column separator X coordinates
+        List<Double> columnSeparatorX = detectedTable.getColumnSeparatorX();
+        if (columnSeparatorX == null || columnSeparatorX.size() < 2) {
+            return headerCells;
+        }
+        
+        // Sort column separators
+        List<Double> sortedColumnSeparators = new ArrayList<>(columnSeparatorX);
+        sortedColumnSeparators.sort(Double::compareTo);
+        
+        // Create HeaderCellData for each column region (between consecutive separators)
+        for (int i = 0; i < sortedColumnSeparators.size() - 1; i++) {
+            double columnLeft = sortedColumnSeparators.get(i);
+            double columnRight = sortedColumnSeparators.get(i + 1);
+            
+            HeaderCellData headerCell = new HeaderCellData();
+            headerCell.setStartPoint((float) columnLeft);
+            headerCell.setEndPoint((float) columnRight);
+            headerCell.setPeakStartPoint((float) columnLeft);
+            headerCell.setPeakEndPoint((float) columnRight);
+            headerCell.setColumnNumber(i);
+            
+            // Set default header text (can be populated later from actual text)
+            headerCell.setWordDataList(new ArrayList<>());
+            
+            headerCells.add(headerCell);
+        }
+        
+        return headerCells;
+    }
