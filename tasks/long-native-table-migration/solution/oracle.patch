--- /dev/null
+++ b/src/main/java/com/finboost/bank/statement/parser/tableextractor/util/TrapRangeBuilder.java
@@ -0,0 +1,127 @@
+package com.finboost.bank.statement.parser.tableextractor.util;
+
+import java.util.*;
+
+/**
+ * Utility class to build trap ranges for column detection
+ * Inspired by TrapRange library for detecting columns in tables without headers
+ */
+public class TrapRangeBuilder {
+
+    private final List<Range> ranges = new ArrayList<>();
+
+    /**
+     * Add a range to the builder
+     */
+    public TrapRangeBuilder addRange(Range range) {
+        ranges.add(range);
+        return this;
+    }
+
+    /**
+     * Build and merge overlapping/connected ranges
+     * The result will be ordered by lowerBound ASC
+     * 
+     * @return List of merged ranges
+     */
+    public List<Range> build() {
+        if (ranges.isEmpty()) {
+            return new ArrayList<>();
+        }
+
+        List<Range> result = new ArrayList<>();
+        
+        // Sort ranges by lower bound
+        Collections.sort(ranges, new Comparator<Range>() {
+            @Override
+            public int compare(Range o1, Range o2) {
+                return Float.compare(o1.getLowerBound(), o2.getLowerBound());
+            }
+        });
+
+        for (Range range : ranges) {
+            if (result.isEmpty()) {
+                result.add(range);
+            } else {
+                Range lastRange = result.get(result.size() - 1);
+                if (lastRange.isConnected(range)) {
+                    // Merge ranges by spanning them
+                    Range newLastRange = lastRange.span(range);
+                    result.set(result.size() - 1, newLastRange);
+                } else {
+                    result.add(range);
+                }
+            }
+        }
+
+        return result;
+    }
+
+    /**
+     * Represents a numeric range [lowerBound, upperBound]
+     */
+    public static class Range {
+        private final float lowerBound;
+        private final float upperBound;
+
+        public Range(float lowerBound, float upperBound) {
+            if (lowerBound > upperBound) {
+                throw new IllegalArgumentException("Lower bound cannot be greater than upper bound");
+            }
+            this.lowerBound = lowerBound;
+            this.upperBound = upperBound;
+        }
+
+        public float getLowerBound() {
+            return lowerBound;
+        }
+
+        public float getUpperBound() {
+            return upperBound;
+        }
+
+        /**
+         * Check if this range is connected to another range
+         * Ranges are connected if they overlap or touch
+         */
+        public boolean isConnected(Range other) {
+            return !(this.upperBound < other.lowerBound || other.upperBound < this.lowerBound);
+        }
+
+        /**
+         * Create a new range that spans both this range and another
+         */
