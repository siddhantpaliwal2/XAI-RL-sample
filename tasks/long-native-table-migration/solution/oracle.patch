+package com.finboost.bank.statement.parser.tableextractor.graphics.model;
+
+import java.awt.geom.Point2D;
+import java.awt.geom.Rectangle2D;
+
+/**
+ * Structure representing a single cell within a table
+ */
+public class CellStructure {
+    private Rectangle2D.Double bounds;
+    private int row;
+    private int column;
+    private String content;
+    private double confidence;
+    
+    public CellStructure(Rectangle2D.Double bounds, int row, int column) {
+        this.bounds = bounds;
+        this.row = row;
+        this.column = column;
+        this.content = "";
+        this.confidence = 1.0;
+    }
+    
+    // Getters and setters
+    public Rectangle2D.Double getBounds() { return bounds; }
+    public void setBounds(Rectangle2D.Double bounds) { this.bounds = bounds; }
+    
+    public int getRow() { return row; }
+    public void setRow(int row) { this.row = row; }
+    
+    public int getColumn() { return column; }
+    public void setColumn(int column) { this.column = column; }
+    
+    public String getContent() { return content; }
+    public void setContent(String content) { this.content = content; }
+    
+    public double getConfidence() { return confidence; }
+    public void setConfidence(double confidence) { this.confidence = confidence; }
+    
+    // Convenience methods
+    // Note: PDFBox uses bottom-left coordinate system (Y increases upward)
+    // So "top" = larger Y value, "bottom" = smaller Y value
+    public double getLeft() { return bounds.getMinX(); }
+    public double getRight() { return bounds.getMaxX(); }
+    public double getTop() { return bounds.getMaxY(); }  // Top = larger Y in bottom-left system
+    public double getBottom() { return bounds.getMinY(); }  // Bottom = smaller Y in bottom-left system
+    public double getWidth() { return bounds.getWidth(); }
+    public double getHeight() { return bounds.getHeight(); }
+    public Point2D.Double getCenter() { 
+        return new Point2D.Double(bounds.getCenterX(), bounds.getCenterY()); 
+    }
+    
+    @Override
+    public String toString() {
+        return String.format("Cell[%d,%d](%.1f,%.1f %.1fx%.1f)", 
+                row, column, getLeft(), getTop(), getWidth(), getHeight());
+    }
+}
+
