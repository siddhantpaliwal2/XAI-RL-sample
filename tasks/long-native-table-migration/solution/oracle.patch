+    /**
+     * Identifies the format of a PDF file based on bank-specific logic.
+     * Uses switch case for bank-specific pattern matching.
+     * Returns a list of all matching formats.
+     */
+    private static List<String> identifyFormatForBank(File pdfFile, String bankName) throws IOException {
+        // Extract text from PDF
+        String fileContent = PdfTextExtractionUtil.convertPDFToTextByPositionOrder(pdfFile);
+        
+        // Bank-specific format identification using switch case
+        switch (bankName.toUpperCase()) {
+            case "HDFC":
+                return identifyHDFCFormat(fileContent);
+             case "AXIS":
+                 return identifyAXISFormat(fileContent);
+             case "ICICI":
+                 return identifyICICIFormat(fileContent);
+            case "SBI":
+                return identifySBIFormat(fileContent);
+            case "KOTAK":
+                return identifyKOTAKFormat(fileContent);
+            case "BOB":
+                return identifyBOBFormat(fileContent);
+            case "CANARA":
+                return identifyCANARAFormat(fileContent);
+            default:
+                return identifyGenericFormat(fileContent);
+        }
+    }
