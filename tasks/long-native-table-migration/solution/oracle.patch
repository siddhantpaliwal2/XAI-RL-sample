+    public static List<TableRow> addLastTransactionRecord(List<TableCell> mappedTableCellList, List<TableRow> pageRowList, List<HeaderCellData> headerCellDataList) {
+        List<TableRow> lastTableRowList = new ArrayList<>();
+        try {
+            Map<Float, List<TableCell>> mappedTableCellMap = mappedTableCellList.stream()
+                    .collect(Collectors.groupingBy(
+                            TableCell::getY,
+                            TreeMap::new,
+                            Collectors.toList()
+                    ));
+            
+            if (mappedTableCellMap.isEmpty()) {
+                return lastTableRowList;
+            }
+            
+//            List<TableCell> lastRowTable = mappedTableCellMap.values().stream()
+//                    .reduce((first, second) -> second)
+//                    .orElse(new ArrayList<>());
+            List<TableCell> lastRowTable = mappedTableCellMap.isEmpty() ?
+                    new ArrayList<>() :
+                    ((TreeMap<Float, List<TableCell>>) mappedTableCellMap).lastEntry().getValue();
+            
+            String lastRowContent = lastRowTable.stream()
+                    .flatMap(cell -> cell.getContent().stream())
+                    .collect(Collectors.joining(" "));
+            
+            TableRow tableRow = pageRowList.stream()
+                    .filter(row -> row.getContent().equals(lastRowContent))
+                    .reduce((first, second) -> second)
+                    .orElse(null);
+            
+            List<Float> heightList = new ArrayList<>(mappedTableCellMap.keySet());
+            heightList.sort(Float::compareTo);
+            
+            if (heightList.size() == 1) {
+                // In case only single transaction is present in single page with date and have below date description
+                Float tempNextRowHeight = heightList.get(0) + 12;
+                heightList.add(tempNextRowHeight);
+            }
+            
+            if (tableRow == null || heightList.size() <= 1) {
+                return lastTableRowList;
+            }
+            
+            List<TableCell> prevTableTableCell = mappedTableCellMap.get(heightList.get(heightList.size() - 2));
+            
+            Float verticalDiff = tableRow.getWordDataList().stream()
+                    .max(Comparator.comparing(WordData::getActualY1))
+                    .map(WordData::getActualY1)
+                    .orElse(0f) - prevTableTableCell.get(0).getY();
+            
+            List<TableRow> remainingTableRow = pageRowList.stream()
+                    .filter(row -> row.getY() > tableRow.getY())
+                    .collect(Collectors.toList());
+            
+            Float prevY = tableRow.getY();
+            Integer maxHeaderWidthIndex = 0;
+            
+            // Find header with maximum width
+            List<HeaderCellData> headerCellDataListCopy = new ArrayList<>(headerCellDataList);
+            headerCellDataListCopy.sort(Comparator.comparing(hcd -> hcd.getEndPoint() - hcd.getStartPoint()));
+            
+            if (!headerCellDataListCopy.isEmpty()) {
+                maxHeaderWidthIndex = headerCellDataListCopy.get(headerCellDataListCopy.size() - 1).getColumnNumber();
+            }
+            
+            final Integer[] secondHighestMaxHeaderWidthIndexRef = {0};
+            List<TableCell> copyMappedTableCellList = new ArrayList<>(mappedTableCellList);
+            
+            // Remove duplicates by column number
+            Map<Integer, TableCell> uniqueCells = new HashMap<>();
+            for (TableCell cell : copyMappedTableCellList) {
+                uniqueCells.put(cell.getColumnNumber(), cell);
+            }
+            copyMappedTableCellList = new ArrayList<>(uniqueCells.values());
+            
+            // Find second highest max header width index
+            outerloop:
+            for (int i = headerCellDataListCopy.size() - 2; i > 0; i--) {
+                for (TableCell tableCell : copyMappedTableCellList) {
+                    String cellContent = String.join(" ", tableCell.getContent());
+                    if (Objects.equals(tableCell.getColumnNumber(), headerCellDataListCopy.get(i).getColumnNumber()) && 
+                        cellContent.matches(".*([A-z])|(/)|(^-$).*")) {
+                        secondHighestMaxHeaderWidthIndexRef[0] = headerCellDataListCopy.get(i).getColumnNumber();
+                        break outerloop;
+                    }
+                }
+            }
+            
+            List<WordData> unWantedDataWordDataList = new ArrayList<>();
+            
+            for (TableRow remainingRow : remainingTableRow) {
+                List<WordData> dataWordDataList = new ArrayList<>();
+                boolean maxHeaderWidthFlag = true;
+                
+                // Process each header cell data
+                for (int index = 0; index < headerCellDataList.size(); index++) {
+                    HeaderCellData headerCellData = headerCellDataList.get(index);
+                    
+                    if (index == 0) {
+                        dataWordDataList.addAll(remainingRow.getWordDataList().stream()
+                                .filter(wd -> wd.getX1() < headerCellData.getStartPoint())
+                                .collect(Collectors.toList()));
+                    } else if (index > 0 && index < headerCellDataList.size() - 1) {
+                        HeaderCellData prevHeader = headerCellDataList.get(index - 1);
+                        HeaderCellData nextHeader = headerCellDataList.get(index + 1);
+                        
+                        dataWordDataList.addAll(remainingRow.getWordDataList().stream()
+                                .filter(wd -> {
+                                    boolean condition1 = (wd.getX2() < prevHeader.getEndPoint() && wd.getX2() > headerCellData.getStartPoint());
+                                    boolean condition2 = (wd.getX1() > prevHeader.getEndPoint() && wd.getX1() < headerCellData.getStartPoint());
+                                    boolean condition3 = (wd.getX1() < prevHeader.getEndPoint() && wd.getX2() > headerCellData.getStartPoint());
+                                    boolean condition4 = (Math.floor(wd.getX2()) > headerCellData.getEndPoint() && 
+                                                         Math.floor(wd.getX2()) < nextHeader.getStartPoint());
+                                    boolean condition5 = (wd.getX1() < headerCellData.getEndPoint() && wd.getX2() > nextHeader.getStartPoint());
+                                    
+                                    return condition1 || condition2 || condition3 || condition4 || condition5;
+                                })
+                                .collect(Collectors.toList()));
+                    } else if (index == headerCellDataList.size() - 1) {
+                        dataWordDataList.addAll(remainingRow.getWordDataList().stream()
+                                .filter(wd -> Math.floor(wd.getX2()) > Math.ceil(headerCellData.getEndPoint()))
+                                .collect(Collectors.toList()));
+                    }
+                }
+                
+                // Check max header width conditions
+                if (maxHeaderWidthIndex != 0 && !dataWordDataList.isEmpty() && maxHeaderWidthIndex != (headerCellDataList.size() - 1)) {
+                    for (WordData wordData : dataWordDataList) {
+                        if (headerCellDataList.get(maxHeaderWidthIndex - 1).getEndPoint() > wordData.getX1() || 
+                            headerCellDataList.get(maxHeaderWidthIndex + 1).getStartPoint() < wordData.getX2()) {
+                            maxHeaderWidthFlag = false;
+                            unWantedDataWordDataList.add(wordData);
+                        }
+                    }
+                    
+                    for (WordData wordData : unWantedDataWordDataList) {
+                        if (wordData.getWord().matches("(^(-?[0-9,]*\\.[0-9]{0,2})(Cr|Dr|CR|DR|dr|cr|-)?$)|(^-$)|(^[0-9]{6}$)")) {
+                            maxHeaderWidthFlag = true;
+                        } else {
+                            maxHeaderWidthFlag = false;
+                            break;
+                        }
+                    }
+                    dataWordDataList.clear();
+                } else if (dataWordDataList.isEmpty() && 
+                          Objects.equals(remainingRow.getY(), remainingTableRow.get(remainingTableRow.size() - 1).getY()) && 
+                          remainingRow.getContent().toLowerCase().matches(".*(page)|(total).*")) {
+                    maxHeaderWidthFlag = false;
+                }
+                
+                if (maxHeaderWidthFlag) {
+                    unWantedDataWordDataList.clear();
+                }
+                
+                CopyOnWriteArrayList<WordData> copyOnWriteUnWantedDataArrayList = new CopyOnWriteArrayList<>(unWantedDataWordDataList);
+                
+                // Check second highest max header width conditions
+                if (!maxHeaderWidthFlag && secondHighestMaxHeaderWidthIndexRef[0] != 0 && dataWordDataList.isEmpty() && 
+                    secondHighestMaxHeaderWidthIndexRef[0] != (headerCellDataList.size() - 1)) {
+                    maxHeaderWidthFlag = true;
+                    
+                    copyOnWriteUnWantedDataArrayList.removeIf(wordData -> 
+                        headerCellDataList.get(secondHighestMaxHeaderWidthIndexRef[0] - 1).getEndPoint() < wordData.getX1() && 
+                        headerCellDataList.get(secondHighestMaxHeaderWidthIndexRef[0] + 1).getStartPoint() > wordData.getX2());
+                    
+                    if (!copyOnWriteUnWantedDataArrayList.isEmpty()) {
+                        maxHeaderWidthFlag = false;
+                    }
+                    dataWordDataList.clear();
+                }
+                
+                if (verticalDiff < 3f) {
+                    verticalDiff = 14f;
+                    maxHeaderWidthFlag = true;
+                }
+                
+                // Final condition check
+                boolean yearPattern = remainingRow.getContent().matches("^[\\s]*(20)[0-9]{2}[\\s].*");
+                boolean verticalCondition = Math.floor(remainingRow.getActualY() - prevY) <= Math.ceil(verticalDiff + 3);
+                boolean totalPattern = !remainingRow.getContent().toLowerCase().contains("total");
+                
+                if ((verticalCondition && maxHeaderWidthFlag && dataWordDataList.isEmpty() && totalPattern) || yearPattern) {
+                    lastTableRowList.add(remainingRow);
+                    prevY = remainingRow.getWordDataList().stream()
+                            .max(Comparator.comparing(WordData::getActualY1))
+                            .map(WordData::getActualY1)
+                            .orElse(prevY);
+                } else {
+                    break;
+                }
+            }
+            
+        } catch (Exception e) {
+            System.out.println("Exception occurred while fetching the last transaction record ====>>>>>>    " + e.getMessage());
+        }
+        return lastTableRowList;
+    }
+}
