+
+    public static List<TableRow> fetchRowData(List<WordData> wordDataList) {
+        List<TableRow> tableRowList = new ArrayList<>();
+        List<WordData> tempWordDataList = new ArrayList<>();
+        int wordDataCount = 0;
+        
+        if (wordDataList.isEmpty()) {
+            return tableRowList;
+        }
+        
+        // Sort by actualY1 and pageIndex
+        wordDataList.sort(Comparator.comparing(WordData::getActualY1));
+        wordDataList.sort(Comparator.comparing(WordData::getPageIndex));
+        
+        Float tempY1 = wordDataList.get(0).getY1();
+        Float tempY2 = wordDataList.get(0).getY1() + wordDataList.get(0).getHeight();
+        Float copyTempY1 = tempY1;
+        Integer tempPageIndex = wordDataList.get(0).getPageIndex();
+        
+        if (wordDataList.get(0).getHeight() < 2.5) {
+            SPACE_THRESHOLD_VERTICAL = 1.7f;
+        }
