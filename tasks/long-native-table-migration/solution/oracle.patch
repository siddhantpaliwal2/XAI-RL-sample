+                cell.setY4(y2);
+                
+                // Assign words that fall within this cell
+                List<Word> cellWords = new ArrayList<>();
+                if (matchingTableRow != null && matchingTableRow.getWordDataList() != null) {
+                    int wordIndex = 0;
+                    for (WordData wordData : matchingTableRow.getWordDataList()) {
+                        // Check if word falls within column range
+                        float wordCenterX = (wordData.getX1() + wordData.getX2()) / 2.0f;
+                        if (columnRange.contains(wordCenterX)) {
+                            Word word = convertWordDataToWord(wordData, wordIndex++, pageIndex);
+                            cellWords.add(word);
+                        }
+                    }
+                }
+                
+                cell.setWords(cellWords);
+                
+                // Mark first row as header
+                if (rowIdx == 0) {
+                    cell.setHeaderOrFooterCell(true);
+                }
+                
+                cellRow.put(colIdx, cell);
+            }
+            
+            cells.put(rowIdx, cellRow);
+        }
+        
+        table.setCells(cells);
+        
+        // Calculate table boundaries from TableRows
+        if (!tableRows.isEmpty()) {
+            float minX = Float.MAX_VALUE;
+            float maxX = Float.MIN_VALUE;
+            float minY = Float.MAX_VALUE;
+            float maxY = Float.MIN_VALUE;
+            
+            for (TableRow row : tableRows) {
+                if (row.getWordDataList() != null && !row.getWordDataList().isEmpty()) {
+                    for (WordData word : row.getWordDataList()) {
+                        if (word.getX1() < minX) minX = word.getX1();
+                        if (word.getX2() > maxX) maxX = word.getX2();
+                        if (word.getY1() < minY) minY = word.getY1();
+                        float wordBottomY = word.getY1() + word.getHeight();
+                        if (wordBottomY > maxY) maxY = wordBottomY;
+                    }
+                }
+            }
+            
+            table.setX1(minX);
+            table.setY1(minY);
+            table.setX2(maxX);
+            table.setY2(minY);
+            table.setX3(maxX);
+            table.setY3(maxY);
+            table.setX4(minX);
+            table.setY4(maxY);
+        }
+        
+        return table;
+    }
+
+    /**
+     * Map TableRows to Table using HeaderCellData for column structure
+     * 
+     * @param tableRows List of TableRow objects (data rows, excluding header)
+     * @param headerCellDataList List of HeaderCellData defining columns
+     * @param pageIndex Zero-based page index
+     * @return Table object with properly structured cells
+     */
+    public static Page mapByTableRow(
+            List<TableRow> tableRows,
+            List<HeaderCellData> headerCellDataList,
+            Integer pageIndex) {
+        
+        if (tableRows == null || tableRows.isEmpty()) {
+            return createEmptyTablePage(pageIndex);
+        }
+        
+        // Step 1: Create a TableRow from headerCellDataList
+        TableRow headerRow = createHeaderTableRow(headerCellDataList, tableRows);
+        
+        // Step 2: Prefix header row to tableRows at position 0
+        List<TableRow> allRows = new ArrayList<>();
+        allRows.add(headerRow);
+        allRows.addAll(tableRows);
+        
+        // Step 3: Create column ranges from headerCellDataList using peakStartPoint and peakEndPoint
+        List<Range<Float>> columnRanges = createColumnRanges(headerCellDataList);
+        
+        // Step 4: Create row ranges from tableRows using Y positions
+        List<Range<Float>> rowRanges = createRowRanges(allRows);
+        
+        // Step 5: Call createTable to form the Table
+        Table table = createTable(allRows, columnRanges, rowRanges, pageIndex);
+
+        Page page = new Page();
+        page.setPageNumber(pageIndex + 1); // Page numbers are 1-based
+
+        // Create a single table for this page (table 0)
+        Map<Integer, Table> tables = new HashMap<>();
+        tables.put(0, table);
+
+        page.setTables(tables);
+
+        // Build Word list from transaction rows
+        List<Word> words = buildWords(allRows, (pageIndex+1));
+        page.setWords(words);
+
+        return page;
+    }
+
+    /**
+     * Map TableRows to Table using HeaderCellData for column structure
+     *
+     * @param tableRows List of TableRow objects (data rows, excluding header)
+     * @param headerCellDataList List of HeaderCellData defining columns
+     * @param pageIndex Zero-based page index
+     * @return Table object with properly structured cells
+     */
+    public static Page mapByTableRow(
+            Map<Integer,List<TableRow>> tableRows,
+            List<HeaderCellData> headerCellDataList,
+            Integer pageIndex) {
+
+        if (tableRows == null || tableRows.isEmpty()) {
+            return createEmptyTablePage(pageIndex);
+        }
+
+        Map<Integer, Table> tables = new LinkedHashMap<>();
+        List<TableRow> allPageRows = new ArrayList<>();
+        for (Map.Entry<Integer, List<TableRow>> entry : tableRows.entrySet()) {
+            // Step 1: Create a TableRow from headerCellDataList
+            TableRow headerRow = createHeaderTableRow(headerCellDataList, entry.getValue());
+
+            // Step 2: Prefix header row to tableRows at position 0
+            List<TableRow> allRows = new ArrayList<>();
+            allRows.add(headerRow);
+            allRows.addAll(entry.getValue());
+            allPageRows.addAll(allRows);
+
+            // Step 3: Create column ranges from headerCellDataList using peakStartPoint and peakEndPoint
+            List<Range<Float>> columnRanges = createColumnRanges(headerCellDataList);
+
+            // Step 4: Create row ranges from tableRows using Y positions
+            List<Range<Float>> rowRanges = createRowRanges(allRows);
+
+            // Step 5: Call createTable to form the Table
+            Table table = createTable(allRows, columnRanges, rowRanges, pageIndex);
+            tables.put(entry.getKey(), table);
+        }
+
+
+
+        Page page = new Page();
+        page.setPageNumber(pageIndex + 1); // Page numbers are 1-based
+
+        page.setTables(tables);
+
+        // Build Word list from transaction rows
+        List<Word> words = buildWords(allPageRows, (pageIndex+1));
+        page.setWords(words);
+
+        return page;
+    }
+
+    /**
+     * Build Word list from transaction rows
+     */
+    private static List<Word> buildWords(List<TableRow> transactionRowList, Integer pageIndex) {
+        List<Word> words = new ArrayList<>();
+        int wordIndex = 0;
+
+        for (TableRow row : transactionRowList) {
+            if (row.getWordDataList() != null) {
+                for (WordData wd : row.getWordDataList()) {
+                    Word word = convertWordDataToWord(wd, wordIndex++, pageIndex);
+                    words.add(word);
+                }
+            }
+        }
+
+        return words;
+    }
+
+    /**
+     * Build Page object from grid-line detected tables
+     * (Moved from PDFTableExtractor)
+     * 
+     * @param pageIndex Zero-based page index
+     * @param detectedTables List of tables detected using grid lines
+     * @param pageWords List of words on this page (in TOP-LEFT coordinates)
+     * @param pageHeight Page height for coordinate conversion
+     * @return Page object containing table data
+     */
+    public static Page buildPageFromGridLines(
+            Integer pageIndex,
+            List<TableStructure> detectedTables,
+            List<WordData> pageWords,
+            float pageHeight) {
+        
+        Page page = new Page();
+        page.setPageNumber(pageIndex + 1); // Page numbers are 1-based
+        
+        // Convert detected tables to Table objects
+        Map<Integer, Table> tables = new HashMap<>();
+        
+        for (int tableIdx = 0; tableIdx < detectedTables.size(); tableIdx++) {
+            TableStructure detectedTable = detectedTables.get(tableIdx);
+            
+            Table table = buildTableFromGridStructure(pageIndex + 1, detectedTable, pageWords, pageHeight);
+            tables.put(tableIdx, table);
+        }
+        
+        page.setTables(tables);
+        
+        // Build Word list from all page words
+        List<Word> words = pageWords != null ? buildWordsFromWordData(pageWords) : new ArrayList<>();
+        page.setWords(words);
+        
+        return page;
+    }
+
+    // ==================== Private Helper Methods ====================
+
+    /**
+     * Create header TableRow from HeaderCellData list
+     */
+    private static TableRow createHeaderTableRow(
+            List<HeaderCellData> headerCellDataList,
+            List<TableRow> tableRows) {
+        
+        TableRow headerRow = new TableRow();
+        
+        // Set page index from first data row
+        if (!tableRows.isEmpty()) {
+            headerRow.setPageIndex(tableRows.get(0).getPageIndex());
+        }
+        
+        // Calculate Y position: lowest Y from tableRows - largest word height
+        float lowestY = Float.MAX_VALUE;
+        float largestHeight = 0f;
+
+        tableRows.sort(Comparator.comparingDouble(TableRow::getY));
+        
+        TableRow lowestRow = tableRows.get(0);
+        lowestY = lowestRow.getY();
+
+        for(WordData wordData : lowestRow.getWordDataList()) {
+            if(wordData.getHeight() > largestHeight) {
+                largestHeight = wordData.getHeight();
+            }
+        }
+        
+        float headerY = lowestY - largestHeight;
+        headerRow.setY(headerY);
+        
+        // Collect all words from all HeaderCellData
+        List<WordData> headerWords = new ArrayList<>();
+        if (headerCellDataList != null) {
+            for (HeaderCellData headerCell : headerCellDataList) {
+                if (headerCell.getWordDataList() != null) {
+                    headerWords.addAll(headerCell.getWordDataList());
+                }
+            }
+        }
+        
+        // Sort header words by X position
+        headerWords.sort(Comparator.comparing(WordData::getX1));
+        headerRow.setWordDataList(headerWords);
+        
+        return headerRow;
+    }
+
+    /**
+     * Create column ranges from HeaderCellData using peakStartPoint and peakEndPoint
+     */
+    private static List<Range<Float>> createColumnRanges(List<HeaderCellData> headerCellDataList) {
+        List<Range<Float>> columnRanges = new ArrayList<>();
+        
+        if (headerCellDataList == null || headerCellDataList.isEmpty()) {
+            return columnRanges;
+        }
+        
+        for (HeaderCellData headerCell : headerCellDataList) {
+            Float startPoint = headerCell.getPeakStartPoint() != null 
+                ? headerCell.getPeakStartPoint() 
+                : headerCell.getStartPoint();
+            Float endPoint = headerCell.getPeakEndPoint() != null 
+                ? headerCell.getPeakEndPoint() 
+                : headerCell.getEndPoint();
+            
+            if (startPoint != null && endPoint != null) {
+                columnRanges.add(Range.closed(startPoint, endPoint));
+            }
+        }
+        
+        return columnRanges;
+    }
+
+    /**
+     * Create row ranges from TableRows using Y positions
+     */
+    private static List<Range<Float>> createRowRanges(List<TableRow> tableRows) {
+        List<Range<Float>> rowRanges = new ArrayList<>();
+        
+        if (tableRows == null || tableRows.isEmpty()) {
+            return rowRanges;
+        }
+        
+        for (int i = 0; i < tableRows.size(); i++) {
+            TableRow currentRow = tableRows.get(i);
+            Float currentY = currentRow.getY();
+            
+            if (currentY == null) {
+                continue;
+            }
+            
+            // Calculate row height
+            Float nextY;
+            if (i < tableRows.size() - 1) {
+                nextY = tableRows.get(i + 1).getY();
+            } else {
+                // For last row, estimate height from word height
+                float maxWordHeight = 0f;
+                if (currentRow.getWordDataList() != null) {
+                    for (WordData word : currentRow.getWordDataList()) {
+                        if (word.getHeight() > maxWordHeight) {
+                            maxWordHeight = word.getHeight();
+                        }
+                    }
+                }
+                nextY = currentY + (maxWordHeight > 0 ? maxWordHeight : 10f);
+            }
+            
+            if (nextY != null) {
+                rowRanges.add(Range.closed(currentY, nextY));
+            }
+        }
+        
+        return rowRanges;
+    }
+
+    /**
+     * Build Table object from grid-detected TableStructure
+     */
+    private static Table buildTableFromGridStructure(
+            Integer pageNumber,
+            TableStructure detectedTable,
+            List<WordData> pageWords,
+            float pageHeight) {
+        
+        Table table = new Table();
+        table.setPageNumber(pageNumber);
+        table.setColType(new ArrayList<>());
+        table.setTxnColType(new ArrayList<>());
+        
+        int totalRows = detectedTable.getRows();
+        int totalColumns = detectedTable.getColumns();
+        
+        table.setTotalRows(totalRows);
+        table.setTotalColumns(totalColumns);
+        
+        // Get cell structures from detected table
+        List<List<CellStructure>> cellStructures = detectedTable.getCells();
+        
+        // Build cells map
+        Map<Integer, Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell>> cells = new HashMap<>();
+        
+        if (cellStructures != null && !cellStructures.isEmpty()) {
+            for (int row = 0; row < cellStructures.size(); row++) {
+                List<CellStructure> rowCells = cellStructures.get(row);
+                Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell> cellRow = new HashMap<>();
+                
+                for (int col = 0; col < rowCells.size(); col++) {
+                    CellStructure cellStructure = rowCells.get(col);
+                    
+                    // Create TableCell
+                    com.finboost.bank.statement.parser.representation.document.extraction.TableCell cell = 
+                        new com.finboost.bank.statement.parser.representation.document.extraction.TableCell();
+                    
+                    cell.setRowindex(row);
+                    cell.setColindex(col);
+                    
+                    // Set cell boundaries from CellStructure
+                    double x1 = cellStructure.getLeft();
+                    double y1 = cellStructure.getTop();
+                    double x2 = cellStructure.getRight();
+                    double y2 = cellStructure.getBottom();
+                    
+                    cell.setX1((float) x1);
+                    cell.setY1((float) y1);
+                    cell.setX2((float) x2);
+                    cell.setY2((float) y1);
+                    cell.setX3((float) x2);
+                    cell.setY3((float) y2);
+                    cell.setX4((float) x1);
+                    cell.setY4((float) y2);
+                    
+                    // Assign words that fall within this cell
+                    List<Word> cellWords = assignWordsToCell(cellStructure, pageWords, pageHeight);
+                    cell.setWords(cellWords);
+                    
+                    cellRow.put(col, cell);
+                }
+                
+                cells.put(row, cellRow);
+            }
+        }
+        
+        table.setCells(cells);
+        
+        // Set table boundaries from detected table
+        float tableX1 = (float) detectedTable.getLeft();
+        float tableY1 = (float) detectedTable.getTop();
+        float tableX2 = (float) detectedTable.getRight();
+        float tableY2 = (float) detectedTable.getBottom();
+        
+        table.setX1(tableX1);
+        table.setY1(tableY1);
+        table.setX2(tableX2);
+        table.setY2(tableY1);
+        table.setX3(tableX2);
+        table.setY3(tableY2);
+        table.setX4(tableX1);
+        table.setY4(tableY2);
+        
+        return table;
+    }
+
+    /**
+     * Assign words to a cell based on their position
+     * 
+     * COORDINATE SYSTEM NOTE - CRITICAL:
+     * - Graphics lines use BOTTOM-LEFT coordinate system (Y increases upward)
+     * - Text positions use TOP-LEFT coordinate system (Y increases downward) 
+     * - WordData.y1 comes from TextPosition.getYDirAdj() which is TOP-LEFT!
+     * - Cell boundaries are in BOTTOM-LEFT system
+     * - We MUST convert word coordinates from TOP-LEFT to BOTTOM-LEFT
+     * 
+     * Conversion formula: bottomLeftY = pageHeight - topLeftY
+     */
+    private static List<Word> assignWordsToCell(
+            CellStructure cellStructure,
+            List<WordData> pageWords,
+            float pageHeight) {
+        
+        List<Word> cellWords = new ArrayList<>();
+        
+        if (pageWords == null || pageWords.isEmpty()) {
+            return cellWords;
+        }
+        
+        // Cell boundaries in BOTTOM-LEFT coordinate system
+        double cellLeft = cellStructure.getLeft();
+        double cellRight = cellStructure.getRight();
+        double cellBottom = cellStructure.getBottom();  // Smaller Y
+        double cellTop = cellStructure.getTop();        // Larger Y
+        
+        // Add tolerance for word assignment (words at cell edges)
+        double tolerance = 0.0;
+        
+        int wordIndex = 0;
+        for (WordData wordData : pageWords) {
+            // WordData coordinates are in TOP-LEFT system
+            float wordLeft = wordData.getX1();
+            float wordRight = wordData.getX2();
+            float wordTopLeftY = wordData.getY1();  // TOP-LEFT baseline
+            float wordHeight = wordData.getHeight();
+            
+            // Convert from TOP-LEFT to BOTTOM-LEFT coordinate system
+            float wordBottomLeftTop = pageHeight - (wordTopLeftY - wordHeight);  // Top in bottom-left (larger Y)
+            float wordBottomLeftBottom = pageHeight - (wordTopLeftY);  // Bottom in bottom-left (smaller Y)
+            
+            // Calculate word center in BOTTOM-LEFT system
+            float wordCenterX = (wordLeft + wordRight) / 2.0f;
+            float wordCenterY = (wordBottomLeftBottom + wordBottomLeftTop) / 2.0f;
+            
+            // Check if word center is within cell bounds
+            boolean withinX = wordCenterX >= cellLeft - tolerance && wordCenterX <= cellRight + tolerance;
+            boolean withinY = wordCenterY >= cellBottom - tolerance && wordCenterY <= cellTop + tolerance;
+            
+            if (withinX && withinY) {
+                // Get page index from wordData
+                Integer pageIdx = wordData.getPageIndex() != null ? wordData.getPageIndex() : 0;
+                Word word = convertWordDataToWord(wordData, wordIndex++, pageIdx);
+                cellWords.add(word);
+            }
+        }
+        
+        return cellWords;
+    }
+
+    /**
+     * Build Word list from WordData list
+     */
+    private static List<Word> buildWordsFromWordData(List<WordData> wordDataList) {
+        List<Word> words = new ArrayList<>();
+        int wordIndex = 0;
+        
+        for (WordData wd : wordDataList) {
+            Integer pageIdx = wd.getPageIndex() != null ? wd.getPageIndex() : 0;
+            Word word = convertWordDataToWord(wd, wordIndex++, pageIdx);
+            words.add(word);
+        }
+        
+        return words;
+    }
+
+    /**
+     * Convert WordData to Word object
+     */
+    private static Word convertWordDataToWord(WordData wordData, int wordIndex, Integer pageIndex) {
+        Word word = new Word();
+        word.setContent(wordData.getWord());
+        word.setPageNumber(pageIndex + 1); // Page numbers are 1-based
+        word.setPageIndex(pageIndex);
+        word.setWordIndex(wordIndex);
+        
+        // Set polygon coordinates from WordData
+        float x1 = wordData.getX1();
+        float y1 = wordData.getY1();
+        float x2 = wordData.getX2();
+        float y2 = y1 + wordData.getHeight();
+        
+        word.setX1(x1);
+        word.setY1(y1);
+        word.setX2(x2);
+        word.setY2(y1); // Y2 same as Y1 for top edge
+        word.setX3(x2);
+        word.setY3(y2);
+        word.setX4(x1);
+        word.setY4(y2);
+        
+        // Set dimensions
+        word.setWidth(x2 - x1);
+        word.setHeight(wordData.getHeight());
+        
+        return word;
+    }
+
+    /**
+     * Create an empty table
+     */
+    private static Page createEmptyTablePage(Integer pageIndex) {
+        Table table = new Table();
+        table.setPageNumber(pageIndex + 1);
+        table.setColType(new ArrayList<>());
+        table.setTxnColType(new ArrayList<>());
+        table.setTotalRows(0);
+        table.setTotalColumns(0);
+        table.setCells(new HashMap<>());
+
+
+        Page page = new Page();
+        page.setPageNumber(pageIndex + 1);
+        // Create a single table for this page (table 0)
+        Map<Integer, Table> tables = new HashMap<>();
+        tables.put(0, table);
+
+        page.setTables(tables);
+
+        // Build Word list from transaction rows
+        List<Word> words = Collections.emptyList();
+        page.setWords(words);
+
+        return page;
+
+    }
+}
