+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.regex.Pattern;
+@Component
+public class AxisHandler implements IBankWiseHandler{
+
+    @Override
+    public BankStatementProcessingConfig getTableExtractorConfig(BankStatementVO bankStatementVO) throws Exception {
+        String fileContent = PdfTextExtractionUtil.convertPDFToTextByPositionOrder(bankStatementVO.getDecryptedFile());
+
+        //Format1
+        if(Pattern.compile("S. No.\\s*Transaction Date\\s*Value Date\\s*Cheque Number\\s*Transaction Particulars\\s*Amount\\s*Transaction Type\\s*Balance\\s*Branch Name").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.GRID_LINE)
+                    .graphicsTableSelectorHandler( input -> {
+                        if(null == input || null == input.getDetectedTables() || input.getDetectedTables().isEmpty()) {
+                            return Collections.emptyList();
+                        }
+                        List<TableStructure> approvedTables = new ArrayList<>();
+                        for(TableStructure tableStructure: input.getDetectedTables()){
+                            if(tableStructure != null && tableStructure.getColumns() == 9){
+                                approvedTables.add(tableStructure);
+                            }
+                        }
+                        return approvedTables;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+            //format-3
+        }else  if(Pattern.compile("^[\\s]*AXIS[\\s]*Bank[\\s]*Ltd").matcher(fileContent).find() && Pattern.compile("Clearing[\\s]*Branch").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.GRID_LINE)
+                    .graphicsTableSelectorHandler( input -> {
+                        if(null == input || null == input.getDetectedTables() || input.getDetectedTables().isEmpty()) {
+                            return Collections.emptyList();
+                        }
+                        List<TableStructure> approvedTables = new ArrayList<>();
+                        for(TableStructure tableStructure: input.getDetectedTables()){
+                            if(tableStructure != null && tableStructure.getColumns() == 8){
+                                approvedTables.add(tableStructure);
+                            }
+                        }
+                        return approvedTables;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+            //format-4
+        }else  if(Pattern.compile("CREDIT[\\s]*CARD[\\s]*(STATEMENT)?").matcher(fileContent.toUpperCase()).find() && Pattern.compile("Card[\\s]*No[\\s]*:").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.SELECTED_ROWS_TEXT_POSITION)
+                    .selectedRowsSelectionHandler(input->{
+                        if(input.getSelectedRows() == null || input.getSelectedRows().isEmpty()){
+                            return new LinkedHashMap<>();
+                        }
+
+                        Pattern headerPattern=Pattern.compile("DATE\\s*TRANSACTION\\s*DETAILS\\s*MERCHANT\\s*CATEGORY\\s*AMOUNT\\s*\\(Rs\\.?\\s*\\)\\s*CASHBACK\\s*EARNED");
+                        Pattern endPattern=Pattern.compile("(?i)^\\s*\\*{4}\\s*End of Statement\\s*\\*{4}\\s*");
+                        LinkedHashMap<Integer, List<TableRow>> tableRow = new LinkedHashMap<>();
+                        List<TableRow> rows = new ArrayList<>();
+                        Boolean setRow = false;
+                        for (TableRow row : input.getSelectedRows()) {
+                            if (headerPattern.matcher(row.getContent()).find()) {
+                                setRow = true;
+                            }
+                            if (setRow && endPattern.matcher(row.getContent()).find()) {
+                                setRow = false;
+                            }
+                            if (setRow) {
+                                rows.add(row);
+                            }
+                        }
+                        if(!rows.isEmpty()) {
+                            tableRow.put(1, rows);
+                        }
+                        return tableRow;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+            //format-6
+        }else  if(((Pattern.compile("Relationship[\\s]*summary").matcher(fileContent).find() && Pattern.compile("Detailed[\\s]*Statement[\\s]*for[\\s]*a/c[\\s]*no").matcher(fileContent).find())) &&
+                !Pattern.compile("Particulars[\\s]*Debit[\\s]*Credit[\\s]*Balance[\\s]*Init").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+                    .graphicsVerticalLineHandler( input -> {
+                        if(input.getLines() == null || input.getLines().isEmpty()){
+                            return input.getLines();
+                        }
+
+                        float threshold = (input.getPageHeight() * 0.95f);
+                        List<TableLineExtractor.Line> resultLine = new ArrayList<>();
+                        for(TableLineExtractor.Line line : input.getLines()){
+                            if(line.getLength() <= threshold && line.getLength() >(input.getPageHeight() * 0.015f)){
+                                resultLine.add(line);
+                            }
+                        }
+                        return resultLine;
+                    }).useDetectedColumns(true).useDetectedRows(true).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+            //format-12
+        }else  if(Pattern.compile("Particulars[\\s]*Debit[\\s]*Credit[\\s]*Balance[\\s]*Init.").matcher(fileContent).find()) {
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.GRID_LINE)
+                    .graphicsTableSelectorHandler(input -> {
+                        if (null == input || null == input.getDetectedTables() || input.getDetectedTables().isEmpty()) {
+                            return Collections.emptyList();
+                        }
+                        List<TableStructure> approvedTables = new ArrayList<>();
+                        for (TableStructure tableStructure : input.getDetectedTables()) {
+                            if (tableStructure != null && tableStructure.getColumns() == 9) {
+                                approvedTables.add(tableStructure);
+                            }
+                        }
+                        return approvedTables;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+
+        }
+        //format14
+        else  if(Pattern.compile("Tran[\\s]*Date[\\s]*Value[\\s]*Date[\\s]*Transaction[\\s]*Details[\\s]*Chq.[\\s]*No.[\\s]*Debit[\\s]*Credit[\\s]*Balance[\\s]*Init.[\\s]*Br").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.SELECTED_ROWS_TEXT_POSITION)
+                    .selectedRowsSelectionHandler(input->{
+                        if(input.getSelectedRows() == null || input.getSelectedRows().isEmpty()){
+                            return new LinkedHashMap<>();
+                        }
+
+                        Pattern headerPattern=Pattern.compile("Tran\\s+Date\\s+Value\\s+Date\\s+Transaction\\s+Details\\s+Chq.\\s+No\\.?\\s+Debit\\s+Credit\\s+Balance\\s+Init\\s+Br.|Tran\\s+Date\\s+Value\\s+Date\\s+Transaction\\s+Details\\s+Chq.\\s+No\\.?\\s+Debit\\s+Credit\\s+Balance\\s+Init.\\s+Br.");
+                        Pattern endPattern=Pattern.compile("\\s*TRANSACTION\\s*TOTAL.*|\\s*Page.*");
+                        LinkedHashMap<Integer, List<TableRow>> tableRow = new LinkedHashMap<>();
+                        List<TableRow> rows = new ArrayList<>();
+                        Boolean setRow = false;
+                        for (TableRow row : input.getSelectedRows()) {
+                            if (headerPattern.matcher(row.getContent()).find() ) {
+                                setRow = true;
+                            }
+                            if (setRow && endPattern.matcher(row.getContent()).find()) {
+                                setRow = false;
+                            }
+                            if (setRow) {
+                                rows.add(row);
+                            }
+                        }
+                        if(!rows.isEmpty()) {
+                            tableRow.put(1, rows);
+                        }
+                        return tableRow;
+                    }).useDetectedColumns(true).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }//format-13
+        else  if(Pattern.compile("Date[\\s]*Transaction[\\s]*Details[\\s]*Chq[\\s]*No.[\\s]*Withdrawal[\\s]*Deposits[\\s]*Balance").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.SELECTED_ROWS_TEXT_POSITION)
+                    .selectedRowsSelectionHandler(input->{
+                        if(input.getSelectedRows() == null || input.getSelectedRows().isEmpty()){
+                            return new LinkedHashMap<>();
+                        }
+                        Pattern headerPattern=Pattern.compile("Date\\s+Transaction\\s+Details\\s+Chq\\s*No\\.?\\s+Withdrawal\\s+Deposits\\s+Balance");
+                        Pattern endPattern=Pattern.compile("Closing\\s*Balance\\s* *");
+                        Pattern pagePattern=Pattern.compile("Page\\s*.*");
+
+                        LinkedHashMap<Integer, List<TableRow>> tableRow = new LinkedHashMap<>();
+                        List<TableRow> rows = new ArrayList<>();
+                        Boolean setRow = false;
+                        for (TableRow row : input.getSelectedRows()) {
+                            if (headerPattern.matcher(row.getContent()).find()) {
+                                setRow = true;
+                            }
+                            if (setRow && endPattern.matcher(row.getContent()).find() | pagePattern.matcher(row.getContent()).find()) {
+                                setRow = false;
+                            }
+                            if (setRow) {
+                                rows.add(row);
+                            }
+                        }
+                        if(!rows.isEmpty()) {
+                            tableRow.put(1, rows);
+                        }
+                        return tableRow;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        } //other,other3
+        else  if(Pattern.compile("In\\s*case\\s*of\\s*any\\s*clarification\\s*regarding\\s*this\\s*transaction\\s*please\\s*get\\s*in\\s*touch\\s*with").matcher(fileContent).find()
+                && Pattern.compile("\\+{4}\\s+End\\s+of\\s+Report\\s+\\+{4}").matcher(fileContent).find()){
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.GRID_LINE)
+                    .graphicsTableSelectorHandler( input -> {
+                        if(null == input || null == input.getDetectedTables() || input.getDetectedTables().isEmpty()) {
+                            return Collections.emptyList();
+                        }
+                        List<TableStructure> approvedTables = new ArrayList<>();
+                        for(TableStructure tableStructure: input.getDetectedTables()){
+                            if(tableStructure != null && tableStructure.getColumns() == 9){
+                                approvedTables.add(tableStructure);
+                            }
+                        }
+                        return approvedTables;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }
+
+        return new BankStatementProcessingConfig();
+
+    }
+}
