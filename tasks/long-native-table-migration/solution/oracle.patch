+import com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor.TableLineExtractor;
+import com.finboost.bank.statement.parser.tableextractor.graphics.model.TableStructure;
+import com.finboost.bank.statement.parser.tableextractor.model.TableRow;
+import com.finboost.bank.statement.parser.util.PdfTextExtractionUtil;
