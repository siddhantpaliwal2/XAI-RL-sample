+    /**
+     * Gets all PDF files from the specified directory.
+     */
+    private static List<File> getPdfFilesFromDirectory(String directoryPath) throws IOException {
+        List<File> pdfFiles = new ArrayList<>();
+        Path dir = Paths.get(directoryPath);
+        
+        if (!Files.exists(dir) || !Files.isDirectory(dir)) {
+            throw new IOException("Directory does not exist: " + directoryPath);
+        }
+        
+        Files.walk(dir)
+            .filter(Files::isRegularFile)
+            .filter(path -> path.toString().toLowerCase().endsWith(".pdf"))
+            .forEach(path -> pdfFiles.add(path.toFile()));
+        
+        return pdfFiles;
+    }
