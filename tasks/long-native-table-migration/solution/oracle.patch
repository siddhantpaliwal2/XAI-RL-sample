+        
+        table.setTotalRows(totalRows);
+        table.setTotalColumns(totalColumns);
+        
+        // Get cell structures from detected table
+        List<List<CellStructure>> cellStructures = detectedTable.getCells();
+        
+        // Build cells map
+        Map<Integer, Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell>> cells = new HashMap<>();
+        
+        if (cellStructures != null && !cellStructures.isEmpty()) {
+            for (int row = 0; row < cellStructures.size(); row++) {
+                List<CellStructure> rowCells = cellStructures.get(row);
+                Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell> cellRow = new HashMap<>();
+                
+                for (int col = 0; col < rowCells.size(); col++) {
+                    CellStructure cellStructure = rowCells.get(col);
+                    
+                    // Create TableCell
+                    com.finboost.bank.statement.parser.representation.document.extraction.TableCell cell = 
+                        new com.finboost.bank.statement.parser.representation.document.extraction.TableCell();
+                    
+                    cell.setRowindex(row);
+                    cell.setColindex(col);
+                    
+                    // Set cell boundaries from CellStructure
+                    double x1 = cellStructure.getLeft();
+                    double y1 = cellStructure.getTop();
+                    double x2 = cellStructure.getRight();
+                    double y2 = cellStructure.getBottom();
+                    
+                    cell.setX1((float) x1);
+                    cell.setY1((float) y1);
+                    cell.setX2((float) x2);
+                    cell.setY2((float) y1);
+                    cell.setX3((float) x2);
+                    cell.setY3((float) y2);
+                    cell.setX4((float) x1);
+                    cell.setY4((float) y2);
+                    
+                    // Assign words that fall within this cell
