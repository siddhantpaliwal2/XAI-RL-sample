+package com.finboost.bank.statement.parser.tableextractor;
+
+import com.finboost.bank.statement.parser.tableextractor.model.CharData;
+import com.finboost.bank.statement.parser.tableextractor.model.WordData;
+import org.apache.pdfbox.pdmodel.PDDocument;
+import org.apache.pdfbox.text.TextPosition;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.regex.Pattern;
+
+/**
+ * Utility class for extracting words from PDF documents
+ */
+public class WordExtractor {
+
+    private static final Float SPACE_THRESHOLD_HORIZONTAL = 1.3f;
+    private static final Pattern SPECIAL_CHARS_PATTERN = Pattern.compile("(−|‐|­)");
+
+    /**
+     * Method used for fetching the character from the PDF
+     */
+    public static List<CharData> fetchCharDataList(PDDocument document) {
+        List<CharData> charDataList = new ArrayList<>();
+        try {
+            for (int i = 0; i < document.getNumberOfPages(); i++) {
+                List<TextPosition> textPositionList = new ArrayList<>();
+                CustomPDFTextStripper textStripper = new CustomPDFTextStripper(textPositionList);
+                textStripper.setSortByPosition(true);
+                textStripper.setStartPage(i + 1);
+                textStripper.setEndPage(i + 1);
+                Writer dummy = new OutputStreamWriter(new ByteArrayOutputStream());
+                try {
+                    textStripper.writeText(document, dummy);
+                } catch (StackOverflowError error) {
+                    System.out.println("Error occurred while fetching the text position =======>>>> " + error.getMessage());
+                }
+                for (TextPosition position : textPositionList) {
+                    // passing the entire character to custom class
+                    CharData charData = new CharData(position, i);
+                    String character = charData.getChr();
+                    
+                    if (SPECIAL_CHARS_PATTERN.matcher(character).find()) {
+                        charData.setChr("-");
+                    } else {
+                        character = character.replaceAll("[^\\x00-\\x7F]", "");
+                    }
+                    
+                    if (!"|".equals(charData.getChr()) && !character.isEmpty()) {
+                        charDataList.add(charData);
+                    }
+                }
+            }
+        } catch (IOException e) {
+            System.out.println("Exception occurred while fetching the character from the file ====>>>>>>    " + e.getMessage());
+        }
+        return charDataList;
+    }
+
+    /**
+     * Method is used for creating the word from the character
+     */
+    public static List<WordData> fetchWordDataList(List<CharData> charDataList) {
+        List<WordData> wordDataList = new ArrayList<>();
+        int i = 0;
+        StringBuilder stringBuilder = new StringBuilder();
+        CharData copyCharData = null;
+        
+        while (i < charDataList.size()) {
+            CharData charData = charDataList.get(i);
+            if (charData.getChr().trim().isEmpty()) {
+                i++;
+                continue;
+            }
+            
+            CharData nextCharData = null;
+            if (i + 1 < charDataList.size()) {
+                nextCharData = charDataList.get(i + 1);
+            }
+            
+            if (copyCharData == null) {
+                copyCharData = charData;
+            }
+            
+            // if space is < 1.3 then append the character
+            if (nextCharData != null && 
+                !nextCharData.getChr().trim().isEmpty() && 
+                nextCharData.getX() - (charData.getX() + charData.getWidth()) < SPACE_THRESHOLD_HORIZONTAL && 
+                Objects.equals(charData.getY(), nextCharData.getY())) {
+                stringBuilder.append(charData.getChr());
+            } else {
+                // if space is > 1.3 then append the character and make the word
+                stringBuilder.append(charData.getChr());
+                wordDataList.add(new WordData(charData, copyCharData, stringBuilder.toString()));
+                stringBuilder = new StringBuilder();
+                copyCharData = null;
+            }
+            i++;
+        }
+        return wordDataList;
+    }
+
+}
