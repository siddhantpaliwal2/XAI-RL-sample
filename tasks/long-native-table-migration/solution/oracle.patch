+     * Handles coordinate system conversion from top-left (text) to bottom-left (graphics)
+     */
+    private static List<TableRow> filterTableRowsByTableBoundary(
+            List<TableRow> allRows,
+            TableStructure detectedTable,
+            float pageHeight,
+            double tolerance) {
+        
+        List<TableRow> filteredRows = new ArrayList<>();
+        
+        // Table boundaries in BOTTOM-LEFT coordinate system
+        double tableLeft = detectedTable.getLeft();
+        double tableRight = detectedTable.getRight();
+        double tableBottom = detectedTable.getBottom();  // Smaller Y
+        double tableTop = detectedTable.getTop();        // Larger Y
+        
+        for (TableRow row : allRows) {
+            if (row.getWordDataList() == null || row.getWordDataList().isEmpty()) {
+                continue;
+            }
+            
+            // Get row Y position (top-left coordinate system from TextPosition)
+            Float rowY = row.getY();
+            if (rowY == null) continue;
+            
+            // Convert row Y from TOP-LEFT to BOTTOM-LEFT coordinate system
+            float rowBottomLeftY = pageHeight - rowY;
+            
+            boolean withinY = rowBottomLeftY >= tableBottom - tolerance && 
+                            rowBottomLeftY <= tableTop + tolerance;
+            
+            // Also check if any words in the row fall within X bounds
+            boolean withinX = false;
+            for (WordData word : row.getWordDataList()) {
+                float wordCenterX = (word.getX1() + word.getX2()) / 2.0f;
+                if (wordCenterX >= tableLeft - tolerance && wordCenterX <= tableRight + tolerance) {
+                    withinX = true;
+                    break;
+                }
+            }
+            
+            if (withinY && withinX) {
+                filteredRows.add(row);
+            }
+        }
+        
+        return filteredRows;
+    }
