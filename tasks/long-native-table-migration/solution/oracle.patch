+                dateFlag = false;
+                continue;
+            }
+            
+            if (wordDataList.stream().anyMatch(wd -> (2 * wd.getX2() - wd.getX1()) > balanceX1 && wd.getWord().matches(".*[A-z]+.*"))) {
+                balanceFlag = true;
+            }
+            
+            if (dateFlag && !balanceFlag && headerCellData.getWordDataList() == null) {
+                headerCellData.setWordDataList(new ArrayList<>(wordDataList));
+                dateFlageIndex = copyPageRowList.indexOf(copyPageRowList.get(tempStartIndex - dateDescriptionBalanceRowCount));
+            } else if (balanceFlag && !dateFlag && headerCellData.getWordDataList() != null) {
+                headerCellData.getWordDataList().addAll(wordDataList);
+                headerCellData.setRowNumber(startIndex);
+                break;
+            } else if (!balanceFlag && (startIndex == 0 || dateDescriptionBalanceRowCount == 5) && headerCellData.getWordDataList() != null) {
+                dateDescriptionBalanceRowCount = 1;
+                while (dateDescriptionBalanceRowCount < 3 && !balanceFlag) {
