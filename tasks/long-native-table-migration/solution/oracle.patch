@@ -0,0 +1,109 @@
+package com.finboost.bank.statement.parser.tableextractor.model;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+
+/**
+ * Model class to represent a table row in PDF extraction
+ */
+public class TableRow {
+
+    private List<WordData> wordDataList = new ArrayList<>();
+    private Float y;
+    private Integer pageIndex;
+    private Float lineWidth;
+    private Float actualY;
+
+    public TableRow() {
+    }
+
+    public TableRow(Float y, List<WordData> wordDataList, Integer pageIndex) {
+        this.y = y;
+        this.wordDataList = wordDataList;
+        this.pageIndex = pageIndex;
+        
+        if (wordDataList != null && !wordDataList.isEmpty()) {
+            // Calculate actualY from the first word's actualY1 after sorting by actualY1
+            this.actualY = wordDataList.stream()
+                    .min(Comparator.comparing(WordData::getActualY1))
+                    .map(WordData::getActualY1)
+                    .orElse(y);
+            
+            // Calculate line width: start from leftmost x1, end at rightmost x2 of the word with the largest x1
+            Float start = wordDataList.stream()
+                    .min(Comparator.comparing(WordData::getX1))
+                    .map(WordData::getX1)
+                    .orElse(0f);
+            
+            Float end = wordDataList.stream()
+                    .max(Comparator.comparing(WordData::getX1))
+                    .map(WordData::getX2)
+                    .orElse(0f);
+            
+            this.lineWidth = end - start;
+        } else {
+            this.actualY = y;
+            this.lineWidth = 0f;
+        }
+    }
+
+    public String getContent() {
+        if (wordDataList == null) {
+            return "";
+        }
+        return wordDataList.stream()
+                .map(WordData::getWord)
+                .collect(Collectors.joining(" "));
+    }
+
+    public List<String> getRowStringList() {
+        if (wordDataList == null) {
+            return new ArrayList<>();
+        }
+        return wordDataList.stream()
+                .map(wordData -> wordData.getWord().toLowerCase())
+                .collect(Collectors.toList());
+    }
+
+    public Integer getPageIndex() {
+        return pageIndex;
+    }
+
+    public void setPageIndex(Integer pageIndex) {
+        this.pageIndex = pageIndex;
+    }
+
+    public List<WordData> getWordDataList() {
+        return wordDataList;
+    }
+
+    public void setWordDataList(List<WordData> wordDataList) {
+        this.wordDataList = wordDataList;
+    }
+
+    public Float getY() {
+        return y;
+    }
+
+    public void setY(Float y) {
+        this.y = y;
+    }
+
+    public Float getLineWidth() {
+        return lineWidth;
+    }
+
+    public void setLineWidth(Float lineWidth) {
+        this.lineWidth = lineWidth;
+    }
+
+    public Float getActualY() {
+        return actualY;
+    }
+
+    public void setActualY(Float actualY) {
+        this.actualY = actualY;
+    }
+}
diff --git a/src/main/java/com/finboost/bank/statement/parser/tableextractor/model/WordData.java b/src/main/java/com/finboost/bank/statement/parser/tableextractor/model/WordData.java
new file mode 100644
