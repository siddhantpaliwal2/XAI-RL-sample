+    /**
+     * Merge multiple tableextractor.TableCell objects into a single representation.TableCell
+     * This handles cases where multiple cells share the same row and column position
+     */
+    private static com.finboost.bank.statement.parser.representation.document.extraction.TableCell 
+            mergeCells(List<com.finboost.bank.statement.parser.tableextractor.model.TableCell> sourceCells, 
+                      int rowIndex, int colIndex, Integer pageNumber) {
+        com.finboost.bank.statement.parser.representation.document.extraction.TableCell targetCell = 
+            new com.finboost.bank.statement.parser.representation.document.extraction.TableCell();
+        
+        targetCell.setRowindex(rowIndex);
+        targetCell.setColindex(colIndex);
+        
+        // Collect all words from all source cells
+        List<Word> allWords = new ArrayList<>();
+        int wordIndex = 0;
+        
+        for (com.finboost.bank.statement.parser.tableextractor.model.TableCell sourceCell : sourceCells) {
+            if (sourceCell.getWordDataList() != null && !sourceCell.getWordDataList().isEmpty()) {
+                for (WordData wd : sourceCell.getWordDataList()) {
+                    Word word = convertWordDataToWord(wd, wordIndex++);
+                    allWords.add(word);
+                }
+            }
+        }
+        
+        if (!allWords.isEmpty()) {
+            targetCell.setWords(allWords);
+            // Calculate cell boundaries from all words
+            calculateCellBoundaries(targetCell, allWords);
+        }
+        
+        return targetCell;
+    }
