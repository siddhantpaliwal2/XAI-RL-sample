+package com.finboost.bank.statement.parser.tableextractor;
+
+import com.finboost.bank.statement.parser.tableextractor.model.HeaderCellData;
+import com.finboost.bank.statement.parser.tableextractor.model.TableRow;
+import com.finboost.bank.statement.parser.tableextractor.model.WordData;
+import com.finboost.bank.statement.parser.tableextractor.util.TrapRangeBuilder;
+import com.finboost.bank.statement.parser.tableextractor.util.TrapRangeBuilder.Range;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+/**
+ * Utility class for extracting columns from header data
+ */
+public class ColumnExtractor {
+
+    private static final Pattern SR_NO_PATTERN = Pattern.compile("[Ss]r.[Nn]o.");
+    private static final Pattern DATE_PATTERN = Pattern.compile("[Dd]ate");
+    private static final Pattern WITHDRAWALS_PATTERN = Pattern.compile("Withdrawals");
+    private static final Pattern DEPOSITS_PATTERN = Pattern.compile("Deposits");
+    private static final Pattern CLOSING_BRACKET_PATTERN = Pattern.compile("^\\)$");
+    private static final Pattern SLASH_PATTERN = Pattern.compile("^/$");
+    private static final Pattern INR_PATTERN = Pattern.compile("\\(inr\\)");
+
+    public static List<HeaderCellData> extractHeaderColumn(HeaderCellData headerCellData, Float wordSpaceHorizontal, List<TableRow> copyPageRowList) {
+        int headerDataCount = 0;
+        int columnCount = 0;
+        WordData nextWordData = new WordData();
+        WordData presentWordData;
+        List<HeaderCellData> headerCellDataList = new ArrayList<>();
+        List<WordData> wordDataList = new ArrayList<>();
+        
+        if (headerCellData.getWordDataList() == null || headerCellData.getWordDataList().isEmpty()) {
+            return headerCellDataList;
+        }
+        
+        if (headerCellData.getWordDataList().size() > 1) {
+            nextWordData = headerCellData.getWordDataList().get(headerDataCount + 1);
+        }
+        
+        headerCellData.getWordDataList().sort(Comparator.comparing(WordData::getX1));
+        
+        while (headerDataCount < headerCellData.getWordDataList().size()) {
+            presentWordData = headerCellData.getWordDataList().get(headerDataCount);
+            wordDataList.add(presentWordData);
+            
+            boolean findText = SR_NO_PATTERN.matcher(presentWordData.getWord()).find();
+            boolean findDate = DATE_PATTERN.matcher(nextWordData.getWord()).find();
+            boolean findTextWithWithdrawals = WITHDRAWALS_PATTERN.matcher(presentWordData.getWord()).find();
+            boolean findDateDeposits = DEPOSITS_PATTERN.matcher(nextWordData.getWord()).find();
+            
+            String joinedWords = wordDataList.stream()
+                    .map(WordData::getWord)
+                    .collect(Collectors.joining(" "));
+            
+            boolean isClosingBracket = CLOSING_BRACKET_PATTERN.matcher(joinedWords).find();
+            boolean isSlash = SLASH_PATTERN.matcher(nextWordData.getWord()).find();
+            
+            if ((nextWordData.getX1() - presentWordData.getX2() > wordSpaceHorizontal && 
+                 !isClosingBracket && !isSlash) ||
+                (!isClosingBracket && findText && findDate) ||
+                (!isClosingBracket && findDateDeposits && findTextWithWithdrawals)) {
+                
+                headerCellDataList.add(new HeaderCellData(new ArrayList<>(wordDataList), columnCount));
+                wordDataList = new ArrayList<>();
+                columnCount++;
+            } else if (isClosingBracket && !headerCellDataList.isEmpty()) {
+                headerCellDataList.get(headerCellDataList.size() - 1).getWordDataList().add(wordDataList.get(0));
+                wordDataList = new ArrayList<>();
+            }
+            
+            headerDataCount++;
+            if (headerDataCount < headerCellData.getWordDataList().size() - 1) {
+                nextWordData = headerCellData.getWordDataList().get(headerDataCount + 1);
+            }
+        }
+        
+        if (!wordDataList.isEmpty() && 
+            !CLOSING_BRACKET_PATTERN.matcher(wordDataList.stream()
+                    .map(WordData::getWord)
+                    .collect(Collectors.joining(" "))).find()) {
+            headerCellDataList.add(new HeaderCellData(wordDataList, columnCount));
+        }
+        
+        // Check next row for INR pattern
+        if (headerCellData.getRowNumber() != null && 
+            headerCellData.getRowNumber() + 1 < copyPageRowList.size()) {
+            
+            List<WordData> nextRowWordDataList = copyPageRowList.get(headerCellData.getRowNumber() + 1).getWordDataList();
+            String nextRow = nextRowWordDataList.stream()
+                    .map(WordData::getWord)
+                    .collect(Collectors.joining(" "));
+            
+            if (!nextRow.matches(".*[0-9].*") && INR_PATTERN.matcher(nextRow.toLowerCase()).find()) {
+                for (HeaderCellData headerCellDataContent : headerCellDataList) {
+                    List<WordData> matchingWords = nextRowWordDataList.stream()
+                            .filter(wd -> {
+                                float midPoint = wd.getX1() + (wd.getX2() - wd.getX1()) / 2;
+                                return midPoint > headerCellDataContent.getStartPoint() && 
+                                       midPoint < headerCellDataContent.getEndPoint();
+                            })
+                            .collect(Collectors.toList());
+                    
+                    if (!matchingWords.isEmpty()) {
+                        headerCellDataContent.getWordDataList().addAll(matchingWords);
+                    }
+                }
+            }
+        }
+        
+        return headerCellDataList;
+    }
+
+    /**
+     * Generate header cell data list automatically from transaction rows when headers are missing.
+     * Uses TrapRange algorithm to detect column boundaries based on word positions in the data rows.
+     * 
+     * @param transactionRowList List of transaction rows to analyze
+     * @return List of HeaderCellData with automatically detected column boundaries
+     */
+    public static List<HeaderCellData> generateHeaderCellDataFromRows(List<TableRow> transactionRowList) {
+        if (transactionRowList == null || transactionRowList.isEmpty()) {
+            return new ArrayList<>();
+        }
+
+        // Collect all word positions from all transaction rows
+        List<WordData> allWords = new ArrayList<>();
+        for (TableRow row : transactionRowList) {
+            if (row.getWordDataList() != null) {
+                allWords.addAll(row.getWordDataList());
+            }
+        }
+
+        if (allWords.isEmpty()) {
+            return new ArrayList<>();
+        }
+
+        // Build column ranges using TrapRange algorithm
+        TrapRangeBuilder rangeBuilder = new TrapRangeBuilder();
+        for (WordData word : allWords) {
+            Range range = new Range(word.getX1(), word.getX2());
+            rangeBuilder.addRange(range);
+        }
+
+        List<Range> columnRanges = rangeBuilder.build();
+        
+        if (columnRanges.isEmpty()) {
+            return new ArrayList<>();
+        }
+
+        // Convert ranges to HeaderCellData
+        List<HeaderCellData> headerCellDataList = new ArrayList<>();
+        for (int i = 0; i < columnRanges.size(); i++) {
+            Range range = columnRanges.get(i);
+            
+            HeaderCellData headerCellData = new HeaderCellData();
+            headerCellData.setColumnNumber(i);
+            headerCellData.setStartPoint(range.getLowerBound());
+            headerCellData.setEndPoint(range.getUpperBound());
+            headerCellData.setPeakStartPoint(range.getLowerBound());
+            headerCellData.setPeakEndPoint(range.getUpperBound());
+            
+            // Generate a placeholder header word
+            WordData placeholderWord = new WordData();
+            placeholderWord.setWord("");
+            placeholderWord.setX1(range.getLowerBound());
+            placeholderWord.setX2(range.getUpperBound());
+            placeholderWord.setY1(0f);
+            placeholderWord.setActualY1(0f);
+            placeholderWord.setHeight(10f);
+            
+            headerCellData.setWordDataList(new ArrayList<>(Collections.singletonList(placeholderWord)));
+            
+            headerCellDataList.add(headerCellData);
+        }
+
+        return headerCellDataList;
+    }
