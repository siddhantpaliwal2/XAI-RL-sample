+    /**
+     * UNIFIED METHOD: Extract tables from PDF using configurable strategy
+     * 
+     * This is the recommended method to use. It provides full control over
+     * the extraction process through the TableExtractorConfig object.
+     * 
+     * @param file PDF file to process
+     * @param password Password for the PDF (can be null or empty)
+     * @param config Configuration object controlling extraction behavior
+     * @return DocumentExtractionResult containing extracted pages, tables, and cells
+     * @throws IOException if there's an error processing the PDF
+     */
+    public static DocumentExtractionResult extractTables(File file, String password, TableExtractorConfig config) 
+            throws IOException {
+        
+        if (config == null) {
+            config = TableExtractorConfig.defaultConfig();
+        }
+        
+        // Route to appropriate extraction method based on strategy
+        switch (config.getExtractionStrategy()) {
+            case GRID_LINE:
+                return fetchTableByGridLine(file, password, config);
+
+            case TEXT_POSITION:
+                return fetchTableByTextPosition(file, password, config);
+
+            case BOX_LINE_TEXT_POSITION:
+                return fetchTableByBoxLine(file, password, config);
+
+            case SELECTED_ROWS_TEXT_POSITION:
+                return fetchTableBySelectedRowsTextPosition(file, password, config);
+
+            default:
+                return fetchTableByTextPosition(file, password, config);
+        }
+    }
