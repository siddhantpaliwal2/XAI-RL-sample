+        if (cells == null || cells.isEmpty()) return;
+        
+        float minX = Float.MAX_VALUE;
+        float minY = Float.MAX_VALUE;
+        float maxX = Float.MIN_VALUE;
+        float maxY = Float.MIN_VALUE;
+        
+        for (Map<Integer, com.finboost.bank.statement.parser.representation.document.extraction.TableCell> row : cells.values()) {
+            for (com.finboost.bank.statement.parser.representation.document.extraction.TableCell cell : row.values()) {
+                if (cell.getX1() != null && cell.getX1() < minX) minX = cell.getX1();
+                if (cell.getY1() != null && cell.getY1() < minY) minY = cell.getY1();
+                if (cell.getX3() != null && cell.getX3() > maxX) maxX = cell.getX3();
+                if (cell.getY3() != null && cell.getY3() > maxY) maxY = cell.getY3();
+            }
+        }
+        
+        // Set polygon coordinates
+        table.setX1(minX);
+        table.setY1(minY);
+        table.setX2(maxX);
+        table.setY2(minY);
