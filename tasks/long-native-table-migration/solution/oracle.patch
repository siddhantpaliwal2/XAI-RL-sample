+        g2d.setColor(ORIGINAL_LINE_COLOR);
+        g2d.setStroke(new BasicStroke(LINE_THICKNESS));
+        g2d.drawLine(legendX, legendY, legendX + 20, legendY);
+        g2d.setColor(Color.BLACK);
+        g2d.drawString("Original Lines (" + originalCount + ")", legendX + 25, legendY + 5);
+        
+        legendY += lineHeight;
+        g2d.setColor(REDUCED_HORIZONTAL_COLOR);
+        g2d.setStroke(new BasicStroke(REDUCED_LINE_THICKNESS));
+        g2d.drawLine(legendX, legendY, legendX + 20, legendY);
+        g2d.setColor(Color.BLACK);
+        g2d.drawString("Reduced Horizontal", legendX + 25, legendY + 5);
+        
+        legendY += lineHeight;
+        g2d.setColor(REDUCED_VERTICAL_COLOR);
+        g2d.setStroke(new BasicStroke(REDUCED_LINE_THICKNESS));
+        g2d.drawLine(legendX, legendY, legendX + 20, legendY);
+        g2d.setColor(Color.BLACK);
+        g2d.drawString("Reduced Vertical", legendX + 25, legendY + 5);
+        
+        legendY += lineHeight;
+        g2d.setColor(Color.BLACK);
+        double reductionPercentage = originalCount > 0 ? ((double)(originalCount - reducedCount) / originalCount) * 100.0 : 0.0;
+        g2d.drawString(String.format("Reduction: %.1f%%", reductionPercentage), legendX, legendY + 5);
+    }
+
+    /**
+     * Creates the output directory if it doesn't exist
+     */
+    private static void createOutputDirectory(String outputDir) throws IOException {
+        Path outputPath = Paths.get(outputDir);
+        if (!Files.exists(outputPath)) {
+            Files.createDirectories(outputPath);
+        }
+    }
+
+    /**
+     * Gets the appropriate filename suffix based on line visualization type
+     */
+    private static String getLineTypeSuffix(LineVisualizationType lineType) {
+        switch (lineType) {
+            case HORIZONTAL_ONLY:
+                return "horizontal-lines";
+            case VERTICAL_ONLY:
+                return "vertical-lines";
+            case ORIGINAL_VS_REDUCED:
+                return "line-reduction-comparison";
+            case BOTH:
+            default:
+                return "all-lines";
+        }
+    }
+
+    /**
+     * Extracts the filename without extension from a file path
+     */
+    public static String getFileNameWithoutExtension(String filePath) {
+        String fileName = Paths.get(filePath).getFileName().toString();
+        int lastDotIndex = fileName.lastIndexOf('.');
+        return lastDotIndex > 0 ? fileName.substring(0, lastDotIndex) : fileName;
+    }
+}
