+package com.finboost.bank.statement.parser.service.bankstatement.bank;
+
+import com.finboost.bank.statement.parser.representation.bankstatement.BankStatementVO;
+import com.finboost.bank.statement.parser.service.bankstatement.config.BankStatementProcessingConfig;
+import com.finboost.bank.statement.parser.service.bankstatement.config.TransactionTableParsingConfig;
+import com.finboost.bank.statement.parser.tableextractor.config.ExtractionStrategy;
+import com.finboost.bank.statement.parser.tableextractor.config.TableExtractorConfig;
+import com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor.TableLineExtractor;
+import com.finboost.bank.statement.parser.tableextractor.graphics.model.TableStructure;
+import com.finboost.bank.statement.parser.util.PdfTextExtractionUtil;
+import org.springframework.stereotype.Component;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.regex.Pattern;
+@Component
+public class SbiHandler implements IBankWiseHandler{
+    @Override
+    public BankStatementProcessingConfig getTableExtractorConfig(BankStatementVO bankStatementVO) throws Exception {
+        String fileContent = PdfTextExtractionUtil.convertPDFToTextByPositionOrder(bankStatementVO.getDecryptedFile());
+
+        //Format4,format7
+        if (Pattern.compile("Please[\\s]*do[\\s]*not[\\s]*share[\\s]*your[\\s]*ATM").matcher(fileContent).find() || Pattern.compile("Txn[\\s]*Value[\\s]*Description[\\s]*Ref[\\s]*Branch[\\s]*Debit[\\s]*Credit[\\s]*Balance[\\s]*").matcher(fileContent).find()) {
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.gridLineOnly();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }else if (Pattern.compile("Date[\\s]*Transaction[\\s]*Reference[\\s]*Ref.No./Chq.No.[\\s]*Credit[\\s]*Debit[\\s]*Balance[\\s]*").matcher(fileContent).find()) {
+            //format-6
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.BOX_LINE_TEXT_POSITION)
+                    .graphicsVerticalLineHandler( input -> {
+                        if(input.getLines() == null || input.getLines().isEmpty()){
+                            return input.getLines();
+                        }
+
+                        float threshold = (input.getPageHeight() * 0.95f);
+                        List<TableLineExtractor.Line> resultLine = new ArrayList<>();
+                        for(TableLineExtractor.Line line : input.getLines()){
+                            if(line.getLength() <= threshold && line.getLength() >(input.getPageHeight() * 0.10f)){
+                                resultLine.add(line);
+                            }
+                        }
+                        return resultLine;
+                    }).useDetectedColumns(true).useDetectedRows(true).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }else if (Pattern.compile("\\s*Account\\s+Statement\\s+from\\s* *").matcher(fileContent).find() && Pattern.compile("\\s*Txn\\s+Date\\s+Value\\s+Date\\s+Description\\s+Ref\\s+No.\\s*/\\s*Cheque\\s+Branch\\s+Debit\\s+Credit\\s+Balance\\s*").matcher(fileContent).find() && Pattern.compile("\\s*No\\s*.\\s+Code\\s*").matcher(fileContent).find()) {
+            //other
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.gridLineOnly();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }else if (Pattern.compile("\\s*BROUGHT\\s+FORWARD\\s* *").matcher(fileContent).find() && Pattern.compile("\\*\\s*---\\s*END\\s+OF\\s+STATEMENT\\s*---\\s*\\*").matcher(fileContent).find()) {
+            //other2
+            BankStatementProcessingConfig config = new BankStatementProcessingConfig();
+            config.setTransactionTableParsingConfig(TransactionTableParsingConfig.belowDate());
+            TableExtractorConfig tableExtractorConfig = TableExtractorConfig.builder()
+                    .extractionStrategy(ExtractionStrategy.GRID_LINE)
+                    .graphicsTableSelectorHandler( input -> {
+                        if(null == input || null == input.getDetectedTables() || input.getDetectedTables().isEmpty()) {
+                            return Collections.emptyList();
+                        }
+                        List<TableStructure> approvedTables = new ArrayList<>();
+                        for(TableStructure tableStructure: input.getDetectedTables()){
+                            if(tableStructure != null && tableStructure.getColumns() == 7){
+                                approvedTables.add(tableStructure);
+                            }
+                        }
+                        return approvedTables;
+                    }).build();
+            config.setTableExtractorConfig(tableExtractorConfig);
+            return config;
+        }
+
+        return new BankStatementProcessingConfig();
+    }
+}
