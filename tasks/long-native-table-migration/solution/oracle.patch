diff --git a/src/main/java/com/finboost/bank/statement/parser/tableextractor/graphics/BoundaryBasedTableDetector.java b/src/main/java/com/finboost/bank/statement/parser/tableextractor/graphics/BoundaryBasedTableDetector.java
new file mode 100644
index 0000000000000000000000000000000000000000..be935b6127f7a79334ca8d8b01dce96e4ce99da8
--- /dev/null
+++ b/src/main/java/com/finboost/bank/statement/parser/tableextractor/graphics/BoundaryBasedTableDetector.java
@@ -0,0 +1,440 @@
+package com.finboost.bank.statement.parser.tableextractor.graphics;
+
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.TableDetectionConfig;
+import com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor.TableLineExtractor;
+import com.finboost.bank.statement.parser.tableextractor.graphics.model.CellStructure;
+import com.finboost.bank.statement.parser.tableextractor.graphics.model.TableStructure;
+
+import java.awt.geom.Rectangle2D;
+import java.util.*;
+
+/**
+ * Simple and effective table detection algorithm
+ * 
+ * Strategy:
+ * 1. Find all closed rectangular boundaries formed by h-lines and v-lines
+ * 2. Validate each rectangle as a real table (has interior structure)
+ * 3. Remove overlapping/nested rectangles
+ * 4. Process each table boundary independently to extract grid structure
+ * 
+ * This approach is simpler and more reliable than contour/gap-based methods.
+ * 
+ * COORDINATE SYSTEM (CRITICAL):
+ * - PDFBox uses BOTTOM-LEFT coordinate system (like mathematical graphs)
+ * - Origin (0,0) is at bottom-left corner of page
+ * - X increases left to right: left < right
+ * - Y increases bottom to top: bottom < top
+ * 
+ * Visual representation:
+ *     Y↑  (larger Y = TOP of page)
+ *      |
+ *      |  Table top = larger Y
+ *      |  ┌───────────────┐
+ *      |  │ Row 0 (top)   │
+ *      |  ├───────────────┤
+ *      |  │ Row 1         │
+ *      |  ├───────────────┤
+ *      |  │ Row 2 (bottom)│
+ *      |  └───────────────┘
+ *      |  Table bottom = smaller Y
+ *      └────────────────────> X
+ *     (0,0)              (larger X = RIGHT)
+ * 
+ * Key implications:
+ * - Rectangle2D.Double(x, y, w, h): y is the BOTTOM edge (minY)
+ * - getMinY() returns BOTTOM, getMaxY() returns TOP
+ * - Sorted Y values: [small(bottom), medium, large(top)]
+ * - Row 0 (visual top) has largest Y values
+ * - Row N (visual bottom) has smallest Y values
+ */
+public class BoundaryBasedTableDetector {
+    
+    private final TableDetectionConfig config;
+    
+    public BoundaryBasedTableDetector() {
+        this.config = TableDetectionConfig.createStandardConfig();
+    }
+    
+    public BoundaryBasedTableDetector(TableDetectionConfig config) {
+        this.config = config;
+    }
+    
+    /**
+     * Main entry point: Detect all tables in the document
+     */
+    public List<TableStructure> detectTables(List<TableLineExtractor.Line> horizontalLines,
+                                             List<TableLineExtractor.Line> verticalLines) {
+        
+        // Phase 1: Find all table boundaries (closed rectangles)
+        List<Rectangle2D.Double> boundaries = findTableBoundaries(horizontalLines, verticalLines);
+        
+        // Phase 2: Process each boundary to extract detailed table structure
+        List<TableStructure> tables = new ArrayList<>();
+        for (int i = 0; i < boundaries.size(); i++) {
+            Rectangle2D.Double boundary = boundaries.get(i);
+            
+            TableStructure table = processTableBoundary(boundary, horizontalLines, verticalLines, i);
+            if (table != null) {
+                tables.add(table);
+            }
+        }
+        
+        return tables;
+    }
+    
+    /**
+     * Phase 1: Find all closed rectangular boundaries formed by lines
+     */
+    private List<Rectangle2D.Double> findTableBoundaries(List<TableLineExtractor.Line> horizontalLines,
+                                                        List<TableLineExtractor.Line> verticalLines) {
+        
+        List<Rectangle2D.Double> rectangles = new ArrayList<>();
+        double tolerance = config.getBorderTolerance();
+        
+        // Try all combinations of horizontal lines (top, bottom)
+        for (int i = 0; i < horizontalLines.size(); i++) {
+            TableLineExtractor.Line top = horizontalLines.get(i);
+            
+            for (int j = i + 1; j < horizontalLines.size(); j++) {
+                TableLineExtractor.Line bottom = horizontalLines.get(j);
+                
+                // In bottom-left coordinate system: top has larger Y, bottom has smaller Y
+                // But we need to check which line is higher on the page
+                double line1Y = (top.start.getY() + top.end.getY()) / 2.0;
+                double line2Y = (bottom.start.getY() + bottom.end.getY()) / 2.0;
+                
+                // Skip if lines are at same height
+                if (Math.abs(line1Y - line2Y) < config.getBorderTolerance()) continue;
+                
+                // Determine which is top (larger Y) and which is bottom (smaller Y)
+                double topY = Math.max(line1Y, line2Y);      // Top = larger Y in bottom-left
+                double bottomY = Math.min(line1Y, line2Y);    // Bottom = smaller Y in bottom-left
+                
+                // Find the overlapping X range
+                double topLeft = top.getMinX();
+                double topRight = top.getMaxX();
+                double bottomLeft = bottom.getMinX();
+                double bottomRight = bottom.getMaxX();
+                
+                // Lines must have overlapping X range
+                double overlapLeft = Math.max(topLeft, bottomLeft);
+                double overlapRight = Math.min(topRight, bottomRight);
+                if (overlapRight - overlapLeft < config.getMinTableWidth()) continue;
+                
+                // Try all combinations of vertical lines (left, right)
+                for (int k = 0; k < verticalLines.size(); k++) {
+                    TableLineExtractor.Line left = verticalLines.get(k);
+                    
+                    for (int l = k + 1; l < verticalLines.size(); l++) {
+                        TableLineExtractor.Line right = verticalLines.get(l);
+                        
+                        // Right must be right of left
+                        double leftX = (left.start.getX() + left.end.getX()) / 2.0;
+                        double rightX = (right.start.getX() + right.end.getX()) / 2.0;
+                        if (rightX <= leftX) continue;
+                        
+                        // Check if these 4 lines form a closed rectangle
+                        if (linesFormRectangle(top, bottom, left, right, topY, bottomY, leftX, rightX, tolerance)) {
+                            // Rectangle2D.Double constructor: (x, y, width, height)
+                            // In bottom-left system: x=left, y=bottom (minY), width, height
+                            Rectangle2D.Double rect = new Rectangle2D.Double(
+                                leftX, bottomY, rightX - leftX, topY - bottomY
+                            );
+                            
+                            // Basic size validation
+                            if (rect.getWidth() >= config.getMinTableWidth() && 
+                                rect.getHeight() >= config.getMinTableHeight()) {
+                                rectangles.add(rect);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        
+        // Remove duplicates and overlapping rectangles
+        List<Rectangle2D.Double> filtered = removeOverlappingRectangles(rectangles);
+        
+        return filtered;
+    }
+    
+    /**
+     * Check if 4 lines form a closed rectangle
+     * 
+     * CRITICAL: In bottom-left coordinate system:
+     * - topY = larger Y value (top of rectangle)
+     * - bottomY = smaller Y value (bottom of rectangle)
+     * - Vertical lines must span from bottom (small Y) to top (large Y)
+     */
+    private boolean linesFormRectangle(TableLineExtractor.Line top, TableLineExtractor.Line bottom,
+                                      TableLineExtractor.Line left, TableLineExtractor.Line right,
+                                      double topY, double bottomY, double leftX, double rightX,
+                                      double tolerance) {
+        
+        // Check if top horizontal line spans from left to right
+        boolean topSpans = top.getMinX() <= leftX + tolerance && top.getMaxX() >= rightX - tolerance;
+        
+        // Check if bottom horizontal line spans from left to right
+        boolean bottomSpans = bottom.getMinX() <= leftX + tolerance && bottom.getMaxX() >= rightX - tolerance;
+        
+        // Check if left vertical line spans from bottom to top
+        // In bottom-left system: line must start at/below bottom (small Y) and extend to/above top (large Y)
+        boolean leftSpans = left.getMinY() <= bottomY + tolerance && left.getMaxY() >= topY - tolerance;
+        
+        // Check if right vertical line spans from bottom to top
+        boolean rightSpans = right.getMinY() <= bottomY + tolerance && right.getMaxY() >= topY - tolerance;
+        
+        return topSpans && bottomSpans && leftSpans && rightSpans;
+    }
+    
+    /**
+     * Remove overlapping and nested rectangles
+     */
+    private List<Rectangle2D.Double> removeOverlappingRectangles(List<Rectangle2D.Double> rectangles) {
+        if (rectangles.isEmpty()) return rectangles;
+        
+        // Sort by area (largest first)
+        List<Rectangle2D.Double> sorted = new ArrayList<>(rectangles);
+        sorted.sort((r1, r2) -> Double.compare(r2.getWidth() * r2.getHeight(), r1.getWidth() * r1.getHeight()));
+        
+        List<Rectangle2D.Double> result = new ArrayList<>();
+        
+        for (Rectangle2D.Double candidate : sorted) {
+            boolean shouldAdd = true;
+            
+            for (Rectangle2D.Double existing : result) {
+                double overlapArea = getOverlapArea(candidate, existing);
+                double candidateArea = candidate.getWidth() * candidate.getHeight();
+                double existingArea = existing.getWidth() * existing.getHeight();
+                
+                // If candidate is mostly contained in existing, skip it
+                if (overlapArea / candidateArea > 0.8) {
+                    shouldAdd = false;
+                    break;
+                }
+                
+                // If existing is mostly contained in candidate, remove existing and add candidate
+                if (overlapArea / existingArea > 0.8) {
+                    result.remove(existing);
+                    break;
+                }
+                
+                // If they overlap significantly, keep the larger one
+                if (overlapArea / Math.min(candidateArea, existingArea) > 0.5) {
+                    shouldAdd = false;
+                    break;
+                }
+            }
+            
+            if (shouldAdd) {
+                result.add(candidate);
+            }
+        }
+        
+        return result;
+    }
+    
+    /**
+     * Calculate overlap area between two rectangles
+     */
+    private double getOverlapArea(Rectangle2D.Double r1, Rectangle2D.Double r2) {
+        double x1 = Math.max(r1.getMinX(), r2.getMinX());
+        double y1 = Math.max(r1.getMinY(), r2.getMinY());
+        double x2 = Math.min(r1.getMaxX(), r2.getMaxX());
+        double y2 = Math.min(r1.getMaxY(), r2.getMaxY());
+        
+        if (x2 <= x1 || y2 <= y1) return 0.0;
+        
+        return (x2 - x1) * (y2 - y1);
+    }
+    
+    /**
+     * Phase 2: Process a table boundary to extract detailed grid structure
+     */
+    private TableStructure processTableBoundary(Rectangle2D.Double boundary,
+                                               List<TableLineExtractor.Line> allHorizontalLines,
+                                               List<TableLineExtractor.Line> allVerticalLines,
+                                               int tableIndex) {
+        
+        // Extract lines that are inside this boundary
+        List<TableLineExtractor.Line> interiorHLines = getLinesInBoundary(allHorizontalLines, boundary, true);
+        List<TableLineExtractor.Line> interiorVLines = getLinesInBoundary(allVerticalLines, boundary, false);
+        
+        // Must have at least some interior structure
+        if (interiorHLines.size() < 2 || interiorVLines.size() < 2) {
+            return null;
+        }
+        
+        // Extract column and row anchors (like Camelot)
+        List<Double> columnAnchors = extractAnchors(interiorVLines, false, boundary);
+        List<Double> rowAnchors = extractAnchors(interiorHLines, true, boundary);
+        
+        // Must have reasonable grid
+//        if (columnAnchors.size() < 2 || rowAnchors.size() < 2) {
+//            return null;
+//        }
+        
+        // Build the table structure
+        return buildTableStructure(boundary, columnAnchors, rowAnchors, 
+                                  interiorHLines, interiorVLines, tableIndex);
+    }
+    
+    /**
+     * Get lines that are inside the boundary
+     */
+    private List<TableLineExtractor.Line> getLinesInBoundary(List<TableLineExtractor.Line> lines,
+                                                             Rectangle2D.Double boundary,
+                                                             boolean horizontal) {
+        List<TableLineExtractor.Line> interior = new ArrayList<>();
+        double tolerance = config.getBorderTolerance();
+        
+        for (TableLineExtractor.Line line : lines) {
+            if (horizontal) {
+                double lineY = (line.start.getY() + line.end.getY()) / 2.0;
+                // Line must be within vertical bounds
+                if (lineY >= boundary.getMinY() - tolerance && lineY <= boundary.getMaxY() + tolerance) {
+                    // Line must overlap with horizontal bounds
+                    if (line.getMaxX() >= boundary.getMinX() && line.getMinX() <= boundary.getMaxX()) {
+                        interior.add(line);
+                    }
+                }
+            } else {
+                double lineX = (line.start.getX() + line.end.getX()) / 2.0;
+                // Line must be within horizontal bounds
+                if (lineX >= boundary.getMinX() - tolerance && lineX <= boundary.getMaxX() + tolerance) {
+                    // Line must overlap with vertical bounds
+                    if (line.getMaxY() >= boundary.getMinY() && line.getMinY() <= boundary.getMaxY()) {
+                        interior.add(line);
+                    }
+                }
+            }
+        }
+        
+        return interior;
+    }
+    
+    /**
+     * Extract column or row anchors from lines (like Camelot's anchor extraction)
+     */
+    private List<Double> extractAnchors(List<TableLineExtractor.Line> lines,
+                                       boolean horizontal,
+                                       Rectangle2D.Double boundary) {
+        
+        Set<Double> anchors = new TreeSet<>();
+        
+        // Add boundary edges
+        if (horizontal) {
+            anchors.add(boundary.getMinY());
+            anchors.add(boundary.getMaxY());
+        } else {
+            anchors.add(boundary.getMinX());
+            anchors.add(boundary.getMaxX());
+        }
+        
+        // Add line positions
+        for (TableLineExtractor.Line line : lines) {
+            if (horizontal) {
+                double y = (line.start.getY() + line.end.getY()) / 2.0;
+                anchors.add(y);
+            } else {
+                double x = (line.start.getX() + line.end.getX()) / 2.0;
+                anchors.add(x);
+            }
+        }
+        
+        // Merge close anchors (like Camelot's merge_close_lines)
+        List<Double> sorted = new ArrayList<>(anchors);
+        List<Double> merged = mergeCloseValues(sorted, config.getIntersectionTolerance());
+        
+        return merged;
+    }
+    
+    /**
+     * Merge values that are too close together
+     */
+    private List<Double> mergeCloseValues(List<Double> values, double tolerance) {
+        if (values.isEmpty()) return values;
+        
+        List<Double> merged = new ArrayList<>();
+        double current = values.get(0);
+        
+        for (int i = 1; i < values.size(); i++) {
+            double next = values.get(i);
+            
+            if (next - current <= tolerance) {
+                // Merge by averaging
+                current = (current + next) / 2.0;
+            } else {
+                merged.add(current);
+                current = next;
+            }
+        }
+        merged.add(current);
+        
+        return merged;
+    }
+    
+    /**
+     * Build the complete table structure with cell information
+     */
+    private TableStructure buildTableStructure(Rectangle2D.Double boundary,
+                                              List<Double> columnAnchors,
+                                              List<Double> rowAnchors,
+                                              List<TableLineExtractor.Line> hLines,
+                                              List<TableLineExtractor.Line> vLines,
+                                              int tableIndex) {
+        
+        int rows = rowAnchors.size() - 1;
+        int columns = columnAnchors.size() - 1;
+        
+        // Create table structure
+        TableStructure table = new TableStructure(boundary);
+        
+        // Set rows and columns
+        table.setRows(rows);
+        table.setColumns(columns);
+        table.setConfidence(1.0); // Full confidence since we found explicit boundaries
+        
+        // Set column and row separators
+        table.setColumnSeparatorX(columnAnchors);
+        table.setRowSeparatorY(rowAnchors);
+        
+        // Create cell matrix as List<List<CellStructure>>
+        // IMPORTANT: rowAnchors is sorted (TreeSet), so goes from smaller Y to larger Y
+        // In bottom-left coordinate system: smaller Y = bottom, larger Y = top
+        List<List<CellStructure>> cellsList = new ArrayList<>();
+        
+        for (int row = 0; row < rows; row++) {
+            // rowAnchors is sorted: index 0 = smallest Y (bottom), last = largest Y (top)
+            // For row 0 (top row in visual terms): we want the largest Y values
+            // So we need to reverse: row 0 should use rowAnchors[rows-1] to rowAnchors[rows]
+            double cellBottom = rowAnchors.get(rows - row - 1);  // Smaller Y
+            double cellTop = rowAnchors.get(rows - row);         // Larger Y
+            
+            List<CellStructure> rowCells = new ArrayList<>();
+            
+            for (int col = 0; col < columns; col++) {
+                double cellLeft = columnAnchors.get(col);
+                double cellRight = columnAnchors.get(col + 1);
+                
+                // Rectangle2D.Double constructor: (x, y, width, height)
+                // x = left edge, y = bottom edge (minY), width, height
+                Rectangle2D.Double cellBounds = new Rectangle2D.Double(
+                    cellLeft, cellBottom,
+                    cellRight - cellLeft,
+                    cellTop - cellBottom
+                );
+                
+                CellStructure cell = new CellStructure(cellBounds, row, col);
+                rowCells.add(cell);
+            }
+            
+            cellsList.add(rowCells);
+        }
+        
+        table.setCells(cellsList);
+        
+        return table;
+    }
+}
