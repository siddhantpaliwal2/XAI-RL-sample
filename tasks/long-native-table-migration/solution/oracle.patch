+    /**
+     * Gets the column index for a given format identifier.
+     * Column indices: fileName=0, format1=1, format2=2, ..., format9=9, other=10, total=11
+     */
+    private static int getFormatColumnIndex(String format) {
+        return switch (format) {
+            case "format1" -> 1;
+            case "format2" -> 2;
+            case "format3" -> 3;
+            case "format4" -> 4;
+            case "format5" -> 5;
+            case "format6" -> 6;
+            case "format7" -> 7;
+            case "format8" -> 8;
+            case "format9" -> 9;
+            case "format10" -> 10;
+            case "format11" -> 11;
+            case "format12" -> 12;
+            case "format13" -> 13;
+            case "format14" -> 14;
+            case "format15" -> 15;
+            case "format16" -> 16;
+            case "format17" -> 17;
+            case "format18" -> 18;
+            case "format19" -> 19;
+            case "format20" -> 20;
+            case "format21" -> 21;
+            case "format22" -> 22;
+            case "format23" -> 23;
+            case "format24" -> 24;
+            case "other" -> 25;
+            default -> 25; // by default add to the other column
+        };
+    }
+
+    /**
+     * Inner class to store format identification results.
+     */
+    @Getter
+    private static class FormatResult {
+        private final String bankName;
+        private final String fileName;
+        private final List<String> formats;
+
+        public FormatResult(String bankName, String fileName, List<String> formats) {
+            this.bankName = bankName;
+            this.fileName = fileName;
+            this.formats = formats;
+        }
+    }
