+    /**
+     * Assign words to a cell based on their position
+     * 
+     * COORDINATE SYSTEM NOTE - CRITICAL:
+     * - Graphics lines use BOTTOM-LEFT coordinate system (Y increases upward)
+     * - Text positions use TOP-LEFT coordinate system (Y increases downward) 
+     * - WordData.y1 comes from TextPosition.getYDirAdj() which is TOP-LEFT!
+     * - Cell boundaries are in BOTTOM-LEFT system
+     * - We MUST convert word coordinates from TOP-LEFT to BOTTOM-LEFT
+     * 
+     * Conversion formula: bottomLeftY = pageHeight - topLeftY
+     * 
+     * @param cellStructure Cell structure with boundaries (in BOTTOM-LEFT coords)
+     * @param pageWords List of words on the page (in TOP-LEFT coords)
+     * @param pageHeight Page height for coordinate conversion
+     * @return List of words that fall within the cell
+     */
+    private static List<Word> assignWordsToCell(CellStructure cellStructure, List<WordData> pageWords, float pageHeight) {
+        List<Word> cellWords = new ArrayList<>();
+        
+        if (pageWords == null || pageWords.isEmpty()) {
+            return cellWords;
+        }
+        
+        // Cell boundaries in BOTTOM-LEFT coordinate system
+        double cellLeft = cellStructure.getLeft();
+        double cellRight = cellStructure.getRight();
+        double cellBottom = cellStructure.getBottom();  // Smaller Y
+        double cellTop = cellStructure.getTop();        // Larger Y
+        
+        // Add tolerance for word assignment (words at cell edges)
+        double tolerance = 0.0;
+        
+        int wordIndex = 0;
+        for (WordData wordData : pageWords) {
+            // WordData coordinates are in TOP-LEFT system
+            float wordLeft = wordData.getX1();
+            float wordRight = wordData.getX2();
+            float wordTopLeftY = wordData.getY1();  // TOP-LEFT baseline
+            float wordHeight = wordData.getHeight();
+            
+            // Convert from TOP-LEFT to BOTTOM-LEFT coordinate system
+            float wordBottomLeftTop = pageHeight - (wordTopLeftY - wordHeight);  // Top in bottom-left (larger Y)
+            float wordBottomLeftBottom = pageHeight - (wordTopLeftY);  // Bottom in bottom-left (smaller Y)
+            
+            // Calculate word center in BOTTOM-LEFT system
+            float wordCenterX = (wordLeft + wordRight) / 2.0f;
+            float wordCenterY = (wordBottomLeftBottom + wordBottomLeftTop) / 2.0f;
+            
+            // Check if word center is within cell bounds
+            boolean withinX = wordCenterX >= cellLeft - tolerance && wordCenterX <= cellRight + tolerance;
+            boolean withinY = wordCenterY >= cellBottom - tolerance && wordCenterY <= cellTop + tolerance;
+            
+            if (withinX && withinY) {
+                Word word = convertWordDataToWord(wordData, wordIndex++);
+                cellWords.add(word);
+            }
+        }
+        
+        return cellWords;
+    }
