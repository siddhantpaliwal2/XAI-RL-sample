+        g2d.setStroke(new BasicStroke(LINE_THICKNESS + 1));
+        for (Double x : table.getColumnSeparatorX()) {
+            int xPos = (int) x.doubleValue();
+            g2d.drawLine(xPos, bottom, xPos, top);
+        }
+        
+        // Draw row separators in magenta
+        g2d.setColor(ROW_SEPARATOR_COLOR);
+        for (Double y : table.getRowSeparatorY()) {
+            int yPos = imageHeight - (int) y.doubleValue();
+            g2d.drawLine(left, yPos, right, yPos);
+        }
+        
+        // Draw cell boundaries in light gray
+        g2d.setColor(Color.LIGHT_GRAY);
