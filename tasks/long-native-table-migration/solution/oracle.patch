+    /**
+     * Generates Excel file with fileName, format1-format9, other, and total columns.
+     * For each PDF, marks TRUE in format columns that match, and calculates total count.
+     */
+    private static void generateExcelReport(List<FormatResult> results, String outputPath) throws IOException {
+        try (Workbook workbook = new XSSFWorkbook()) {
+            Sheet sheet = workbook.createSheet("Format Identification");
+            
+            // Create header style
+            CellStyle headerStyle = workbook.createCellStyle();
+            Font headerFont = workbook.createFont();
+            headerFont.setBold(true);
+            headerFont.setFontHeightInPoints((short) 12);
+            headerStyle.setFont(headerFont);
+            headerStyle.setFillForegroundColor(IndexedColors.GREY_25_PERCENT.getIndex());
+            headerStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);
+            headerStyle.setAlignment(HorizontalAlignment.CENTER);
+            headerStyle.setVerticalAlignment(VerticalAlignment.CENTER);
+            
+            // Create data style for text
+            CellStyle dataStyle = workbook.createCellStyle();
+            dataStyle.setAlignment(HorizontalAlignment.LEFT);
+            dataStyle.setVerticalAlignment(VerticalAlignment.CENTER);
+            
+            // Create style for TRUE values
+            CellStyle trueStyle = workbook.createCellStyle();
+            trueStyle.setAlignment(HorizontalAlignment.CENTER);
+            trueStyle.setVerticalAlignment(VerticalAlignment.CENTER);
+            Font trueFont = workbook.createFont();
+            trueFont.setBold(true);
+            trueFont.setColor(IndexedColors.DARK_GREEN.getIndex());
+            trueStyle.setFont(trueFont);
+            
+            // Create style for total column
+            CellStyle totalStyle = workbook.createCellStyle();
+            totalStyle.setAlignment(HorizontalAlignment.CENTER);
+            totalStyle.setVerticalAlignment(VerticalAlignment.CENTER);
+            Font totalFont = workbook.createFont();
+            totalFont.setBold(true);
+            totalStyle.setFont(totalFont);
+            
+            // Create header row: fileName, format1-format9, other, total
+            Row headerRow = sheet.createRow(0);
+            headerRow.setHeightInPoints(20);
+            
+            String[] headers = {"fileName", "format1", "format2", "format3", "format4", "format5", "format6", "format7", "format8", "format9", "format10", "format11", "format12", "format13", "format14",
+                    "format15", "format16", "format17", "format18", "format19", "format20", "format21", "format22", "format23", "format24", "other", "total"};
+            for (int i = 0; i < headers.length; i++) {
+                Cell headerCell = headerRow.createCell(i);
+                headerCell.setCellValue(headers[i]);
+                headerCell.setCellStyle(headerStyle);
+            }
+            
+            // Create data rows - one row per file
+            int rowNum = 1;
+            for (FormatResult result : results) {
+                Row row = sheet.createRow(rowNum++);
+                
+                // Set filename in first column
+                Cell fileNameCell = row.createCell(0);
+                fileNameCell.setCellValue(result.getFileName());
+                fileNameCell.setCellStyle(dataStyle);
+                
+                // Get the list of matching formats
+                List<String> formats = result.getFormats();
+                
+                // Mark TRUE in each format column that matches
+                // Column indices: fileName=0, format1=1, format2=2, ..., format9=9, other=10, total=11
+                for (String format : formats) {
+                    int formatColumnIndex = getFormatColumnIndex(format);
+                    if (formatColumnIndex >= 1 && formatColumnIndex <= 25) {
+                        Cell formatCell = row.createCell(formatColumnIndex);
+                        formatCell.setCellValue("TRUE");
+                        formatCell.setCellStyle(trueStyle);
+                    }
+                }
+                
+                // Calculate and set total count - count of all matching formats
+                int totalCount = formats.size();
+                Cell totalCell = row.createCell(26);
+                totalCell.setCellValue(totalCount);
+                totalCell.setCellStyle(totalStyle);
+            }
+            
+            // Auto-size columns
+            for (int i = 0; i < headers.length; i++) {
+                sheet.autoSizeColumn(i);
+            }
+            
+            // Write to file
+            try (FileOutputStream outputStream = new FileOutputStream(outputPath)) {
+                workbook.write(outputStream);
+            }
+        }
+    }
