+    public static void fetchHeader(List<TableRow> copyPageRowList, HeaderCellData headerCellData, List<TableRow> resultTableRowList) {
+        List<WordData> wordDataList = resultTableRowList.get(0).getWordDataList();
+        
+        List<WordData> dateList = wordDataList.stream()
+                .filter(wd -> DATE_PATTERN.matcher(wd.getWord().toLowerCase()).find() || 
+                             MMM_PATTERN.matcher(wd.getWord().toLowerCase()).find())
+                .collect(Collectors.toList());
