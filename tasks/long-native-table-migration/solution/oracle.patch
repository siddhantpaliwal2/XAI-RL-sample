+        float maxX = Float.MIN_VALUE;
+        float maxY = Float.MIN_VALUE;
+        
+        for (Word word : words) {
+            if (word.getX1() != null && word.getX1() < minX) minX = word.getX1();
+            if (word.getY1() != null && word.getY1() < minY) minY = word.getY1();
+            if (word.getX2() != null && word.getX2() > maxX) maxX = word.getX2();
+            if (word.getY3() != null && word.getY3() > maxY) maxY = word.getY3();
+        }
+        
+        // Set polygon coordinates
+        cell.setX1(minX);
+        cell.setY1(minY);
+        cell.setX2(maxX);
+        cell.setY2(minY);
+        cell.setX3(maxX);
+        cell.setY3(maxY);
+        cell.setX4(minX);
+        cell.setY4(maxY);
+    }
