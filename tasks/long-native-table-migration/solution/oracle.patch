+package com.finboost.bank.statement.parser.tableextractor.graphics.line.reducer;
+
+import com.finboost.bank.statement.parser.tableextractor.graphics.config.LineReductionConfig;
+import com.finboost.bank.statement.parser.tableextractor.graphics.line.extractor.TableLineExtractor;
+
+import java.util.List;
+
+/**
+ * Unified intelligent line reducer that combines horizontal and vertical line reduction
+ * Provides a single interface for reducing fragmented lines into clean continuous lines
+ */
+public class IntelligentLineReducer {
+    
+    private final HorizontalLinesReducer horizontalReducer;
+    private final VerticalLinesReducer verticalReducer;
+    private final LineReductionConfig config;
+    
+    public IntelligentLineReducer(LineReductionConfig config) {
+        this.config = config;
+        this.horizontalReducer = new HorizontalLinesReducer(config);
+        this.verticalReducer = new VerticalLinesReducer(config);
+    }
+    
+    public IntelligentLineReducer() {
+        this(new LineReductionConfig());
+    }
+    
+    /**
+     * Reduce both horizontal and vertical lines
+     * 
+     * @param horizontalLines Original horizontal lines
+     * @param verticalLines Original vertical lines
+     * @return LineReductionResult containing reduced lines and statistics
+     */
+    public LineReductionResult reduceLines(List<TableLineExtractor.Line> horizontalLines,
+                                         List<TableLineExtractor.Line> verticalLines) {
+        
+        //System.out.println("IntelligentLineReducer: Starting line reduction process");
+        //System.out.println("Configuration: " + config.toString());
+        
+        // Reduce horizontal lines
+        List<TableLineExtractor.Line> reducedHorizontalLines = horizontalReducer.reduceLines(horizontalLines);
+        HorizontalLinesReducer.ReductionStats horizontalStats = 
+            horizontalReducer.getReductionStats(horizontalLines, reducedHorizontalLines);
+        
+        // Reduce vertical lines
+        List<TableLineExtractor.Line> reducedVerticalLines = verticalReducer.reduceLines(verticalLines);
+        HorizontalLinesReducer.ReductionStats verticalStats = 
+            verticalReducer.getReductionStats(verticalLines, reducedVerticalLines);
+        
+        // Print statistics
+        //System.out.println("Line Reduction Results:");
+        //System.out.println("  " + horizontalStats.toString());
+        //System.out.println("  " + verticalStats.toString());
+        
+        return new LineReductionResult(
+            reducedHorizontalLines, reducedVerticalLines,
+            horizontalStats, verticalStats
+        );
+    }
+    
+    /**
+     * Reduce only horizontal lines
+     */
+    public List<TableLineExtractor.Line> reduceHorizontalLines(List<TableLineExtractor.Line> horizontalLines) {
+        return horizontalReducer.reduceLines(horizontalLines);
+    }
+    
+    /**
+     * Reduce only vertical lines
+     */
+    public List<TableLineExtractor.Line> reduceVerticalLines(List<TableLineExtractor.Line> verticalLines) {
+        return verticalReducer.reduceLines(verticalLines);
+    }
+    
+    /**
+     * Get the configuration being used
+     */
+    public LineReductionConfig getConfig() {
+        return config;
+    }
+    
+    /**
+     * Result class containing reduced lines and statistics
+     */
+    public static class LineReductionResult {
+        private final List<TableLineExtractor.Line> reducedHorizontalLines;
+        private final List<TableLineExtractor.Line> reducedVerticalLines;
+        private final HorizontalLinesReducer.ReductionStats horizontalStats;
+        private final HorizontalLinesReducer.ReductionStats verticalStats;
+        
+        public LineReductionResult(List<TableLineExtractor.Line> reducedHorizontalLines,
+                                 List<TableLineExtractor.Line> reducedVerticalLines,
+                                 HorizontalLinesReducer.ReductionStats horizontalStats,
+                                 HorizontalLinesReducer.ReductionStats verticalStats) {
+            this.reducedHorizontalLines = reducedHorizontalLines;
+            this.reducedVerticalLines = reducedVerticalLines;
+            this.horizontalStats = horizontalStats;
+            this.verticalStats = verticalStats;
+        }
+        
+        public List<TableLineExtractor.Line> getReducedHorizontalLines() {
+            return reducedHorizontalLines;
+        }
+        
+        public List<TableLineExtractor.Line> getReducedVerticalLines() {
+            return reducedVerticalLines;
+        }
+        
+        public HorizontalLinesReducer.ReductionStats getHorizontalStats() {
+            return horizontalStats;
+        }
+        
+        public HorizontalLinesReducer.ReductionStats getVerticalStats() {
+            return verticalStats;
+        }
+        
+        public int getTotalOriginalLines() {
+            return horizontalStats.getOriginalCount() + verticalStats.getOriginalCount();
+        }
+        
+        public int getTotalReducedLines() {
+            return horizontalStats.getReducedCount() + verticalStats.getReducedCount();
+        }
+        
+        public int getTotalReductionCount() {
+            return horizontalStats.getReductionCount() + verticalStats.getReductionCount();
+        }
+        
+        public double getOverallReductionPercentage() {
+            int totalOriginal = getTotalOriginalLines();
+            return totalOriginal > 0 ? ((double)getTotalReductionCount() / totalOriginal) * 100.0 : 0.0;
+        }
+        
+        @Override
+        public String toString() {
+            return String.format("LineReductionResult{" +
+                    "totalLines: %d → %d (%.1f%% reduction), " +
+                    "horizontal: %d → %d, vertical: %d → %d}",
+                    getTotalOriginalLines(), getTotalReducedLines(), getOverallReductionPercentage(),
+                    horizontalStats.getOriginalCount(), horizontalStats.getReducedCount(),
+                    verticalStats.getOriginalCount(), verticalStats.getReducedCount());
+        }
+    }
+}
